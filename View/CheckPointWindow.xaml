<Window x:Class="BookingApp.View.CheckPointWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CheckPointWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Define two columns -->
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Button for enrolling tourists (on the left) -->
        <Button Grid.Column="0" Content="Upisi Turistu" Click="RegisterTouristOnCheckPoint_Click" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,10"
                FontSize="16" Height="30" Width="150"/>

        <!-- DataGrid for CheckPoints (on the right) -->
        <DataGrid Grid.Column="1" Name="checkBox" ItemsSource="{Binding CheckPoints}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <!-- Custom CheckBox Column -->
                <DataGridTemplateColumn Header="">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Content="" IsChecked="{Binding IsChecked}" Checked="CheckBox_Checked" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Name Column -->
                <DataGridTemplateColumn Header="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Label Width="auto" Content="{Binding Name}" HorizontalContentAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Button for finishing the tour (on the right) -->
        <Button Grid.Column="1" Content="Finish Tour" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,10" Click="FinishTour_Click"
                FontSize="16" Height="30" Width="100"/>
    </Grid>
</Window>
