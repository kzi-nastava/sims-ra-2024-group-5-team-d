<Window x:Class="BookingApp.View.ReservationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookingApp.View"
        mc:Ignorable="d"
        Title="Reservations" Height="400" Width="400" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Label Content="From:" 
               Grid.Column="0" 
               Grid.Row="0"
               VerticalAlignment="Center"/>
        <DatePicker Grid.Column="0" 
                    VerticalAlignment="Center" 
                    Margin="48,0,45,0" 
                    SelectedDate="{Binding FromDate,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
        <Label Content="To:" 
               Grid.Column="1" 
               Grid.Row="0" 
               VerticalAlignment="Center"/>
        <DatePicker Grid.Column="1"
                    VerticalAlignment="Center" 
                    Margin="48,0,45,0" 
                    SelectedDate="{Binding ToDate,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"/>
        <Label Content="Number of days:" 
               Grid.Column="0" 
               Grid.Row="1" 
               VerticalAlignment="Center"/>
        <TextBox Grid.Column="0"
                 Grid.Row="1" 
                 VerticalAlignment="Center"  
                 Margin="100,0,62,0"  
                 Text="{Binding NumberOfDays, UpdateSourceTrigger=PropertyChanged}"/>
        <Button x:Name="DateCheck" 
                Content="DATE CHECK"
                Grid.Column="0"
                Grid.Row="2"
                Grid.ColumnSpan="2" 
                VerticalAlignment="Center"
                Height="43"
                Margin="130,0,130,0"
                Click="DateCheckClick"/>
        <TextBlock  x:Name="NotAvailableLabel" 
                Text="Accommodation is not available in the given range, the range is extended!!!" 
                Grid.Column="0"
                Grid.Row="3" 
                Grid.ColumnSpan="2" 
                VerticalAlignment="Center" 
                Foreground="Red"
                Visibility="Collapsed"
                TextWrapping="Wrap"
                MaxWidth="300"/>
        <DataGrid x:Name="AvailabilityDateGrid"
                  Grid.Row="4"
                  ItemsSource="{Binding AvailableDates,UpdateSourceTrigger=PropertyChanged}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Grid.ColumnSpan="2"
                  SelectionMode="Single"
                  SelectedItem="{Binding SelectedDate}" SelectionChanged="AvailabilityDateGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn  Width="*" 
                                     Header="Available from:" 
                                     Binding="{Binding Key}"/>
                <DataGridTextColumn  Width="*"
                                     Header="Available to:"  
                                     Binding="{Binding Value}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Label x:Name="NumberOfPeopleLabel"
               Content="Number of people:"
               Grid.Column="0" Grid.Row="5"
               VerticalAlignment="Center"
               Visibility="Collapsed"/>
        <TextBox  x:Name="NumberOfPeopleTextBox" 
                  Grid.Column="0"
                  Grid.Row="5" 
                  VerticalAlignment="Center" 
                  Margin="110,0,30,0" 
                  Text="{Binding NumberOfPeople, UpdateSourceTrigger=PropertyChanged}"
                  Visibility="Collapsed"/>
        <Button x:Name="ReserveButton"
                Content="Reserve" 
                Grid.Column="0" 
                Grid.Row="6"
                VerticalAlignment="Center" 
                Height="43" Margin="20,0,20,0"
                Visibility="Collapsed"
                Click="ReserveAccommodation" />
        <Button x:Name="CancelButton"
                Content="Cancel" Grid.Column="1"
                Grid.Row="6" 
                VerticalAlignment="Center"
                Height="43"
                Margin="20,0,20,0"
                Click="Cancel"/>
    </Grid>
</Window>
