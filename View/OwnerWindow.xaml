<Window x:Class="BookingApp.View.OwnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookingApp.View"
        mc:Ignorable="d"
        Title="OwnerWindow" Height="450" Width="800">
    <Window.Resources>
        <local:FirstImagePathConverter x:Key="FirstImagePathConverter" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" Content="Register new property" Click="RegisterPropertyButton_Click"/>
        <Button  Grid.Column="1" Grid.Row="0" Content="Show stats"/>
        <DataGrid Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Accommodations}" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="*" Header="Picture">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                            <Image Source="{Binding ImagesPath, Converter={StaticResource FirstImagePathConverter}}" Width="50" Height="50"/>
                        </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn  Width="*" Header="Name" Binding="{Binding Name}"/>
                <DataGridTextColumn  Width="*" Header="Location" Binding="{Binding Location}"/>
                <DataGridTextColumn  Width="auto" Header="Type" Binding="{Binding Type}"/>
                <DataGridTextColumn  Width="auto" Header="Capacity" Binding="{Binding Capacity}"/>
                <DataGridTextColumn  Width="*" Header="Minimum stay" Binding="{Binding MinStay}"/>
                <DataGridTextColumn  Width="*" Header="Cancellation deadline" Binding="{Binding CancellationDeadline}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
