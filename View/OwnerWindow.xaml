<Window x:Class="BookingApp.View.OwnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookingApp.View"
        mc:Ignorable="d"
        Title="OwnerWindow" Height="450" Width="800">
    <Window.Resources>
        <local:FirstImagePathConverter x:Key="FirstImagePathConverter" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" Content="Register new property" Click="RegisterPropertyButton_Click"/>
        <Button  Grid.Column="1" Grid.Row="0" Content="Show stats" Click="ShowStatsButton_Click"/>
        <DataGrid Grid.Row="1" Grid.ColumnSpan="2" ItemsSource="{Binding Accommodations}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectedItem="{ Binding selectedAccommodation }">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="*" Header="Picture">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                            <Image Source="{Binding ImagesPath, Converter={StaticResource FirstImagePathConverter}}" Width="auto" Height="auto"/>
                        </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn  Width="*" Header="Name" Binding="{Binding Name}"/>
                <DataGridTextColumn  Width="*" Header="Location" Binding="{Binding Location}"/>
                <DataGridTextColumn  Width="auto" Header="Type" Binding="{Binding Type}"/>
                <DataGridTextColumn  Width="auto" Header="Capacity" Binding="{Binding Capacity}"/>
                <DataGridTextColumn  Width="*" Header="Minimum stay" Binding="{Binding MinStay}"/>
                <DataGridTextColumn  Width="*" Header="Cancellation deadline" Binding="{Binding CancellationDeadline}"/>
            </DataGrid.Columns>
        </DataGrid>
        <Label x:Name="RateLabel" Grid.Row="2" Content="You have unrated guests, click on button to rate them" Foreground="#FFFD0404" Visibility="Hidden" HorizontalAlignment="Right" VerticalAlignment="Center">
        </Label>
        <Button x:Name="RateButton" Grid.Column="1" Grid.Row="2" Width="30" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Content="+" Visibility="Hidden" Click="RateGuestsButton_Click">
            </Button>
    </Grid>
</Window>
