<UserControl x:Class="BookingApp.WPF.Views.NotificationPopUpUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="13"/>
            <RowDefinition Height="75"/>
            <RowDefinition Height="75"/>
        </Grid.RowDefinitions>

        <Path HorizontalAlignment="Center" VerticalAlignment="Center" Grid.RowSpan="3" Data="M0,0
L10,-10
L20,0
L100,0
C100,0 110,0 110,10
L110,100
C110,100 110,110 100,110
L-80,110
C-80,110 -90,110 -90,100
L-90,10
C-90,10 -90,0 -80,0
L0,0
z"  Fill="#3A6180"
              Height="150"
              Width="300"
              Stroke="#3A6180"
              Stretch="Fill"
              Margin="0">
        </Path>
        <Border BorderBrush="Black" BorderThickness="0 0 0 2" Grid.Row="1"  Cursor="Hand" MouseLeftButtonDown="Reviews" Background="Transparent" Margin="0 0 0 0">
            <Grid Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="20 10 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image  Source="C:\Users\lukai\Desktop\Resource\star.png" 
                                               Width="32" 
                                               Height="32"
                                               Margin="0 0 10 0" Grid.Column="0"/>
                <TextBlock x:Name="ala" Text="You have unrated guests" Grid.Column="1" VerticalAlignment="Center" FontSize="20" FontWeight="Bold"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" MouseLeftButtonDown="Border_MouseLeftButtonDown_1" Background="Transparent" Cursor="Hand" Margin="10 0 0 10">
            <Grid Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10 0 10 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image  Source="C:\Users\lukai\Desktop\Resource\inbox1.png" 
                                               Width="32" 
                                               Height="32"
                                               Margin="0 0 10 0" Grid.Column="0"/>
                <TextBlock Grid.Row="1" Text="You have new requests" Grid.Column="1" VerticalAlignment="Center" FontSize="20" FontWeight="Bold"/>
            </Grid>
        </Border>
    </Grid>

    <UserControl.Style>
        <Style>
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" Duration="00:00:01" From="0.2" To="1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <Trigger Property="FrameworkElement.Visibility" Value="Collapsed">
                    <Setter Property="FrameworkElement.Opacity" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
</UserControl>
