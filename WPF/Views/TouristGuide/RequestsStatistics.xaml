<UserControl x:Class="BookingApp.WPF.Views.TouristGuide.RequestsStatistics"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.TouristGuide"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             mc:Ignorable="d" 
             d:DesignHeight="767" d:DesignWidth="950">
    <Grid Margin="40,15,40,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button Grid.Row="0" HorizontalAlignment="Left" Command="{Binding BackCommand}" Background="Transparent" BorderBrush="Transparent">
            <StackPanel Orientation="Horizontal">
                <Image Source="C:\Users\milan\OneDrive\Radna površina\SIMPROJEKAT\sims-ra-2024-group-5-team-d\Resources\Images\GuideImages\Alt Arrow Left.png" Width="16" Height="16"/>
                <Label Content="Back" Margin="5,0,0,0" />
            </StackPanel>
        </Button>
        <Border     Grid.Row="1"
                    Grid.Column="0"
                    BorderThickness="2"
                    BorderBrush="Black"
                    CornerRadius="20"
                    Width="150"
                    Height="30"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="0,40,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="C:\Users\milan\OneDrive\Radna površina\SIMPROJEKAT\sims-ra-2024-group-5-team-d\WPF\Views\TouristGuide\Icons\SideMenu\Map Point Add.png" Width="20" Margin="5,0,0,0"/>
                <ComboBox x:Name ="locationComboBox" Grid.Column="1" VerticalAlignment="Center" Width="108" SelectedIndex="{Binding PickedLocationId, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="Serbia, Novi Sad"/>
                    <ComboBoxItem Content="Serbia, Beograd"/>
                    <ComboBoxItem Content="Serbia, Smederevo"/>
                    <ComboBoxItem Content="Serbia, Požega"/>
                    <ComboBoxItem Content="Serbia, Kragujevac"/>
                    <ComboBoxItem Content="Serbia, Niš"/>
                    <ComboBoxItem Content="Serbia, Subotica"/>
                    <ComboBoxItem Content="Serbia, Pančevo"/>
                    <ComboBoxItem Content="Serbia, Čačak"/>
                    <ComboBoxItem Content="Serbia, Užice"/>
                    <ComboBoxItem IsEnabled="False" Visibility="Collapsed">Location</ComboBoxItem>
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="GotFocus">
                            <i:InvokeCommandAction Command="{Binding LocationComboBoxGotFocusCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                </ComboBox>
            </Grid>
        </Border>
        <Border     Grid.Column="0"
                    Grid.Row="1"
                    BorderThickness="2"
                    BorderBrush="Black"
                    CornerRadius="20"
                    Width="150"
                    Margin="90,40,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Source="C:\Users\milan\OneDrive\Radna površina\SIMPROJEKAT\sims-ra-2024-group-5-team-d\WPF\Views\TouristGuide\Icons\Card\Chat Round Line.png" Width="20" Margin="10,0,0,0"/>
                <ComboBox x:Name ="languageComboBox" Grid.Column="1" VerticalAlignment="Center" SelectedIndex="{Binding PickedLanguage, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Width="102">
                    <ComboBoxItem Content="English"/>
                    <ComboBoxItem Content="Serbian"/>
                    <ComboBoxItem Content="German"/>
                    <ComboBoxItem IsEnabled="False" Visibility="Collapsed">Language</ComboBoxItem>
                </ComboBox>
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="GotFocus">
                        <i:InvokeCommandAction Command="{Binding LanguageComboBoxGotFocusCommand}" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>
            </Grid>
        </Border>
        <Image Grid.Row="1" Grid.Column="1" Source="Icons/Card/Lightbulb Minimalistic.png" HorizontalAlignment="Right" Height="24" Width="24" Margin="0,0,25,0" />
        <!--<Button Grid.Row="2" Grid.Column="0" Content="Show Requests"  Height="34" Width="140" HorizontalAlignment="Left" Margin="0,25,0,0"/>-->

        <ToggleButton Grid.Row="0" Grid.Column="1" x:Name="HelpButton" Width="16" Height="16" HorizontalAlignment="Right" Command="{Binding HelpCommand}">
            <Image Source="Icons/Card/Question Circle.png" />
        </ToggleButton>
        <!-- Popover Content -->
        <Popup x:Name="HelpPopup" PlacementTarget="{Binding ElementName=HelpButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-120" VerticalOffset="15" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <Border BorderBrush="Gray" BorderThickness="1" Background="White" CornerRadius="5" Height="90" Width="140">
                <Grid>
                    <Polygon Points="0,10 10,0 20,10" Fill="White" Stroke="Gray" StrokeThickness="1" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,0,10" />
                    <TextBlock Text="By clicking the lightbulb symbol you can create a tour with statistically best options." Padding="10" TextWrapping="WrapWithOverflow"/>
                </Grid>
            </Border>
        </Popup>
        <ComboBox Grid.Row="2"
                  Width="100"
                  HorizontalAlignment="Left"
                  Margin="0,25,0,0"
                  ItemsSource="{Binding Years}"
                  SelectedItem="{Binding SelectedYear, Mode=TwoWay}"
                  SelectedIndex="0">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding ComboBoxSelectionChangedCommand}"
                                   CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ComboBox}}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </ComboBox>
        <lvc:CartesianChart Series="{Binding YearlyStats}" Grid.Row="3" Grid.ColumnSpan="2" LegendLocation="None" Width="600" Height="400">
            <lvc:CartesianChart.AxisX>
                <lvc:Axis Title="Years" Labels="{Binding Labels}"></lvc:Axis>
            </lvc:CartesianChart.AxisX>
            <lvc:CartesianChart.AxisY>
                <lvc:Axis Title="Requests" LabelFormatter="{Binding Formatter}"></lvc:Axis>
            </lvc:CartesianChart.AxisY>
        </lvc:CartesianChart>
        <lvc:CartesianChart Series="{Binding MonthlyStats}" Grid.Row="3" Grid.ColumnSpan="2" LegendLocation="None" Width="600" Height="400" Visibility="Hidden">
            <lvc:CartesianChart.AxisX>
                <lvc:Axis Title="Months" Labels="{Binding YearLabels}" />
            </lvc:CartesianChart.AxisX>
            <lvc:CartesianChart.AxisY>
                <lvc:Axis Title="Requests" />
            </lvc:CartesianChart.AxisY>
        </lvc:CartesianChart>
    </Grid>
</UserControl>