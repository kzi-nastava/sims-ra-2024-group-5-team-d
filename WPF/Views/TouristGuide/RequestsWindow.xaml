<UserControl x:Class="BookingApp.WPF.Views.TouristGuide.RequestsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.TouristGuide"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:converter="clr-namespace:BookingApp.WPF.Converters"
             mc:Ignorable="d"
              d:DesignHeight="768" d:DesignWidth="950">
    <UserControl.Resources>
        <converter:FirstImagePathConverter x:Key="FirstImagePathConverter"/>
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style TargetType="Label" x:Key="TabsLabelsStyle">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,5"/>
            <Style.Triggers>
                <!-- Trigger to change the background color when label is selected -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="LightGray"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,15,40,0">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Grid containing the tabs -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <!-- Border around the tabs -->
            <Border BorderThickness="1 1 1 1" BorderBrush="Black" Grid.ColumnSpan="4"/>

            <Label Grid.Column="0" Content="All tours" Style="{StaticResource TabsLabelsStyle}">
                <Label.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding AllToursTabCommand}" />
                </Label.InputBindings>
            </Label>
            <Label Grid.Column="1" Content="Tours today" Style="{StaticResource TabsLabelsStyle}">
                <Label.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding ToursTodayTabCommand}" />
                </Label.InputBindings>
            </Label>

            <Label Grid.Column="2" Content="Finished tours" Style="{StaticResource TabsLabelsStyle}">
                <Label.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding FinishedToursTabCommand}" />
                </Label.InputBindings>
            </Label>
            <Label Grid.Column="3" Content="Requests"  Background="LightGray" Style="{StaticResource TabsLabelsStyle}">
                <Label.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding RequestTabCommand}" />
                </Label.InputBindings>
            </Label>

        </Grid>
        <!-- Content Area -->
        <Grid Grid.Row="1" Visibility="{Binding IsGridVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    BorderThickness="2"
                    BorderBrush="Black"
                    CornerRadius="20"
                    Width="150"
                    HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="C:\Users\milan\OneDrive\Radna površina\SIMPROJEKAT\sims-ra-2024-group-5-team-d\WPF\Views\TouristGuide\Icons\SideMenu\Map Point Add.png" Width="20" Margin="5,0,0,0"/>
                    <ComboBox Grid.Column="1" VerticalAlignment="Center" Width="108" SelectedIndex="{Binding PickedLocationId, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="Serbia, Novi Sad"/>
                        <ComboBoxItem Content="Serbia, Beograd"/>
                        <ComboBoxItem Content="Serbia, Smederevo"/>
                        <ComboBoxItem Content="Serbia, Požega"/>
                        <ComboBoxItem Content="Serbia, Kragujevac"/>
                        <ComboBoxItem Content="Serbia, Niš"/>
                        <ComboBoxItem Content="Serbia, Subotica"/>
                        <ComboBoxItem Content="Serbia, Pančevo"/>
                        <ComboBoxItem Content="Serbia, Čačak"/>
                        <ComboBoxItem Content="Serbia, Užice"/>
                        <ComboBoxItem IsEnabled="False" Visibility="Collapsed">Location</ComboBoxItem>
                    </ComboBox>
                </Grid>
            </Border>
            <Border Grid.Column="1"
                    BorderThickness="2"
                    BorderBrush="Black"
                    CornerRadius="20"
                    Width="150"
                    HorizontalAlignment="Left"
                    Margin="10,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="C:\Users\milan\OneDrive\Radna površina\SIMPROJEKAT\sims-ra-2024-group-5-team-d\WPF\Views\TouristGuide\Icons\Card\User.png" Width="20" Margin="10,0,0,0"/>
                    <TextBox Grid.Column="1" VerticalAlignment="Center" Width="110" BorderThickness="0" Text="{Binding PickedMaxCapacity, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Text" Value="Capacity"/>
                                <Style.Triggers>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter Property="Text" Value=""/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>
            <Border Grid.Column="2"
                    BorderThickness="2"
                    BorderBrush="Black"
                    CornerRadius="20"
                    Width="150"
                    HorizontalAlignment="Left"
                    Margin="20,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="C:\Users\milan\OneDrive\Radna površina\SIMPROJEKAT\sims-ra-2024-group-5-team-d\WPF\Views\TouristGuide\Icons\Card\Chat Round Line.png" Width="20" Margin="10,0,0,0"/>
                    <ComboBox Grid.Column="1" VerticalAlignment="Center" SelectedIndex="{Binding PickedLanguage, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Width="102">
                        <ComboBoxItem Content="English"/>
                        <ComboBoxItem Content="Serbian"/>
                        <ComboBoxItem Content="German"/>
                        <ComboBoxItem IsEnabled="False" Visibility="Collapsed">Language</ComboBoxItem>
                    </ComboBox>
                </Grid>

            </Border>
            <Border Grid.Column="3"
                    BorderThickness="2"
                    BorderBrush="Black"
                    CornerRadius="20"
                    Width="150"
                    HorizontalAlignment="Left"
                    Margin="20,0,0,0">
                <DatePicker IsTodayHighlighted="True" BorderThickness="0" Width="125" VerticalAlignment="Center" SelectedDate="{Binding PickedDateFrom}">
                    <DatePicker.Resources>
                        <Style TargetType="{x:Type DatePickerTextBox}" >
                            <Setter Property="Text" Value="Date From" />
                        </Style>
                    </DatePicker.Resources>
                </DatePicker>
            </Border>
            <Border Grid.Column="4"
                    BorderThickness="2"
                    BorderBrush="Black"
                    CornerRadius="20"
                    Width="150"
                    HorizontalAlignment="Left"
                    Margin="20,0,0,0">
                <DatePicker IsTodayHighlighted="True" BorderThickness="0" Width="125" VerticalAlignment="Center" SelectedDate="{Binding PickedDateTo}">
                    <DatePicker.Resources>
                        <Style TargetType="{x:Type DatePickerTextBox}">
                            <Setter Property="Text" Value="Date To"/>
                        </Style>
                    </DatePicker.Resources>
                </DatePicker>
            </Border>
            <Button Grid.Row="1" Grid.Column="4" BorderBrush="Black" BorderThickness="2" Background="Transparent" Content="Search" Command="{Binding SearchCommand}" Margin="0,10,0,0" Height="34" Width="140" HorizontalAlignment="Right"/>
            <Button Grid.Row="1" BorderBrush="Black" BorderThickness="2" Background="Transparent" Content="Show statistics" Command="{Binding StatisticsCommand}" Margin="0,10,0,0" Height="34" Width="140" HorizontalAlignment="Left"/>
        </Grid>
        <ListView BorderThickness="0"
              Background="Transparent"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              ScrollViewer.VerticalScrollBarVisibility="Hidden"
              SelectedItem="{Binding SelectedTourRequest}"
              ItemsSource="{Binding TourRequests}"
              ScrollViewer.CanContentScroll="False" 
              Grid.Row="2">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Height="150" Width="825" BorderThickness="2" BorderBrush="Black" CornerRadius="15" Margin="0 10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" VerticalAlignment="Bottom" Margin="10,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="Icons/SideMenu/Map Point Add.png" Height="16" Width="16"/>
                                    <Label Grid.Column="1" Content="{Binding Location}" HorizontalAlignment="Left" />
                                </Grid>
                                <Grid Grid.Column="1" VerticalAlignment="Bottom" Margin="0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="Icons/Card/Clock Circle.png" Height="16" Width="16"/>
                                    <Label Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock>
                                        <Run Text="{Binding DateFrom,StringFormat=d}" />
                                        <Run Text="-" />
                                        <Run Text="{Binding DateTo,StringFormat=d}" />
                                        </TextBlock>
                                    </Label>
                                </Grid>
                                <Grid Grid.Column="2" VerticalAlignment="Bottom" Margin="0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="Icons/Card/User.png" Height="16" Width="16"/>
                                    <Label Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock>
                                            <Run Text="{Binding Capacity}" />
                                            <Run Text=" seats" />
                                        </TextBlock>
                                    </Label>
                                </Grid>
                                <Grid Grid.Column="3" VerticalAlignment="Bottom" Margin="0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="Icons/Card/Chat Round Line.png" Height="16" Width="16"/>
                                    <Label Grid.Column="1" Content="{Binding Language}" HorizontalAlignment="Left"/>
                                </Grid>
                            </Grid>
                            <Label Grid.Row="0">
                                <TextBlock Text="{Binding Description}" TextWrapping="WrapWithOverflow" MaxHeight="50"  Margin="10,0,10,0"/>
                            </Label>
                            <Button Grid.Row="1" Grid.Column="4" Content="Accept" Command="{Binding DataContext.AcceptCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" IsEnabled="{Binding IsAcceptable}" Height="34" Width="100" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,15,15"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
