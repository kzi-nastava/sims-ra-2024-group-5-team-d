<UserControl x:Class="BookingApp.WPF.Views.TouristGuide.LiveTourView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.TouristGuide"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:converter="clr-namespace:BookingApp.WPF.Converters"
             mc:Ignorable="d" 
              d:DesignHeight="767" d:DesignWidth="950">
    <UserControl.Resources>
        <converter:FirstImagePathConverter x:Key="FirstImagePathConverter" />
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="40,15,40,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" HorizontalAlignment="Left"  Background="Transparent" BorderBrush="Transparent" Click="BackButton_Click">
            <StackPanel Orientation="Horizontal">
                <Image Source="Icons/Card/Alt Arrow Left.png" Width="16" Height="16"/>
                <Label Content="Back" Margin="5,0,0,0"/>
            </StackPanel>
        </Button>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding tour.Name}" Margin="0,40,0,0" FontSize="35"/>
        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding tourRealisation.DateTime}" FontSize="15"/>
        <Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="5" BorderBrush="DarkGray" BorderThickness="2,0,0,0"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="Attendees" Margin="20,40,0,0" FontSize="35"/>
        <ListView Grid.Row="3" 
                  Grid.Column="0"
                  Height="500" 
                  Margin="20,0,0,0" 
                  ItemsSource="{Binding CheckPoints}" 
                  BorderBrush="Transparent"
                  x:Name="CheckPointsListView"
                  SelectedItem="{Binding SelectedCheckPoint}" MouseDoubleClick="Check_Click"
                  >
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Height="90" Width="200" BorderThickness="0,0,0,0" BorderBrush="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <!-- Circle -->
                            <Grid>
                                <Ellipse x:Name="CircleEllipse" Width="30" Height="30" Fill="White" Margin="10,0" >
                                    <Ellipse.ToolTip>
                                        <TextBlock>Circle</TextBlock>
                                    </Ellipse.ToolTip>
                                </Ellipse>
                                <Image Source="C:\Users\milan\OneDrive\Radna površina\SIMPROJEKAT\sims-ra-2024-group-5-team-d\Resources\Images\GuideImages\Check Circle.png" Visibility="{Binding IsChecked,Converter={StaticResource BoolToVisibilityConverter}}" Height="30" Width="30"/>
                                <!-- NIJE DOBAR BINDING NA LISTU PAZI -->
                                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                            </Grid>
                            <TextBlock Text="{Binding Name}" Margin="10,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>


        <ListView BorderThickness="0" 
                  Background="Transparent"
                    Height="500"
                    Margin="20,0,0,0"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Hidden"
                    ScrollViewer.CanContentScroll="False"
                    Grid.Row="3" Grid.Column="1" 
                    ItemsSource="{Binding TourGuests}"
                    SelectionMode="Multiple"
                    x:Name="TourGuestsListView"
                    >
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Height="65" Width="200" BorderThickness="0,0,0,2" BorderBrush="DarkGray">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Image Grid.Row="0" Source="Icons/User Circle.png" Height="24" Width="24" HorizontalAlignment="Left" Grid.RowSpan="2"/>
                            <TextBlock Grid.Row="0" Text="{Binding FullName}" Margin="30,0,0,0"/>
                            <TextBlock Grid.Row="1" Margin="30,0,0,0">
                                <Run Text="{Binding Years}" />
                                <Run Text="years" />
                            </TextBlock>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Grid.Row="5" Grid.Column="0" Content="Finish Tour" Click="FinishTourButton_Click" Width="120" Height="24" HorizontalAlignment="Right" Margin="0,40,15,0"/>
        <Button Grid.Row="5" Grid.Column="1" Content="Sign Up" Click ="SignUpButton_Click" Width="120" Height="24" HorizontalAlignment="Right" Margin="0,40,15,0"/>
    </Grid>
</UserControl>
