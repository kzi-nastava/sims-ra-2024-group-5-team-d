<UserControl x:Class="BookingApp.WPF.Views.TouristGuide.ViewMoreFinishedTour"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.TouristGuide"
             xmlns:local1="clr-namespace:BookingApp.WPF.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="767" d:DesignWidth="950">
    <UserControl.Resources>
        <local1:FirstImagePathConverter x:Key="FirstImagePathConverter" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="40,15,40,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Button Grid.Row="0" HorizontalAlignment="Left" Command="{Binding BackCommand}" Background="Transparent" BorderBrush="Transparent">
                <StackPanel Orientation="Horizontal">
                    <Image Source="Icons/Card/Alt Arrow Left.png" Width="16" Height="16"/>
                    <Label Content="Back" Margin="5,0,0,0" />
                </StackPanel>
            </Button>
            <!-- Popover Content -->
            <Grid Grid.Row="1" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="{Binding SelectedTour.ImagesPath, Converter={StaticResource FirstImagePathConverter}}" Grid.ColumnSpan="2" Grid.RowSpan="2" Margin="5,5,5,5"/>
                <Image Grid.Column="2" Grid.Row="0" Source="{Binding SelectedTour.ImagesPath, Converter={StaticResource FirstImagePathConverter}}" Margin="5,5,5,5"/>
                <Image Grid.Column="2" Grid.Row="1" Source="{Binding SelectedTour.ImagesPath, Converter={StaticResource FirstImagePathConverter}}"  Margin="5,5,5,5"/>
                <Image Grid.Column="3" Grid.Row="0" Source="{Binding SelectedTour.ImagesPath, Converter={StaticResource FirstImagePathConverter}}"  Margin="5,5,5,5"/>
                <Image Grid.Column="3" Grid.Row="1" Source="{Binding SelectedTour.ImagesPath, Converter={StaticResource FirstImagePathConverter}}"  Margin="5,5,5,5"/>
                <Image Grid.Column="4" Grid.Row="0" Source="{Binding SelectedTour.ImagesPath, Converter={StaticResource FirstImagePathConverter}}" Margin="5,5,5,5"/>
                <Image Grid.Column="4" Grid.Row="1" Source="{Binding SelectedTour.ImagesPath, Converter={StaticResource FirstImagePathConverter}}"  Margin="5,5,5,5"/>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="Icons/SideMenu/Map Point Add.png" Height="16" Width="16"/>
                <Label Grid.Column="1" Content="{Binding SelectedTour.Location}" HorizontalAlignment="Left"/>
                <Image Grid.Column="2" Source="Icons/Card/Clock Circle.png" Height="16" Width="16"/>
                <Label Grid.Column="3" Content="{Binding SelectedTour.Duration}" HorizontalAlignment="Left"/>
                <Image Grid.Column="4" Source="Icons/Card/User.png" Height="16" Width="16"/>
                <Label Grid.Column="5" Content="{Binding SelectedTour.Capacity}" HorizontalAlignment="Left"/>
                <Image Grid.Column="6" Source="Icons/Card/Chat Round Line.png" Height="16" Width="16"/>
                <Label Grid.Column="7" Content="{Binding SelectedTour.Language}" HorizontalAlignment="Left"/>
            </Grid>
            <Label Grid.Row="3" Content="{Binding SelectedTour.Name}" FontSize="35" FontWeight="SemiBold" Margin="0,20,0,0"/>
            <TextBlock Grid.Row="4" Text="{Binding SelectedTour.Description}" TextWrapping="Wrap" Margin="0,10,0,30"/>
            <TextBlock Grid.Row="5" Text="Rewiews" HorizontalAlignment="Left" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="5" Text="Age Statistics" HorizontalAlignment="Right" Margin="0,0,130,0" FontSize="20" FontWeight="SemiBold"/>
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ListView BorderThickness="0" 
                      Background="Transparent" 
                      
                      Grid.Column="0" 
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Height="135" Width="550" BorderThickness="2" BorderBrush="Black" CornerRadius="15" Margin="0,10,30,0">
                                <Grid Margin="15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Image Grid.Row="0" Source="Icons/User Circle.png" Height="24" Width="24" HorizontalAlignment="Left" Grid.RowSpan="2"/>
                                    <TextBlock Grid.Row="0" Text="Petar Petrovic,25" Margin="30,0,0,0"/>
                                    <TextBlock Grid.Row="1" Text="Joined:Kalemegdan fortress" Margin="30,0,0,0"/>
                                    <TextBlock Grid.Row="1" Text="25.03.2024 15:00h" Margin="415,0,0,0"/>
                                    <TextBlock Grid.Row="2" Text="Great service! Saw so many interesting landmarks. Would recommend this tour and the tour guide is simply amazing! It was only a little bit slow tho...." TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <Image Grid.Row="3" Source="Icons/Card/Flag.png" Height="20" Width="20" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemsSource>
                        <x:Array Type="{x:Type sys:String}">
                            <sys:String>Ala</sys:String>
                            <sys:String>Bela</sys:String>
                            <sys:String>Ceca</sys:String>
                            <sys:String>Veca</sys:String>
                        </x:Array>
                    </ListView.ItemsSource>
                </ListView>
                <lvc:PieChart Grid.Row="6" Grid.Column="1" LegendLocation="Right" VerticalAlignment="Top" Height="200" Margin="10,0,0,0" >
                    <lvc:PieChart.Series>
                        <lvc:PieSeries Values="10" DataLabels="True" Title="First"/>
                        <lvc:PieSeries Values="20" DataLabels="True" Title="Second"/>
                        <lvc:PieSeries Values="30" DataLabels="True" Title="Third"/>
                    </lvc:PieChart.Series>
                </lvc:PieChart>

            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
