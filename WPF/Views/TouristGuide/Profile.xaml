<UserControl x:Class="BookingApp.WPF.Views.TouristGuide.Profile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.TouristGuide"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:converter="clr-namespace:BookingApp.WPF.Converters"
             mc:Ignorable="d" 
              d:DesignHeight="767" d:DesignWidth="950">
    <UserControl.Resources>
        <converter:FirstImagePathConverter x:Key="FirstImagePathConverter"/>
    </UserControl.Resources>
    <Grid Margin="40,15,40,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" HorizontalAlignment="Left" Background="Transparent" BorderBrush="Transparent">
            <StackPanel Orientation="Horizontal">
                <Image Source="Icons/Card/Alt Arrow Left.png" Width="16" Height="16"/>
                <Label Content="Back" Margin="5,0,0,0"/>
            </StackPanel>
        </Button>
        <Image Grid.Row="1" Grid.RowSpan="3" Source="Icons/User Circle.png" Height="130" Width="130" Margin="0,50,0,0"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="Milana Dobric" FontSize="25" Margin="0,50,0,0"/>
        <Border Grid.Row="2" Grid.Column="2" BorderBrush="LightGray" BorderThickness="1" CornerRadius="20" Background="LightGray" Height="34" Width="143" HorizontalAlignment="Left">
            <TextBlock Text="SUPERVODIC" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="5.0"/>
        <TextBlock Grid.Row="4" Grid.Column="0" Text="My Best Tour" FontSize="14" Margin="0,50,0,0"/>
        <ComboBox Grid.Row="4"
          Grid.Column="1"
          Width="150" 
          HorizontalAlignment="Right"
          Height="30" 
          VerticalAlignment="Bottom" 
          ItemsSource="{Binding Date}"
          SelectedItem="{Binding SelectedDate, Mode=TwoWay}"
          SelectedIndex="0">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                    <i:InvokeCommandAction Command="{Binding ComboBoxSelectionChangedCommand}"
                                   CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ComboBox}}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </ComboBox>
        <ListView BorderThickness="0"
          Background="Transparent"
          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
          ScrollViewer.VerticalScrollBarVisibility="Hidden"
          ItemsSource="{Binding Tour}"
          ScrollViewer.CanContentScroll="False" Grid.Row="5"
          >
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
            <Border  Height="172" Width="367" BorderThickness="2" BorderBrush="Black" CornerRadius="15" Margin="0,10,30,0" HorizontalAlignment="Left">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                                <Image Source="{Binding ImagesPath, Converter={StaticResource FirstImagePathConverter}}" Grid.Column="0" Width="184" Height="105" HorizontalAlignment="Left" Margin="15 15 15 0"/>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="Icons/SideMenu/Map Point Add.png" Height="16" Width="16"/>
                                <Label Grid.Column="1" Content="{Binding Location}" HorizontalAlignment="Left"/>
                            </Grid>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="Icons/Card/Clock Circle.png" Height="16" Width="16"/>
                                <Label Grid.Column="1" Content="{Binding Duration}" HorizontalAlignment="Left"/>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="Icons/Card/User.png" Height="16" Width="16"/>
                                <Label Grid.Column="1" Content="{Binding Capacity}" HorizontalAlignment="Left"/>
                            </Grid>
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="Icons/Card/Chat Round Line.png" Height="16" Width="16"/>
                                <Label Grid.Column="1" Content="{Binding Language}" HorizontalAlignment="Left"/>
                            </Grid>
                        </Grid>
                    </Grid>
                    <Label Grid.Row="1" Content="{Binding Name}" HorizontalAlignment="Left" FontSize="20" Margin="10,0,0,0"/>
                </Grid>
            </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Grid.Row="7" Grid.Column="2" Width="120" Height="36" Content="Quit" HorizontalAlignment="Left" Margin="130,0,0,0"/>
        <Button Grid.Row="7" Grid.Column="3" Width="120" Height="36" Content="Log out" HorizontalAlignment="Right"/>
    </Grid>
</UserControl>
