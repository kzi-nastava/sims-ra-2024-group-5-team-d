<UserControl x:Class="BookingApp.WPF.Views.TouristView.TouristHomeUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.TouristView"
             xmlns:converter="clr-namespace:BookingApp.WPF.Converters"
             mc:Ignorable="d"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             d:DesignHeight="587" 
             d:DesignWidth="1152">
    <UserControl.Resources>
        <converter:FirstImagePathConverter x:Key="FirstImagePathConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Border BorderBrush="Gray"
                        BorderThickness="0 0 0 1.5"
                        CornerRadius="0"
                        Grid.Row="0"
                        Margin="0 0 0 15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="auto"></RowDefinition>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <TextBlock         Grid.Row="0"
                                       Margin="-35 21 0 0"
                                       Grid.Column="0"
                                       Text="Location:"
                                       Padding="0 0 30 0"
                                       FontFamily="Verdana"
                                       HorizontalAlignment="Center"
                                       FontSize="20"
                                       VerticalAlignment="Center"/>
                <TextBlock         Grid.Row="0"
                                       Grid.Column="1"
                                       Text="Duration:"
                                       Padding="0 20 60 0"
                                       FontFamily="Verdana"
                                       HorizontalAlignment="Center"
                                       FontSize="20"
                                       VerticalAlignment="Center"/>
                <TextBlock
                                       Grid.Column="2"
                                       Text="Language:"
                                       Padding="0 20 30 0"
                                       FontFamily="Verdana"
                                       HorizontalAlignment="Left"
                                       FontSize="20"
                                       VerticalAlignment="Center"
                                       Margin="31,0,0,0"/>
                <TextBlock         Grid.Row="0"
                                       Grid.Column="3"
                                       Text="Number of people:"
                                       Margin="0 5 0 0"
                                       Padding="0 15 30 0"
                                       FontFamily="Verdana"
                                       HorizontalAlignment="Center"
                                       FontSize="20"
                                       VerticalAlignment="Center"/>
                <ComboBox   Grid.Row="1"
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="35,5,0,0"
                            Width="170"
                            Height="30"
                            FontSize="15"
                            SelectedIndex="{Binding PickedLocationId, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="Serbia, Novi Sad"/>
                    <ComboBoxItem Content="Serbia, Beograd"/>
                    <ComboBoxItem Content="Serbia, Smederevo"/>
                    <ComboBoxItem Content="Serbia, Požega"/>
                    <ComboBoxItem Content="Serbia, Kragujevac"/>
                    <ComboBoxItem Content="Serbia, Niš"/>
                    <ComboBoxItem Content="Serbia, Subotica"/>
                    <ComboBoxItem Content="Serbia, Pančevo"/>
                    <ComboBoxItem Content="Serbia, Čačak"/>
                    <ComboBoxItem Content="Serbia, Užice"/>
                    <ComboBoxItem Content="Any"/>
                </ComboBox>
                <ComboBox   Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="155"
                            Height="30"
                            FontSize="15"
                            SelectedIndex="{Binding PickedDuration, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="0-1h"></ComboBoxItem>
                    <ComboBoxItem Content="1-2h"></ComboBoxItem>
                    <ComboBoxItem Content="2-3h"></ComboBoxItem>
                    <ComboBoxItem Content="3-4h"></ComboBoxItem>
                    <ComboBoxItem Content="4-5h"></ComboBoxItem>
                    <ComboBoxItem Content="Any"></ComboBoxItem>
                </ComboBox>
                <ComboBox   Grid.Row="1"
                            Grid.Column="2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Width="148"
                            Height="30"
                            FontSize="15" Margin="31,0,0,0"
                            SelectedIndex="{Binding PickedLanguage, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="English"></ComboBoxItem>
                    <ComboBoxItem Content="Serbian"></ComboBoxItem>
                    <ComboBoxItem Content="German"></ComboBoxItem>
                    <ComboBoxItem Content="Any"></ComboBoxItem>
                </ComboBox>
                <StackPanel Grid.Row="2"
                            Grid.Column="3"
                            Orientation="Horizontal"
                            Margin="0 3 0 0"
                            HorizontalAlignment="Left">

                    <TextBox Text="{Binding PickedMaxCapacity, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="22"
                             TextAlignment="Right"
                             VerticalContentAlignment="Center"
                             Height="32"
                             Width="160"
                             x:Name="PeopleCounter"
                             IsReadOnly="True"
                             Margin="5 0 0 0"
                             Padding="0 0 5 0"
                             
                             />
                    <Image Source="C:\Users\Korisnik\Desktop\ikone\person.png"
                           Height="24"
                           Width="24"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Margin="-155 0 0 0"/>
                    <StackPanel Orientation="Vertical">
                        <Button Content="▲"
                                Width="20"
                                Height="16"
                                Margin="0 2 0 0"
                                VerticalContentAlignment="Top"
                                FontSize="9.5"
                                HorizontalContentAlignment="Center"
                                Click="IncreaseCount_Click"/>
                        <Button Content="▼"
                                VerticalContentAlignment="Bottom"
                                Width="20"
                                Height="16"
                                Margin="0 0 0 0"
                                FontSize="9.5"
                                HorizontalContentAlignment="Center"
                                Click="DecreaseCount_Click"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1"
                            Grid.Column="4"
                            Orientation="Horizontal"
                            Margin="0 3 0 0"
                            HorizontalAlignment="Left">
                    <Button Grid.Row="1"
                        Grid.Column="4"
                        Width="160"
                        Height="35"
                        Margin="20 0 15 0"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Right"
                        Content="Search    "
                        FontSize="24"
                        FontFamily="Veradana" Click="Search_Click"/>
                    <Image Source="C:\Users\Korisnik\Desktop\ikone\search.png"
                           Height="24"
                           Width="24"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           Margin="-165 0 0 0"/>
                </StackPanel>
            </Grid>

        </Border>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Recommended tours:"
                   FontSize="25"
                   Margin="35 0 0 0">

            </Label>
            <ListView BorderThickness="0" 
                      Grid.Row="1"
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.CanContentScroll="False"
                      ItemsSource="{Binding Tours}"
                      SelectedItem="{Binding SelectedTour}"
                      MouseDoubleClick="TourDetails_Click">
                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <ContentPresenter HorizontalAlignment="Left" Margin="2,3,2,3" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray"
                                BorderThickness="1.5"
                                CornerRadius="20"
                                Height="280"
                                Width="1050"
                                Margin="35 10 30 10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="405"></ColumnDefinition>
                                    <ColumnDefinition Width="500"></ColumnDefinition>
                                    <ColumnDefinition Width="*"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding ImagesPath, Converter={StaticResource FirstImagePathConverter}}"
                                       Height="250"
                                       Width="400"
                                       HorizontalAlignment="Left"
                                       Grid.Column="0"
                                       Margin="15 0 0 0"/>
                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"></RowDefinition>
                                        <RowDefinition Height="auto"></RowDefinition>
                                        <RowDefinition Height="auto"></RowDefinition>
                                        <RowDefinition Height="auto"></RowDefinition>
                                        <RowDefinition Height="auto"></RowDefinition>
                                    </Grid.RowDefinitions>
                                    <Label Margin="0 5 0 0"
                                           Grid.Row="0"
                                           FontSize="22"
                                           FontFamily="Verdana"
                                           FontWeight="DemiBold"
                                           Width="500"
                                           Content="{Binding Name}">

                                    </Label>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"></ColumnDefinition>
                                            <ColumnDefinition Width="auto"></ColumnDefinition>
                                            <ColumnDefinition Width="auto"></ColumnDefinition>
                                            <ColumnDefinition Width="auto"></ColumnDefinition>
                                            <ColumnDefinition Width="auto"></ColumnDefinition>
                                            <ColumnDefinition Width="auto"></ColumnDefinition>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="4"
                                                    Orientation="Horizontal"
                                                    Margin="2 10 0 0"
                                                    HorizontalAlignment="Left">
                                            <Image Source="C:\Users\Korisnik\Desktop\ikone\star.png"
                                               Height="15"
                                               Width="15"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"
                                               Grid.Column="2"
                                               Margin="8 0 0 0"/>
                                            <Image Source="C:\Users\Korisnik\Desktop\ikone\star.png"
                                               Height="15"
                                               Width="15"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"
                                               Grid.Column="2"
                                               Margin="0 0 0 0"/>
                                            <Image Source="C:\Users\Korisnik\Desktop\ikone\star.png"
                                               Height="15"
                                               Width="15"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"
                                               Grid.Column="2"
                                               Margin="0 0 0 0"/>
                                            <Image Source="C:\Users\Korisnik\Desktop\ikone\star.png"
                                               Height="15"
                                               Width="15"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"
                                               Grid.Column="2"
                                               Margin="0 0 0 0"/>
                                            <Image Source="C:\Users\Korisnik\Desktop\ikone\half_star.png"
                                               Height="15"
                                               Width="15"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Top"
                                               Grid.Column="2"
                                               Margin="0 0 0 0"/>
                                            <Label Margin="0 -3 0 0"
                                               Grid.Row="0"
                                               FontSize="10"
                                               FontFamily="Verdana"
                                                   Width="500"
                                               Content="69 votes"/>
                                            
                                        </StackPanel>

                                    </Grid>
                                    <StackPanel Grid.Row="2"
                                                    Orientation="Horizontal"
                                                    Margin="2 0 0 0"
                                                    HorizontalAlignment="Left">
                                        <Image Source="C:\Users\Korisnik\Desktop\ikone\location.png"
                                               Height="17"
                                               Width="17"
                                               Grid.Row="2"
                                               Grid.Column="2"
                                               HorizontalAlignment="Left"
                                               Margin="7 4 0 0"/>
                                        <Label Margin="-2 4 0 0"
                                               Grid.Row="0"
                                               FontSize="11"
                                               FontFamily="Verdana"
                                               Width="500"
                                               Content="{Binding Location}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3"
                                                    Orientation="Horizontal"
                                                    Margin="2 0 0 0"
                                                    HorizontalAlignment="Left">
                                        <Image Source="C:\Users\Korisnik\Desktop\ikone\time.png"
                                               Height="17"
                                               Width="17"
                                               Grid.Row="2"
                                               Grid.Column="2"
                                               HorizontalAlignment="Left"
                                               Margin="7 4 0 0"/>
                                        <TextBlock Margin="4 6 0 0"
                                               FontSize="10"
                                               FontFamily="Verdana"
                                               Width="500">
                                            <Run Text="{Binding Duration}" />
                                            <Run Text="hour(s)" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Margin="12 10 0 0"
                                               Grid.Row="4"
                                               FontSize="15"
                                               FontFamily="Verdana"
                                               Width="500"
                                               Height="180"
                                               Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Left"/>
                                </Grid>

                                <Image Source="C:\Users\Korisnik\Desktop\ikone\verified.png"
                                       Height="30"
                                       Width="30"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Top"
                                       Grid.Column="2"
                                       Margin="0 10 10 0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</UserControl>
