<Window x:Class="BookingApp.WPF.Views.TouristView.TouristHomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookingApp.WPF.Views.TouristView"
        mc:Ignorable="d"
        Title="Limit"
        Height="720"
        Width="1152">
    <Window.Icon>
        <BitmapImage UriSource="../../../Resources/Images/logo.png" DecodePixelWidth="508" DecodePixelHeight="508"/>
    </Window.Icon>
    <Window.Resources>
        <Style x:Key="Centriranje"
               TargetType="TextBlock">
            <Setter Property="HorizontalAlignment"
                    Value="Center"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource LightGray}">
        <Grid.RowDefinitions>
            <RowDefinition Height="83"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border BorderThickness="0 1.5 0 1.5"
                BorderBrush="Gray" />
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0"
                  HorizontalAlignment="Left"
                  Margin="30 0 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="C:\Users\Korisnik\Desktop\ikone\logo.png"
                       Grid.Column="1"
                       Height="120"
                       Width="120"
                       VerticalAlignment="Center"/>
            </Grid>
            <Grid Grid.Column="1"
                  Margin="0 0 35 0"
                  HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Border BorderBrush="Gray"
                        BorderThickness="1.5"
                        CornerRadius="20"
                        Grid.Column="0"
                        Margin="0 15 11 15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock
                                       Grid.Column="1"
                                       Text="Personalization"
                                       FontFamily="Verdana"
                                       FontSize="20" 
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Width="auto"/>
                        <Image Grid.Column="0"
                                   Source="C:\Users\Korisnik\Desktop\ikone\personalization.png"
                                   Height="50"
                                   Width="50"
                                   VerticalAlignment="Center"/>
                        <Image
                                   Grid.Column="2"
                                   Source="C:\Users\Korisnik\Desktop\ikone\down_arrow.png"
                                   Height="32"
                                   Width="32"
                                   VerticalAlignment="Center"
                                   Margin="0 3 4 0"/>
                    </Grid>
                </Border>
                <Border BorderBrush="Gray"
                        BorderThickness="1.5"
                        CornerRadius="20"
                        Grid.Column="1"
                        Margin="0 15 0 15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock
                                       Grid.Column="1"
                                       Text="Profile"
                                       FontFamily="Verdana"
                                       FontSize="20" 
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Width="auto"/>
                        <Image Grid.Column="0"
                                   Source="C:\Users\Korisnik\Desktop\ikone\profile.png"
                                   Height="45"
                                   Width="45"
                                   VerticalAlignment="Center"
                                   Margin="4 0 2 0"/>
                        <Image
                                   Grid.Column="2"
                                   Source="C:\Users\Korisnik\Desktop\ikone\down_arrow.png"
                                   Height="32"
                                   Width="32"
                                   VerticalAlignment="Center"
                                   Margin="0 3 4 0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Border BorderThickness="0 0 0 1.5"
                BorderBrush="Gray"
                Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button 
                            BorderThickness="0"
                            Grid.Column="2"
                            Template="{StaticResource CustomButtonTemplate}"
                            Height="30"
                            Cursor="Hand"
                            Background="Transparent"
                            VerticalContentAlignment="Bottom"
                            HorizontalContentAlignment="Left"
                            Click="Requests_Click">
                    <Border
                            CornerRadius="4"
                            Width="170"
                            Style="{StaticResource BorderHover}"
                            Height="32"
                            Background="#6CFFBC"
                            HorizontalAlignment="Left"
                            BorderThickness="0">
                        <StackPanel 
                                    Orientation="Horizontal">

                            <Image Source="C:\Users\Korisnik\Desktop\ikone\request.png"
                                    Height="24"
                                    Width="24"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                       Margin="5 0 10 0"
                                    />
                            <TextBlock Text="Your Requests"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource PrimaryColor2}"
                                           FontWeight="Normal"
                                           FontSize="18"></TextBlock>

                        </StackPanel>
                    </Border>
                </Button>

                <Button 
                            BorderThickness="0"
                    Grid.Column="0"
                            Template="{StaticResource CustomButtonTemplate}"
                            Height="30"
                            Cursor="Hand"
                            Background="Transparent"
                            VerticalContentAlignment="Bottom"
                            HorizontalContentAlignment="Left"
                            Click="Button_Click_1"
                            >
                    <Border
                            CornerRadius="4"
                            Width="160"
                            Style="{StaticResource BorderHover}"
                            Height="32"
                            Background="#6CFFBC"
                            HorizontalAlignment="Left"
                            BorderThickness="0">
                        <StackPanel 
                                    Orientation="Horizontal">

                            <Image Source="C:\Users\Korisnik\Desktop\ikone\home.png"
                                    Height="20"
                                    Width="20"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                       Margin="5 0 10 0"
                                    />
                            <TextBlock Text="Home Page"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource PrimaryColor2}"
                                           FontWeight="Normal"
                                           FontSize="18"></TextBlock>

                        </StackPanel>
                    </Border>
                </Button>
                
                
                <Button 
                            BorderThickness="0"
                            Template="{StaticResource CustomButtonTemplate}"
                            Height="30"
                    Grid.Column="1"
                            Background="Transparent"
                            Cursor="Hand"
                            VerticalContentAlignment="Bottom"
                            HorizontalContentAlignment="Left"
                            Click="YourTours_Click">
                    <Border
                            CornerRadius="4"
                            Width="150"
                            Style="{StaticResource BorderHover}"
                            Height="30"
                            Background="#6CFFBC"
                            HorizontalAlignment="Left"
                            BorderThickness="0">
                        <StackPanel 
                                    Orientation="Horizontal"
                                    
                                    >

                            <Image Source="C:\Users\Korisnik\Desktop\ikone\tours.png"
                                    Height="24"
                                    Width="24"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                       Margin="5 0 10 0"
                                    />
                            <TextBlock Text="Your Tours"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource PrimaryColor2}"
                                           FontWeight="Normal"
                                           FontSize="18"></TextBlock>

                        </StackPanel>
                    </Border>
                </Button>
                
                
                
                <Button 
                            BorderThickness="0"
                            Template="{StaticResource CustomButtonTemplate}"
                            Height="30"
                               Grid.Column="3"
                            Cursor="Hand"
                            Background="Transparent"
                            VerticalContentAlignment="Bottom"
                            HorizontalContentAlignment="Left"
                            Click="Notifications_Click">
                    <Border
                            CornerRadius="4"
                            Width="160"
                            Style="{StaticResource BorderHover}"
                            Height="32"
                            Background="#6CFFBC"
                            HorizontalAlignment="Left"
                            BorderThickness="0">
                        <StackPanel 
                                    Orientation="Horizontal"
                                    
                                    >

                            <Image Source="C:\Users\Korisnik\Desktop\ikone\notifications.png"
                                    Height="24"
                                    Width="24"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                       Margin="5 0 10 0"
                                    />
                            <TextBlock Text="Notifications"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Foreground="{StaticResource PrimaryColor2}"
                                           FontWeight="Normal"
                                           FontSize="18"></TextBlock>

                        </StackPanel>
                    </Border>
                </Button>
            </Grid>
        </Border>
        <ContentControl Grid.Row="2"
                        x:Name="contentControl1" />
    </Grid>
</Window>
