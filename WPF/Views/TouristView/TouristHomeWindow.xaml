<Window x:Class="BookingApp.WPF.Views.TouristView.TouristHomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookingApp.WPF.Views.TouristView"
        mc:Ignorable="d"
        Title="Limit"
        Height="720"
        Width="1152">
    <Window.Icon>
        <BitmapImage UriSource="../../../Resources/Images/logo.png" DecodePixelWidth="508" DecodePixelHeight="508"/>
    </Window.Icon>
    <Window.Resources>
        <Style x:Key="Centriranje"
               TargetType="TextBlock">
            <Setter Property="HorizontalAlignment"
                    Value="Center"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource LightGray}">
        <Grid.RowDefinitions>
            <RowDefinition Height="83"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border BorderThickness="0 1.5 0 1.5"
                BorderBrush="Gray" />
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0"
                  HorizontalAlignment="Left"
                  Margin="30 0 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="C:\Users\Korisnik\Desktop\ikone\logo.png"
                       Grid.Column="1"
                       Height="120"
                       Width="120"
                       VerticalAlignment="Center"/>
            </Grid>
            <Grid Grid.Column="1"
                  Margin="0 0 35 0"
                  HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Border BorderBrush="Gray"
                        BorderThickness="1.5"
                        CornerRadius="20"
                        Grid.Column="0"
                        Margin="0 15 11 15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock
                                       Grid.Column="1"
                                       Text="Personalization"
                                       FontFamily="Verdana"
                                       FontSize="20" 
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Width="auto"/>
                        <Image Grid.Column="0"
                                   Source="C:\Users\Korisnik\Desktop\ikone\personalization.png"
                                   Height="50"
                                   Width="50"
                                   VerticalAlignment="Center"/>
                        <Image
                                   Grid.Column="2"
                                   Source="C:\Users\Korisnik\Desktop\ikone\down_arrow.png"
                                   Height="32"
                                   Width="32"
                                   VerticalAlignment="Center"
                                   Margin="0 3 4 0"/>
                    </Grid>
                </Border>
                <Border BorderBrush="Gray"
                        BorderThickness="1.5"
                        CornerRadius="20"
                        Grid.Column="1"
                        Margin="0 15 0 15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock
                                       Grid.Column="1"
                                       Text="Profile"
                                       FontFamily="Verdana"
                                       FontSize="20" 
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Width="auto"/>
                        <Image Grid.Column="0"
                                   Source="C:\Users\Korisnik\Desktop\ikone\profile.png"
                                   Height="45"
                                   Width="45"
                                   VerticalAlignment="Center"
                                   Margin="4 0 2 0"/>
                        <Image
                                   Grid.Column="2"
                                   Source="C:\Users\Korisnik\Desktop\ikone\down_arrow.png"
                                   Height="32"
                                   Width="32"
                                   VerticalAlignment="Center"
                                   Margin="0 3 4 0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Border BorderThickness="0 0 0 1.5"
                BorderBrush="Gray"
                Grid.Row="1">
            <Grid>
                <Button Width="150"
                        Height="30"
                        Margin="-400 0 0 0"
                        Content="Your Requests"
                        FontWeight="DemiBold"
                        Click="Requests_Click">

                </Button>
                <Button Width="150"
                        Height="30"
                        Content="H O M E"
                        FontWeight="DemiBold"
                        Click="Button_Click">
                    
                </Button>
                <Button Width="150"
                        Height="30"
                        Content="Your Tours"
                        FontWeight="DemiBold"
                        Margin="400 0 0 0"
                        Click="YourTours_Click">

                </Button>
                <Button Width="150"
                        Height="30"
                        Content="Notifications"
                        FontWeight="DemiBold"
                        Margin="800 0 0 0"
                        Click="Notifications_Click">

                </Button>
            </Grid>
        </Border>
        <ContentControl Grid.Row="2"
                        x:Name="contentControl1" />
    </Grid>
</Window>
