<UserControl x:Class="BookingApp.WPF.Views.RegisterAccommodationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views"
             mc:Ignorable="d" 
            d:DesignHeight="572" d:DesignWidth="1108">
    <UserControl.Resources>
        <Style x:Key="TextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TextBox" TargetType="TextBox">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="SlateGray"/>
            <Setter Property="BorderThickness" Value="0 0 0 3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StackPanel" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="BorderButtons" TargetType="Border">
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Width" Value="140"/>
        </Style>
        <Style x:Key="Buttons" TargetType="Button">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="Black" BorderThickness="3" Padding="10" Width="670" Height="513">
        <Grid Width="670" Height="506" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="1.4*" />
            </Grid.RowDefinitions>
            <TextBlock Text="Register accommodation" 
                   Grid.ColumnSpan="2" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Top"
                   FontSize="32"/>
            <TextBlock Text="Accommodation name :"                 
                   Grid.Row="1"
                   Style="{StaticResource TextBlockStyle}"/>
            <TextBox Grid.Column="1" 
                     Grid.Row="1"
                     Height="32"
                     Width="300"  
                     Style="{StaticResource TextBox}" Text="{Binding Name}"/>
            <TextBlock Text="Location :"                 
                   Grid.Row="2"
                   Style="{StaticResource TextBlockStyle}"/>
            <ComboBox Grid.Column="1" 
                      Grid.Row="2"
                      Height="32"
                      Width="200"  
                      HorizontalAlignment="Left" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="20" Padding="0 0 0 1" SelectedIndex="{Binding LocationId}">
                <ComboBoxItem Content="Serbia, Novi Sad"/>
                <ComboBoxItem Content="Serbia, Beograd"/>
                <ComboBoxItem Content="Serbia, Smederevo"/>
                <ComboBoxItem Content="Serbia, Požega"/>
                <ComboBoxItem Content="Serbia, Kragujevac"/>
                <ComboBoxItem Content="Serbia, Niš"/>
                <ComboBoxItem Content="Serbia, Subotica"/>
                <ComboBoxItem Content="Serbia, Pančevo"/>
                <ComboBoxItem Content="Serbia, Čačak"/>
                <ComboBoxItem Content="Serbia, Užice"/>
            </ComboBox>
            <TextBlock Text="Type :"                 
                   Grid.Row="3"
                    Style="{StaticResource TextBlockStyle}"/>
            <ComboBox Grid.Column="1" 
                      Grid.Row="3"
                      Height="32"
                      Width="200"  
                      HorizontalAlignment="Left" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="20" SelectedIndex="{Binding Type}">
                <ComboBoxItem Content="Apartment"/>
                <ComboBoxItem Content="Hotel"/>
                <ComboBoxItem Content="Cottage"/>
            </ComboBox>
            <TextBlock Text="Cancellation deadline :"                 
                   Grid.Row="4"
                   Style="{StaticResource TextBlockStyle}"/>
            <TextBox Grid.Column="1" 
                     Grid.Row="4"
                     Height="32"
                     Width="50"  
                     Style="{StaticResource TextBox}" Text="{Binding CancellationDeadline}"/>
            <TextBlock Text="Maximum capacity :"                 
                   Grid.Row="5"
                    Style="{StaticResource TextBlockStyle}"/>
            <TextBox Grid.Column="1" 
                     Grid.Row="5"
                     Height="32"
                     Width="50"  
                     Style="{StaticResource TextBox}" Text="{Binding MaxCapacity}"/>
            <TextBlock Text="Minimum days to stay :"                 
                   Grid.Row="6"
                   Style="{StaticResource TextBlockStyle}"/>
            <TextBox Grid.Column="1" 
                     Grid.Row="6"
                     Height="32"
                     Width="50"  
                     Style="{StaticResource TextBox}" Text="{Binding MinDaysToStay}"/>
            <Button Grid.Column="0"
                FontSize="24" 
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0" Grid.Row="7" HorizontalAlignment="Center" Height="50" Grid.ColumnSpan="2" Command="{Binding UploadCommand}">
                <Border  BorderBrush="Black"
                                             BorderThickness="3"
                                             CornerRadius="10"  
                                             Width="250" Height="48">
                    <StackPanel Style="{StaticResource StackPanel}">
                        <Image  Source="C:\Users\lukai\Desktop\Resource\upload.png" 
                                               Width="32" 
                                               Height="32"
                                               Margin="0 0 10 0"/>
                        <TextBlock  Text="Upload a picture"/>
                    </StackPanel>
                </Border>
            </Button>
            <Button Grid.Column="0"
                    Grid.Row="8"
                    Style="{StaticResource Buttons}">
                <Border  BorderBrush="DarkRed"
                         Style="{StaticResource BorderButtons}">
                    <StackPanel   Style="{StaticResource StackPanel}">
                        <TextBlock  Text="Cancel" Foreground="DarkRed" />
                    </StackPanel>
                </Border>
            </Button>
            <Button Grid.Column="1"
                    Grid.Row="8" 
                    Style="{StaticResource Buttons}" Command="{Binding SaveCommand}">
                <Border  BorderBrush="DarkGreen"
                         Style="{StaticResource BorderButtons}">
                    <StackPanel  Style="{StaticResource StackPanel}">
                        <TextBlock  Text="Register" Foreground="DarkGreen" />
                    </StackPanel>
                </Border>
            </Button>
        </Grid>
    </Border>
</UserControl>
