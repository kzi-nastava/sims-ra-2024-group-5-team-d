<Window x:Class="BookingApp.WPF.Views.TourRealisationsForTourToday"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookingApp.WPF.Views"
        mc:Ignorable="d"
        Title="TourRealisationsForTourToday" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Start Time Label -->
        <Label Content="Start Time" Grid.Row="0" HorizontalAlignment="Center" Margin="0,10"/>

        <!-- DataGrid to display tour realizations -->
        <DataGrid ItemsSource="{Binding Realisations,UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding SelectedRealisation}" SelectionMode="Single" Grid.Row="1" AutoGenerateColumns="False" Margin="10" IsReadOnly="True">
            <DataGrid.Columns>
                <!-- Column for Start Time -->
                <DataGridTextColumn Header="Start Time" Binding="{Binding StartTime}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Button to Start Tour -->
        <Button Content="Start Tour" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Click="StartTour_Click"/>
    </Grid>
</Window>
