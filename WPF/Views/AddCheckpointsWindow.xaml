<Window x:Class="BookingApp.WPF.Views.AddCheckpointsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Checkpoints" Height="300" Width="400">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Heading -->
        <TextBlock Text="Checkpoints" FontSize="20" HorizontalAlignment="Center" Margin="0,10,0,0"/>

        <!-- StackPanel to hold dynamically added textboxes -->
        <StackPanel x:Name="TextBoxPanel" Margin="10" Grid.Row="1"/>

        <!-- Button to add checkpoints -->
        <Button Content="Add" HorizontalAlignment="Center" Margin="0,10,0,10" Grid.Row="2" Click="AddButton_Click"/>
    </Grid>
</Window>
