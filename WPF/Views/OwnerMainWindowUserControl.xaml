<UserControl x:Class="BookingApp.WPF.Views.OwnerMainWindowUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:BookingApp.WPF.Views"
             mc:Ignorable="d" 
            d:DesignHeight="572" d:DesignWidth="1108">
    <UserControl.Resources>
        <local:FirstImagePathConverter x:Key="FirstImagePathConverter" />
    </UserControl.Resources>
    <Grid 
              Width="920"
              Margin="0 0 0 30">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock
                   Grid.Row="0" 
                   Text="Your accommodations" 
                   FontSize="36" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        <ListView BorderThickness="0" 
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Grid.Row="1"
                      ScrollViewer.CanContentScroll="False" ItemsSource="{Binding Accommodations}">
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <ContentPresenter HorizontalAlignment="Left" Margin="2,3,2,3" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" 
                                BorderThickness="3" 
                                CornerRadius="10"
                                Width="880">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding ImagesPath, Converter={StaticResource FirstImagePathConverter}}" 
                                       Width="100" 
                                       Height="100" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"                                      
                                       Grid.RowSpan="2"/>
                            <TextBlock Text="{Binding Name}" 
                                           Grid.Column="1" 
                                           FontSize="24" 
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Location}" 
                                           Grid.Column="1"
                                           Grid.Row="1"
                                           FontSize="20"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            <Grid x:Name="StarGrid" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="C:\Users\lukai\Desktop\Resource\StarFull.png" 
                                           Width="24" 
                                           Height="24" 
                                           Grid.Column="0"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                                <Image Source="C:\Users\lukai\Desktop\Resource\StarHalfFull.png" 
                                           Width="24" 
                                           Height="24" 
                                           Grid.Column="1"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                                <Image Source="C:\Users\lukai\Desktop\Resource\idemo.png" 
                                           Width="24" 
                                           Height="24" 
                                           Grid.Column="2"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                                <Image Source="C:\Users\lukai\Desktop\Resource\idemo.png" 
                                           Width="22" 
                                           Height="22" 
                                           Grid.Column="3"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                                <Image Source="C:\Users\lukai\Desktop\Resource\idemo.png" 
                                           Width="22" 
                                           Height="22" 
                                           Grid.Column="4"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding Type}" 
                                           Grid.Column="2"
                                           Grid.Row="1"
                                           FontSize="20"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            <Image Source="C:\Users\lukai\Desktop\Resource\chat.png" 
                                       Width="24" 
                                       Height="24" 
                                       Grid.Row="0"
                                       Grid.Column="3"
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="4"
                                        FontSize="20" 
                                        FontWeight="Bold"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0" 
                                        Click="RenovateClick">
                                <Border  BorderBrush="Black"
                                             BorderThickness="2"
                                             CornerRadius="8"  
                                             Width="140">
                                    <StackPanel  Orientation="Horizontal">
                                        <Image  Source="C:\Users\lukai\Desktop\Resource\hammer.png" 
                                               Width="24" 
                                               Height="24"
                                               Margin="5 0 10 0"/>
                                        <TextBlock  Text="Renovate"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                            <Button Grid.Column="4"
                                        Grid.Row="1"
                                        Background="Transparent" 
                                        FontSize="20" 
                                        FontWeight="Bold"
                                        BorderThickness="0"
                                        VerticalAlignment="Center" Click="ShowStats">
                                <Border BorderBrush="Black" 
                                            BorderThickness="2" 
                                            CornerRadius="8"  
                                            Width="140">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="C:\Users\lukai\Desktop\Resource\stats.png" 
                                               Width="24" 
                                               Height="24"
                                               Margin="5 0 5 0"/>
                                        <TextBlock Text="Show stats"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
