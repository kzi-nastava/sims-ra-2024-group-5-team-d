<Window x:Class="BookingApp.WPF.Views.OwnerView.ShowDetailedReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookingApp.WPF.Views.OwnerView"
        mc:Ignorable="d"
        Title="ShowDetailsWindow" Height="500" Width="450">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding GuestName}" FontSize="32" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image  Source="C:\Users\lukai\Desktop\Resource\home.png" 
                                               Width="32" 
                                               Height="32"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"  Margin="0 0 10 0"/>
                <TextBlock Grid.Column="1" Text="{Binding AccommodationName}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <Grid Grid.Column="1" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image  Source="C:\Users\lukai\Desktop\Resource\location.png" 
                                               Width="24" 
                                               Height="24"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" Margin="0 0 5 0"/>
                <TextBlock Grid.Column="1" Text="{Binding Location}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="30 10 30 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Cleanliness :" HorizontalAlignment="Left" FontSize="28"/>
            <Grid Grid.Column="1" HorizontalAlignment="Left" Margin="10 0 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="{Binding CleanlinessRating}" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="24"/>
                <Image Grid.Column="1" Source="C:\Users\lukai\Desktop\Resource\star.png" 
                                               Width="32" 
                                               Height="32"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" Margin="5 0 0 0"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="3" Margin="30 10 30 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Correctness :" HorizontalAlignment="Left" FontSize="28"/>
            <Grid Grid.Column="1" HorizontalAlignment="Left" Margin="10 0 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="{Binding CorrectnessRating}" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="24"/>
                <Image Grid.Column="1" Source="C:\Users\lukai\Desktop\Resource\star.png" 
                                               Width="32" 
                                               Height="32"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" Margin="5 0 0 0"/>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="4" Text="Additional comment :" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="28" Margin="0 0 0 10"/>
        <TextBox IsReadOnly="True" FontSize="20" Text="{Binding Comment}" Grid.Row="5" Padding="10" BorderBrush="Black" BorderThickness="2" Margin="20 0 20 0" TextWrapping="WrapWithOverflow"/>
        <Button Margin="0 10 0 10" Grid.Row="6" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Click="Close">
            <Border BorderBrush="Black" BorderThickness="2" Padding="2">
                <TextBlock Text="OK" FontSize="24" Margin="5 0 5 0"/>
            </Border>
        </Button>
    </Grid>
</Window>
