<UserControl x:Class="BookingApp.WPF.Views.OwnerView.UnratedGuestsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.OwnerView"
              xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="572" d:DesignWidth="1108">
    <Grid 
              Width="900"
              Margin="0 0 0 30">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock
                   Grid.Row="0" 
                   Text="Review guest"
                   FontSize="32" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        <ListView BorderThickness="0" 
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Grid.Row="1"
                      ScrollViewer.CanContentScroll="False" ItemsSource="{Binding UnratedGuests}" SelectedItem="{Binding SelectedGuest}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" 
                                BorderThickness="3" 
                                CornerRadius="10"
                                Width="860" Margin="0 0 0 15">
                        <Grid Margin="10" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Foreground="#124076" Grid.Column="0" FontSize="28" FontWeight="Bold"/>
                                <Grid Grid.Column="1" HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image  Source="C:\Users\lukai\Desktop\Resource\home.png" 
                                               Width="28" 
                                               Height="28"
                                               Grid.Column="0" 
                                               HorizontalAlignment="Left" 
                                               VerticalAlignment="Center" Margin="0 0 10 0"/>
                                    <TextBlock Text="{Binding AccommodationName}" FontWeight="Bold" Grid.Column="1" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                </Grid>
                                <Grid Grid.Column="2" Margin="30 0 0 0" HorizontalAlignment="Right">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image  Source="C:\Users\lukai\Desktop\Resource\Location.png" 
                                               Width="28" 
                                               Height="28"
                                               Grid.Column="0" 
                                               HorizontalAlignment="Left" 
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Location}" Grid.Column="1" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                            <Grid Grid.Column="0" Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Reservation dates :" Grid.Column="0" Grid.Row="1" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                <Grid Grid.Column="1" Grid.Row="1">
                                    <Grid.ColumnDefinitions >
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding ReservedFrom,StringFormat={}{0:dd.MM.yyyy}}" Grid.Column="0" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text=" - " Grid.Column="1" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ReservedTo,StringFormat={}{0:dd.MM.yyyy}}" Grid.Column="2" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                            <Button Grid.Column="3"
                                    FontSize="20" 
                                    Background="Transparent"
                                    Height="70"
                                    VerticalAlignment="Center"
                                    Grid.RowSpan="2"
                                    BorderThickness="0" Grid.Row="0" HorizontalAlignment="Center" Margin="20 0 0 0" Click="RateGuest">
                                <Border  BorderBrush="Yellow"
                                             BorderThickness="3"
                                             CornerRadius="10"
                                             Height="68" Padding="10"
                                             >
                                    <StackPanel  Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image  Source="C:\Users\lukai\Desktop\Resource\star.png" 
                                               Width="32" 
                                               Height="32"
                                               Margin="0 0 5 0" />
                                        <TextBlock Margin="0 2 0 0" Foreground="Yellow" FontWeight="Normal" Text="Rate guest"></TextBlock>
                                    </StackPanel>
                                </Border>
                            </Button>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
