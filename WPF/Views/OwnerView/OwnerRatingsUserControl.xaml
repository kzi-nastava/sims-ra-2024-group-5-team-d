<UserControl x:Class="BookingApp.WPF.Views.OwnerView.OwnerRatingsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.OwnerView"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="572" d:DesignWidth="1108">
    <Grid Width="950">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Your reviews" Grid.ColumnSpan="2" FontSize="40" Margin="10" HorizontalAlignment="Center"/>
            <Button Grid.Column="1" HorizontalAlignment="Right" Margin="0 0 33 0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                <Border BorderBrush="DarkRed" BorderThickness="3" Padding="5" CornerRadius="15">
                    <StackPanel  Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image  Source="C:\Users\lukai\Desktop\Resource\pdf.png" 
                                               Width="32" 
                                               Height="32"
                                               Margin="0 0 5 0" VerticalAlignment="Center"/>
                        <TextBlock  Text="Download pdf" Margin="5 1 5 0" Foreground="DarkRed" VerticalAlignment="Center" FontSize="20" FontWeight="Normal"/>
                    </StackPanel>
                </Border>
            </Button>
        </Grid>
        <ListView BorderThickness="0" 
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      ScrollViewer.CanContentScroll="False" Margin="0,73,0,0" Grid.RowSpan="2" ItemsSource="{Binding OwnerRatings}" SelectedItem="{Binding SelectedOwnerRating}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" 
                                BorderThickness="3" 
                                CornerRadius="10"
                                Width="910" Margin="0 0 0 15">
                        <Grid Margin="10" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <Image  Source="C:\Users\lukai\Desktop\Resource\profile.png" 
                                               Width="78" 
                                               Height="78"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" 
                                    Grid.RowSpan="2"/>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding GuestName}" Foreground="#124076" Grid.Column="0" FontSize="24" FontWeight="Bold"/>
                                <Grid Grid.Column="1" HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="C:\Users\lukai\Desktop\Resource\StarFull.png" 
                                           Width="32" 
                                           Height="32" 
                                           Grid.Column="0"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                                    <Image Source="C:\Users\lukai\Desktop\Resource\StarHalfFull.png" 
                                           Width="32" 
                                           Height="32" 
                                           Grid.Column="1"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                                    <Image Source="C:\Users\lukai\Desktop\Resource\idemo.png" 
                                           Width="32" 
                                           Height="32" 
                                           Grid.Column="2"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                                    <Image Source="C:\Users\lukai\Desktop\Resource\idemo.png" 
                                           Width="32" 
                                           Height="32" 
                                           Grid.Column="3"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                                    <Image Source="C:\Users\lukai\Desktop\Resource\idemo.png" 
                                           Width="32" 
                                           Height="32" 
                                           Grid.Column="4"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>

                                </Grid>
                                <Grid Grid.Column="2" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image  Source="C:\Users\lukai\Desktop\Resource\home.png" 
                                               Width="24" 
                                               Height="24"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                            Margin="10 0 10 0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding AccommodationName}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Grid.Column="3" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image  Source="C:\Users\lukai\Desktop\Resource\location.png" 
                                               Width="24" 
                                               Height="24"
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                            Margin="10 0 5 0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Location}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Grid>
                            <Border Grid.Row="1" MaxHeight="69" Grid.Column="1" BorderBrush="Black" BorderThickness="2" Margin="0 10 0 0" CornerRadius="10">
                                <TextBlock  Text="{Binding Comment}" FontSize="17" TextWrapping="WrapWithOverflow" Padding="10"/>
                            </Border>
                            <Label Grid.Column="2" Content="2 months ago" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="15"/>
                            <Button Grid.Column="2" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Margin="0 10 0 0"  Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}">
                                <Border BorderBrush="CadetBlue" BorderThickness="3" Padding="5" CornerRadius="15">
                                    <StackPanel  Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Image  Source="C:\Users\lukai\Desktop\Resource\info2.png" 
                                               Width="32" 
                                               Height="32"
                                               Margin="0 0 5 0" VerticalAlignment="Center"/>
                                        <TextBlock TextAlignment="Center" Margin="5 1 5 0" Foreground="CadetBlue" VerticalAlignment="Center" FontSize="20" FontWeight="Normal"><Run Text="Show "/><LineBreak/><Run Text="details"/></TextBlock>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
