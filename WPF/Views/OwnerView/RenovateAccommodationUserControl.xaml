<UserControl x:Class="BookingApp.WPF.Views.OwnerView.RenovateAccommodationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.OwnerView"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:converter="clr-namespace:BookingApp.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="572" d:DesignWidth="1108">
    <UserControl.Resources>
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="20 0 20 30">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding SelectDate.AccommodationName}" Grid.ColumnSpan="2" HorizontalAlignment="Center" FontSize="40" Margin="0 5 0 10"/>
            <TextBlock Grid.Row="1" Text="Renovate from:" FontSize="20" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Renovate to:" Grid.Column="0" FontSize="20" HorizontalAlignment="Center"/>
            <DatePicker Grid.Row="2" SelectedDate="{Binding SelectDate.RenovateFrom}" HorizontalAlignment="Center"  FontSize="18" Margin="0 10 0 0"/>
            <DatePicker Grid.Row="2" SelectedDate="{Binding SelectDate.RenovateTo}" Grid.ColumnSpan="2" Grid.Column="0" HorizontalAlignment="Center" Margin="0 10 0 0" FontSize="18"/>
            <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" Text="Days for renovation" FontSize="20"/>
            <TextBox BorderBrush="Black" BorderThickness="0 0 0 3" Grid.Row="2" HorizontalAlignment="Center" Width="80" TextAlignment="Center" Grid.Column="1" FontSize="18" Margin="0 10 0 0" Text="{Binding SelectDate.DaysForRenovation}"/>
            <Button Grid.Column="0"
                    Grid.Row="5"
                    Grid.ColumnSpan="2"
                                    FontSize="20" 
                                    Background="Transparent"
                                    VerticalAlignment="Center"
                    Margin="0 10 0 0"
                        Command="{Binding ShowAvailableDatesCommand}"
                                    BorderThickness="0" HorizontalAlignment="Center" >
                <Border  BorderBrush="DarkGreen"
                                             BorderThickness="3"
                                             CornerRadius="10"
                                             Width="auto">
                    <StackPanel  Orientation="Horizontal" VerticalAlignment="Center">
                        <Image  Source="C:\Users\lukai\Desktop\Resource\check.png" 
                                               Width="24" 
                                               Height="24"
                                               Margin="10 0 5 0"/>
                        <TextBlock Margin="0 0 10 0" TextAlignment="Center" Foreground="DarkGreen" FontWeight="Bold" FontSize="17"><Run Text="Show available"/><LineBreak/><Run Text=" dates" /></TextBlock>
                    </StackPanel>
                </Border>
            </Button>
        </Grid>
        <Grid Grid.Row="1" Margin="0 10 0 0" Visibility="{Binding SelectDate.ShowRenovationDates,Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Available dates for renovation" HorizontalAlignment="Center" FontSize="20"/>
            <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" FontSize="17" Width="500" Margin="0 10 0 0" ItemsSource="{Binding AvailableDates}" SelectedItem="{Binding SelectedAvailableDate}" MaxHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Available from :" Width="*" Binding="{Binding FromDate, StringFormat='dd.MM.yyyy'}" FontSize="17"/>
                    <DataGridTextColumn Header="Available to :" Width="*" Binding="{Binding ToDate, StringFormat='dd.MM.yyyy'}" FontSize="17"/>
                    <DataGridTemplateColumn Header="Select" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <RadioButton IsChecked="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Button Grid.Row="2"
                                    FontSize="20" 
                                    Background="Transparent"
                                    Height="50"
                                    VerticalAlignment="Center"
                                    BorderThickness="0"  HorizontalAlignment="Center" Margin="0 10 0 0" Command="{Binding ReserveRenovationCommand}">
                <Border  BorderBrush="DarkGreen"
                                             BorderThickness="3"
                                             CornerRadius="10"
                                              Height="48">
                    <StackPanel  Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image  Source="C:\Users\lukai\Desktop\Resource\check.png" 
                                               Width="32" 
                                               Height="32"
                                               Margin="10 0 5 0"/>
                        <TextBlock  Text="Reserve for renovation" Margin="5 1 0 0" Foreground="DarkGreen" FontWeight="Normal"/>
                    </StackPanel>
                </Border>
            </Button>
        </Grid>
    </Grid>
</UserControl>
