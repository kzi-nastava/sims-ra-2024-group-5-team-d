<UserControl x:Class="BookingApp.WPF.Views.OwnerView.RequestsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.OwnerView"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="572" d:DesignWidth="1108">
    <Grid 
              Width="885"
              Margin="0 0 0 30">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock
                   Grid.Row="0" 
                   Text="Guest requests" 
                   FontSize="32" 
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        <ListView BorderThickness="0" 
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Grid.Row="1"
                      ScrollViewer.CanContentScroll="False">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" 
                                BorderThickness="3" 
                                CornerRadius="10"
                                Width="844">
                        <Grid Margin="10" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <Grid  Grid.Row="0" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Milan Kovacevic" Foreground="#124076" Grid.Column="0" FontSize="24" FontWeight="Bold"/>
                                <Image  Source="C:\Users\lukai\Desktop\Resource\Home.png" 
                                               Width="28" 
                                               Height="28"
                                               Margin="18 0 0 3" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock HorizontalAlignment="Center" Text="Stars Palic" Grid.Column="1" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Image  Source="C:\Users\lukai\Desktop\Resource\Location.png" 
                                               Width="28" 
                                               Height="28"
                                               Margin="18 0 0 0" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                <TextBlock Text="Serbia, Palic " Grid.Column="2" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                            </Grid>
                            <Grid Grid.Row="1" Height="30" Margin="0 10 0 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Previous reservation dates :" Grid.Column="0" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock HorizontalAlignment="Left" Text="12.5.2024. " VerticalAlignment="Center" Grid.Column="1" FontSize="20" FontWeight="Bold" Margin="10 0 0 0"/>
                                <TextBlock Text="- " Grid.Column="2" FontSize="32" VerticalAlignment="Center" Padding="0 0 0 7"/>
                                <TextBlock HorizontalAlignment="Left" Text="20.5.2024. " Grid.Column="3" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid Grid.Row="2" Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="241"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="New reservation dates :" Grid.Column="0" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock HorizontalAlignment="Left" Text="12.5.2024. " VerticalAlignment="Center" Grid.Column="1" FontSize="20" FontWeight="Bold" Margin="10 0 0 0"/>
                                <TextBlock Text="- " Grid.Column="2" FontSize="32" VerticalAlignment="Center" Padding="0 0 0 7"/>
                                <TextBlock HorizontalAlignment="Left" Text="20.5.2024. " Grid.Column="3" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="You already have a reservation for requested date" Grid.Row="3" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    FontSize="20" 
                                    Background="Transparent"
                                    Height="50"
                                    VerticalAlignment="Center"
                                    Grid.RowSpan="2"
                                    BorderThickness="0" Grid.Row="0" HorizontalAlignment="Center" Command="{Binding AcceptRequestCommand}" >
                                <Border  BorderBrush="DarkGreen"
                                             BorderThickness="3"
                                             CornerRadius="10"
                                         Height="48"
                                             Width="140">
                                    <StackPanel  Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image  Source="C:\Users\lukai\Desktop\Resource\Check.png" 
                                               Width="32" 
                                               Height="32"
                                               Margin="10 0 5 0"/>
                                        <TextBlock  Text="Accept" Margin="0 2 0 0" Foreground="DarkGreen" FontWeight="Normal"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                            <Button Grid.Column="1"
                                    FontSize="20" 
                                    Background="Transparent"
                                    Height="50"
                                    VerticalAlignment="Center"
                                    Grid.RowSpan="2"
                                    BorderThickness="0" Grid.Row="2" HorizontalAlignment="Center" Command="{Binding DenyRequestCommand}" >
                                <Border  BorderBrush="DarkRed"
                                             BorderThickness="3"
                                             CornerRadius="10"
                                         Height="48"
                                             Width="140">
                                    <StackPanel  Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image  Source="C:\Users\lukai\Desktop\Resource\X.png" 
                                               Width="32" 
                                               Height="32"
                                               Margin="10 0 5 0"/>
                                        <TextBlock  Text="Deny" Margin="5 1 0 0" Foreground="DarkRed" FontWeight="Normal"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemsSource>
                <x:Array Type="{x:Type sys:String}">
                    <sys:String>Ala</sys:String>
                    <sys:String>Bela</sys:String>
                    <sys:String>Ceca</sys:String>
                    <sys:String>Veca</sys:String>
                </x:Array>
            </ListView.ItemsSource>
        </ListView>
    </Grid>
</UserControl>
