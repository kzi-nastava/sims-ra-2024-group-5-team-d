<UserControl x:Class="BookingApp.WPF.Views.OwnerView.SmallMenuUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.OwnerView"
             mc:Ignorable="d" 
              d:DesignHeight="310" d:DesignWidth="92">
    <UserControl.Resources>
        <Style x:Key="ImageMarginLeftMenu" TargetType="Image">
            <Setter Property="Margin" Value="0 0 0 20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TextBlockMarginLeftMenu" TargetType="TextBlock">
            <Setter Property="Margin" Value="0 0 0 10"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border BorderBrush="Black" 
                Grid.Row="1" 
                BorderThickness="2 0 2 2"               
                Height="310"
                VerticalAlignment="Top"/>
        <Grid Grid.Row="1"  
              Height="304" 
              VerticalAlignment="Top"
              Margin="7"
              Cursor="Hand" 
              Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Button BorderThickness="0" Background="Transparent" Command="{Binding SwitchViewCommand}" CommandParameter="0" Margin="0 0 0 5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Image Source="C:\Users\lukai\Desktop\Resource\inbox1.png" 
               Height="32" 
               Width="32" 
               Style="{StaticResource ImageMarginLeftMenu}"
               Margin="0 2 0 2"
               Grid.Row="0"/>
                    <TextBlock Text="Requests" 
                       FontSize="14"
                                Margin="0 3 0 0"
                       Style="{StaticResource TextBlockMarginLeftMenu}"
                               Grid.Row="1"/>
                </Grid>
            </Button>
            <Button Background="Transparent" BorderThickness="0"  Grid.Row="1" Command="{Binding SwitchViewCommand}" CommandParameter="1" Margin="0 0 0 5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Image Source="C:\Users\lukai\Desktop\Resource\renovations.png"
                           Height="32" 
                           Width="32" 
                           Margin="0 5 0 5"
               Style="{StaticResource ImageMarginLeftMenu}"
               Grid.Row="0"/>
                    <TextBlock Text="Renovations" 
                       FontSize="14"
                       Grid.Row="1"
                       Margin="0 3 0 0"
                       Style="{StaticResource TextBlockMarginLeftMenu}"/> 
                </Grid>
            </Button>
            <Button Grid.Row="2" BorderThickness="0" Background="Transparent" Command="{Binding SwitchViewCommand}" CommandParameter="2" Margin="0 0 0 5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Image Source="C:\Users\lukai\Desktop\Resource\star.png" 
               Height="32" 
               Width="32"
                           Margin="0 3 0 0"
               Style="{StaticResource ImageMarginLeftMenu}"
               Grid.Row="0"/>
                    <TextBlock Text="Reviews" 
                       FontSize="14"
                       Grid.Row="1"
                                 Margin="0 6 0 0"
                       Style="{StaticResource TextBlockMarginLeftMenu}"/>
                </Grid>
            </Button>
            <Button Background="Transparent" BorderThickness="0" Grid.Row="3" Command="{Binding SwitchViewCommand}" CommandParameter="3" Margin="0 0 0 10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Image Source="C:\Users\lukai\Desktop\Resource\forum.png" 
               Height="32" 
               Width="32"
               Margin="0 2 0 0"
               Style="{StaticResource ImageMarginLeftMenu}"
               Grid.Row="0"/>
                    <TextBlock Text="Forum" 
                       FontSize="14"
                       Grid.Row="1"
                                Margin="0 7 0 0"
                       Style="{StaticResource TextBlockMarginLeftMenu}"/>
                </Grid>
            </Button>
        </Grid>
    </Grid>
</UserControl>
