<UserControl x:Class="BookingApp.WPF.Views.OwnerView.RenovationsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.OwnerView"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:converter="clr-namespace:BookingApp.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="572" d:DesignWidth="1108">
    <UserControl.Resources>
        <converter:FirstImagePathConverter x:Key="FirstImagePathConverter" />
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    </UserControl.Resources>
    <Grid 
              Width="820"
              Margin="0 0 0 30">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock
                   Grid.Row="0" 
                   Text="Your renovations" 
                   FontSize="36" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        <ListView BorderThickness="0" 
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Grid.Row="1"
                      ScrollViewer.CanContentScroll="False" ItemsSource="{Binding Renovations}" SelectedItem="{Binding SelectedRenovation}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" 
                                BorderThickness="3" 
                                CornerRadius="10"
                                Width="780">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="240"/>
                            </Grid.ColumnDefinitions>
                            <Image  Source="{Binding ImagesPath, Converter={StaticResource FirstImagePathConverter}}" 
                                       Width="100" 
                                       Height="100" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"                                      
                                       Grid.RowSpan="2"/>
                            <TextBlock Text="{Binding Name}" 
                                           Grid.Column="1" 
                                           FontSize="24" 
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Location}" 
                                           Grid.Column="1"
                                           Grid.Row="1"
                                           FontSize="20"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            <Grid x:Name="StarGrid" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Source="{Binding Star1}" 
                                           Width="24" 
                                           Height="24" 
                                           Grid.Column="0"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                                <Image  Source="{Binding Star2}" 
                                           Width="24" 
                                           Height="24" 
                                           Grid.Column="1"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                                <Image  Source="{Binding Star3}" 
                                           Width="24" 
                                           Height="24" 
                                           Grid.Column="2"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                                <Image  Source="{Binding Star4}" 
                                           Width="22" 
                                           Height="22" 
                                           Grid.Column="3"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                                <Image  Source="{Binding Star4}" 
                                           Width="22" 
                                           Height="22" 
                                           Grid.Column="4"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding Type}" 
                                           Grid.Column="2"
                                           Grid.Row="1"
                                           FontSize="20"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            <Image Source="C:\Users\lukai\Desktop\Resource\chat.png" 
                                       Width="24" 
                                       Height="24" 
                                       Grid.Row="0"
                                       Grid.Column="3"
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="4" Grid.RowSpan="2" BorderThickness="3" BorderBrush="Black" Padding="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Renovations from :" FontSize="17" Width="auto"/>
                                    <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding RenovationFrom,StringFormat='dd.MM.yyyy'}" FontSize="17" Width="auto" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Renovations to :" FontSize="17" Width="auto"/>
                                    <TextBlock Grid.Row="1"  Grid.Column="1" Text="{Binding RenovationTo,StringFormat='dd.MM.yyyy'}" FontSize="17" Width="auto" HorizontalAlignment="Center"/>
                                    <Button Grid.Column="0"
                                    FontSize="20" 
                                    Background="Transparent"
                                    VerticalAlignment="Center"
                                    Grid.ColumnSpan="2"
                                    BorderThickness="0" Grid.Row="2" HorizontalAlignment="Center" Margin="0 0 0 0"  Command="{Binding DataContext.CancelRenovationCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" IsEnabled="{Binding IsCancelable}">
                                        <Border  BorderBrush="DarkRed"
                                             BorderThickness="3"
                                             CornerRadius="10"
                                             Width="auto">
                                            <StackPanel  Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image  Source="C:\Users\lukai\Desktop\Resource\X.png" 
                                               Width="24" 
                                               Height="24"
                                               Margin="10 0 5 0"/>
                                                <TextBlock  Text="Cancel renovations" Margin="0 0 10 0" Foreground="DarkRed" FontWeight="Bold" FontSize="17"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
