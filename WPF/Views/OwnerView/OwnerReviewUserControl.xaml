<UserControl x:Class="BookingApp.WPF.Views.OwnerView.OwnerReviewUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.OwnerView"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="572" d:DesignWidth="1108">
    <Grid Margin="0 0 0 40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Reviews" FontSize="40" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Border Grid.Column="0" Grid.Row="1" BorderThickness="3" BorderBrush="Black" Width="400">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="90"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Unrated guests" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 10 0 10"/>
                <ListView BorderThickness="0" 
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Grid.Row="1"       
                      ScrollViewer.CanContentScroll="False" Width="400"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden" Margin="10 0 10 0" ItemsSource="{Binding UnratedGuests}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Black" 
                                BorderThickness="3" 
                                CornerRadius="10"
                                    Width="360"
                                    Height="70" Margin="0 0 0 20">
                                <Grid Margin="15" >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="C:\Users\lukai\Desktop\Resource\profilna.png" Width="32" Height="32" HorizontalAlignment="Left"></Image>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="28" HorizontalAlignment="Left" Margin="20 0 0 0"></TextBlock>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <ContentPresenter HorizontalAlignment="Left" Margin="2,3,2,3" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
                <Button Grid.Column="0"
                FontSize="20" 
                FontWeight="Bold"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0" Grid.Row="2" HorizontalAlignment="Center" Height="50" Click="RateGuest">
                    <Border  BorderBrush="#FFAF45"
                                             BorderThickness="3"
                                             CornerRadius="10"  
                            
                                             Width="140" >
                        <StackPanel  Orientation="Horizontal">
                            <Image  Source="C:\Users\lukai\Desktop\Resource\star.png" 
                                               Width="24" 
                                               Height="24"
                                               Margin="10 0 5 0"/>
                            <TextBlock  Text="Rate" Margin="5 0 0 5" Foreground="#FFC374" FontSize="32" VerticalAlignment="Center" FontWeight="Normal"/>
                        </StackPanel>
                    </Border>
                </Button>
            </Grid>
        </Border>



        <Border Grid.Column="1" Grid.Row="1" BorderThickness="3" BorderBrush="Black" Width="400">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="90"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Your rating" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 10 0 10"/>
                <Border BorderBrush="Black" BorderThickness="2" Grid.Row="1" Width="300"  CornerRadius="13" Height="70">
                    <Grid Margin="20 0 20 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="Stars" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="C:\Users\lukai\Desktop\Resource\StarFull.png" 
                                           Width="24" 
                                           Height="24" 
                                           Grid.Column="0"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            <Image Source="C:\Users\lukai\Desktop\Resource\StarHalfFull.png" 
                                           Width="24" 
                                           Height="24" 
                                           Grid.Column="1"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            <Image Source="C:\Users\lukai\Desktop\Resource\idemo.png" 
                                           Width="24" 
                                           Height="24" 
                                           Grid.Column="2"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            <Image Source="C:\Users\lukai\Desktop\Resource\idemo.png" 
                                           Width="22" 
                                           Height="22" 
                                           Grid.Column="3"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            <Image Source="C:\Users\lukai\Desktop\Resource\idemo.png" 
                                           Width="22" 
                                           Height="22" 
                                           Grid.Column="4"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="3.5" Grid.Column="1" VerticalAlignment="Center" Margin="15 0 0 0" HorizontalAlignment="Left" FontSize="20"/>
                        <TextBlock Text="of 5" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="20"/>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="2" Text="100 guest reviews" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="17"/>
                <Grid Grid.Row="3" Margin="25 0 25 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="5 stars" FontSize="17" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Text="4 stars" FontSize="17" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Text="3 stars" FontSize="17" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Text="2 stars" FontSize="17" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="4" Text="1 star" FontSize="17"  VerticalAlignment="Center"/>
                    <ProgressBar Grid.Column="1"  Grid.Row="0" Height="20" VerticalAlignment="Center" Width="230">
                    </ProgressBar>
                    <ProgressBar Grid.Column="1"  Grid.Row="1" Height="20" VerticalAlignment="Center" Width="230">
                    </ProgressBar>
                    <ProgressBar Grid.Column="1"  Grid.Row="2" Height="20" VerticalAlignment="Center" Width="230">
                    </ProgressBar>
                    <ProgressBar Grid.Column="1"  Grid.Row="3" Height="20" VerticalAlignment="Center" Width="230">
                    </ProgressBar>
                    <ProgressBar Grid.Column="1"  Grid.Row="4" Height="20" VerticalAlignment="Center" Width="230">
                    </ProgressBar>
                </Grid>
                <Button Grid.Column="0"
                FontSize="20" 
                FontWeight="Bold"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0" Grid.Row="4" HorizontalAlignment="Center" Height="50" Click="OwnerRates">
                    <Border  BorderBrush="#124076"
                                             BorderThickness="3"
                                             CornerRadius="10"  
                            
                                             Width="140" >
                        <StackPanel  Orientation="Horizontal">
                            <Image  Source="C:\Users\lukai\Desktop\Resource\more1.png" 
                                               Width="30" 
                                               Height="30"
                                               Margin="10 0 0 0"/>
                            <TextBlock  Text="More" Margin="5 0 0 5" Foreground="#124076" FontSize="32" VerticalAlignment="Center" FontWeight="Normal"/>
                        </StackPanel>
                    </Border>
                </Button>
            </Grid>
        </Border>


    </Grid>
</UserControl>
