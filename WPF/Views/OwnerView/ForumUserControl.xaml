<UserControl x:Class="BookingApp.WPF.Views.OwnerView.ForumUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.OwnerView"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             xmlns:converter="clr-namespace:BookingApp.WPF.Converters"
              d:DesignHeight="572" d:DesignWidth="1108">
    <UserControl.Resources>
        <converter:DateConverter x:Key="DateConverter" />
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid 
              Width="900"
              Margin="0 0 0 30">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock
                   Grid.Row="0" 
                   Text="Forum"
                   Foreground="#FBA834"
                   FontSize="40" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        <ListView BorderThickness="0" 
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Grid.Row="1"
                      ScrollViewer.CanContentScroll="False"
                      ItemsSource="{Binding Forums}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" 
                                BorderThickness="3" 
                                CornerRadius="10"
                                Width="860" Margin="0 0 0 15">
                        <Grid Margin="10" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}" Foreground="#124076" Grid.Column="0" FontSize="28" FontWeight="Bold"/>
                                <Image Source="{Binding SuperForum}" Visibility="{Binding IsSuperForum,Converter={StaticResource BoolToVisibilityConverter}}" Grid.Column="1" Height="20" Margin="0 -5 0 0"/>
                            </Grid>
                            <Image  Source="C:\Users\lukai\Desktop\Resource\Location.png" 
                                               Width="28" 
                                               Height="28"
                                               Grid.Column="1" 
                                               HorizontalAlignment="Left" 
                                               VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Location}" Grid.Column="1" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DateCreated, Converter={StaticResource DateConverter}}" Grid.Column="2" FontSize="17" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Description}" Grid.ColumnSpan="2" Grid.Column="0" Grid.Row="1" FontSize="18" VerticalAlignment="Center"/>
                            <Image Grid.Column="2" Grid.Row="1" Source="C:\Users\lukai\Desktop\Resource\chat.png" Height="32" Width="32" HorizontalAlignment="Right" />
                            <Button Grid.Column="3"
                                    FontSize="20" 
                                    Background="Transparent"
                                    Height="70"
                                    VerticalAlignment="Center"
                                    Grid.RowSpan="2"
                                    BorderThickness="0" Grid.Row="0" HorizontalAlignment="Center" Margin="20 0 0 0"  Command="{Binding DataContext.ReadMoreCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" CommandParameter="{Binding}">
                                <Border  BorderBrush="#333A73"
                                             BorderThickness="3"
                                             CornerRadius="10"
                                             Height="68"
                                             Width="110">
                                    <StackPanel  Orientation="Horizontal" VerticalAlignment="Center">
                                        <Image  Source="C:\Users\lukai\Desktop\Resource\book.png" 
                                               Width="32" 
                                               Height="32"
                                               Margin="10 0 5 0" />
                                        <TextBlock Margin="0 2 0 0" Foreground="#333A73" FontWeight="Normal"><Run Text="Read"/><LineBreak/><Run Text="more"/></TextBlock>
                                    </StackPanel>
                                </Border>
                            </Button>

                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
