<UserControl x:Class="BookingApp.WPF.Views.OwnerView.OwnerMainWindowUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:BookingApp.WPF.Views.OwnerView"
             xmlns:converter="clr-namespace:BookingApp.WPF.Converters"
             mc:Ignorable="d" 
            d:DesignHeight="572" d:DesignWidth="1108">
    <UserControl.Resources>
        <converter:FirstImagePathConverter x:Key="FirstImagePathConverter" />
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    </UserControl.Resources>
    <Grid 
              Width="920"
              Margin="0 0 0 30">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock
                   Grid.Row="0" 
                   Text="Your accommodations" 
                   FontSize="36" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        <ListView BorderThickness="0" 
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Grid.Row="1"
                      ScrollViewer.CanContentScroll="False" ItemsSource="{Binding Accommodations}" SelectedItem="{Binding SelectedAccommodation}">
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <ContentPresenter HorizontalAlignment="Left" Margin="2,3,2,3" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" 
                                BorderThickness="3" 
                                CornerRadius="10"
                            Height="150"
                                Width="880">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition MinWidth="50" Width="auto"/>
                                <ColumnDefinition MinWidth="200" Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="Black" BorderThickness="2" CornerRadius="3" Height="110">
                                <Image Source="{Binding ImagesPath, Converter={StaticResource FirstImagePathConverter}}" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"                                     
                                        Stretch="Fill"/>
                            </Border>
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}"
                                           Margin="15 -5 0 0"
                                           Grid.Column="0" 
                                           FontSize="24" 
                                           FontWeight="Bold"
                                           VerticalAlignment="Top"
                                           HorizontalAlignment="Left"/>
                                    <Image Source="C:\Users\lukai\Desktop\Resource\verified.png" 
                                           Width="24" 
                                           Visibility="{Binding IsSuperOwner, Converter={StaticResource BoolToVisibilityConverter}}"
                                           Height="24"
                                           Margin="10 0 0 0"
                                           Grid.Column="1"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Top"/>
                                </Grid>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid x:Name="StarGrid" Grid.Column="0" Margin="10 0 0 0"  HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Star1}"
                                           Width="24" 
                                           Height="24" 
                                           Grid.Column="0"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                                        <Image Source="{Binding Star2}"
                                           Width="24" 
                                           Height="24" 
                                           Grid.Column="1"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                                        <Image Source="{Binding Star3}"
                                           Width="24" 
                                           Height="24" 
                                           Grid.Column="2"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                                        <Image Source="{Binding Star4}"
                                           Width="22" 
                                           Height="22" 
                                           Grid.Column="3"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                                        <Image Source="{Binding Star5}"
                                           Width="22" 
                                           Height="22" 
                                           Grid.Column="4"
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock FontSize="12" 
                                               Grid.Column="1" 
                                               Margin="7 0 0 4" VerticalAlignment="Center"> 
                                               <Run Text="{Binding NumberOfRatings}"/> 
                                               <Run Text="review(s)"/>
                                    </TextBlock>
                                </Grid>
                                <Grid Grid.Row="2" VerticalAlignment="Bottom">
                                    <Grid   Margin="10 0 0 0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="C:\Users\lukai\Desktop\Resource\location.png" 
                                       Height="28" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"                                      
                                       Margin="0 -10 0 0"/>
                                        <TextBlock Text="{Binding Location}" 
                                           Grid.Column="1"
                                           FontSize="20"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Type}" 
                                           FontSize="20"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                                </Grid>
                            </Grid>
                            <Image Source="C:\Users\lukai\Desktop\Resource\chat.png" 
                                       Width="24" 
                                       Height="24" 
                                       Grid.Row="0"
                                       Grid.Column="2" 
                                   Margin="0 5 0 0"
                                       HorizontalAlignment="Right" 
                                       VerticalAlignment="Top"/>
                            <Button Grid.Column="3"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        VerticalAlignment="Top"
                                        Background="Transparent"
                                        BorderThickness="0" 
                                        Margin="0 -2 0 0"
                                        Width="142"
                                        Height="38"
                                    Command="{Binding DataContext.RenovateCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" CommandParameter="{Binding DataContext.SelectedAccommodation, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}">
                                <Border  BorderBrush="Black"
                                             BorderThickness="2"
                                             CornerRadius="8"
                                            Height="36"
                                             Width="140">
                                    <StackPanel  Orientation="Horizontal">
                                        <Image  Source="C:\Users\lukai\Desktop\Resource\hammer.png" 
                                               Width="24" 
                                               Height="24"
                                               Margin="5 0 10 0"/>
                                        <TextBlock  Text="Renovate" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                            <Button Grid.Column="3"
                                        Grid.Row="1"
                                        Background="Transparent" 
                                        FontSize="20" 
                                        Width="142"
                                        Height="38"
                                        Margin="0 0 0 -2"
                                        FontWeight="Bold"
                                        BorderThickness="0"
                                        VerticalAlignment="Bottom" Click="ShowStats">
                                <Border BorderBrush="Black" 
                                            BorderThickness="2" 
                                            CornerRadius="8" 
                                            Height="36"
                                            Width="140">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="C:\Users\lukai\Desktop\Resource\stats.png" 
                                               Width="24" 
                                               Height="24"
                                               Margin="5 0 5 0"/>
                                        <TextBlock Text="Show stats" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
