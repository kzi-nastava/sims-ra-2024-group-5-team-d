<UserControl x:Class="BookingApp.WPF.Views.OwnerView.OwnerNotificationsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:BookingApp.WPF.Views.OwnerView"
             mc:Ignorable="d" 
             xmlns:converter="clr-namespace:BookingApp.WPF.Converters"
             d:DesignHeight="572" d:DesignWidth="1108">
    <UserControl.Resources>
        <converter:FirstImagePathConverter x:Key="FirstImagePathConverter" />
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    </UserControl.Resources>
    <Grid 
              Width="920"
              Margin="0 0 0 30">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock
                   Grid.Row="0" 
                   Text="Notifications" 
                   FontSize="36" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
        <ListView BorderThickness="0" 
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Grid.Row="1"
                  HorizontalAlignment="Center"
                      ScrollViewer.CanContentScroll="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                <ContentPresenter HorizontalAlignment="Left" Margin="2,3,2,3" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="2" Padding="10" CornerRadius="10" Margin="0 0 20 10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="500"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="C:\Users\lukai\Desktop\Resource\dot.png" Width="30" Margin="0 0 15 0"/>
                            <Image Source="C:\Users\lukai\Desktop\Resource\profile.png" Width="70" Grid.Column="1"/>
                            <Grid Grid.Column="2" Margin="15 0 0 0" Width="auto">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Luka Ivanisevic" FontWeight="DemiBold" Grid.Row="0" VerticalAlignment="Top" Width="auto" FontSize="20"/>
                                    <TextBlock Grid.Column="1" Text="1.1.2002." VerticalAlignment="Center" Margin="10 -7 0 0"/>
                                </Grid>
                                <TextBlock Text="You didnt rate this guest" FontWeight="Normal" Grid.Row="1" FontSize="16"/>
                            </Grid>
                            <Image Source="C:\Users\lukai\Desktop\Resource\enter.png" Grid.Column="3" Width="50" Margin="0 0 20 0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemsSource>
                <x:Array Type="{x:Type sys:String}">
                    <sys:String>Ala</sys:String>
                    <sys:String>Bela</sys:String>
                    <sys:String>Ceca</sys:String>
                    <sys:String>Veca</sys:String>
                </x:Array>
            </ListView.ItemsSource>
        </ListView>
    </Grid>
</UserControl>
