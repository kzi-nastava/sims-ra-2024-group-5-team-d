<UserControl x:Class="BookingApp.WPF.Views.OwnerView.ForumReadMoreUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.OwnerView"
             mc:Ignorable="d" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:converter="clr-namespace:BookingApp.WPF.Converters"
             d:DesignHeight="572" d:DesignWidth="1108">
    <UserControl.Resources>
        <converter:DateConverter x:Key="DateConverter" />
        <converter:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0 0 0 30" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="830"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="0.7*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Forum.Title}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Grid.Row="0" Margin="15 0 0 0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20">
            <Run Text="{Binding Forum.DateCreated, Converter={StaticResource DateConverter}}" />
            <Run Text=" days ago"/>
            </TextBlock>
            <Grid HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image  Source="C:\Users\lukai\Desktop\Resource\Location.png" 
                                               Width="32" 
                                               Height="32"
                                               Grid.Column="0" 
                                               HorizontalAlignment="Left" 
                                               VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Forum.Location}" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="1"/>
            </Grid>
            <Border BorderThickness="3" BorderBrush="Black" Grid.Row="1">
                <TextBlock Text="{Binding Forum.Description}" Padding="10" FontSize="18"  MinHeight="220" TextWrapping="WrapWithOverflow"/>
            </Border>
            <Grid HorizontalAlignment="Left" Grid.Row="2" Margin="0 5 0 5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Label Content="5" HorizontalAlignment="Right" Grid.Column="1" VerticalAlignment="Top" Margin="0 0 10 0" Padding="0" FontSize="16"/>
                <TextBlock Text="Comments" FontSize="24" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0"/>
                <Image Grid.Column="1"  
                   Source="C:\Users\lukai\Desktop\Resource\chat.png" 
                   Height="32" 
                   Width="32" 
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Margin="20 0 20 0"
                   Grid.Row="1"/>
                <Button Grid.Column="2" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Command="{Binding AddCommentCommand}">
                    <Image Source="C:\Users\lukai\Desktop\Resource\plusgreat.png" Height="40" Width="40"/>
                </Button>
            </Grid>
            <Grid Grid.Row="3" Visibility="{Binding AddForumCommentViewModel.IsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Image  Source="{Binding AddForumCommentViewModel.AvatarPath}"
                                               Width="32" 
                                               Height="32"
                                               Grid.Column="0" 
                                               HorizontalAlignment="Left" 
                                               VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding AddForumCommentViewModel.Comment}" BorderThickness="0 0 0 5" FontSize="20" HorizontalAlignment="Left" VerticalAlignment="Center" Width="700" Height="40" Margin="10 0 0 0">
                </TextBox>
                <Border BorderBrush="DimGray" BorderThickness="2" CornerRadius="10" Grid.Column="2" Margin="20 0 0 0">
                    <Button Grid.Column="2" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Command="{Binding CommentCommand}">
                        <TextBlock Text="Comment"/>
                    </Button>
                </Border>
            </Grid>
            <ListView BorderThickness="0"
                  Grid.RowSpan="2"
                  Name="YourListView"
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      ScrollViewer.CanContentScroll="False"
                      PreviewMouseWheel="ListView_PreviewMouseWheel"
                      Grid.Row="4"
                      ItemsSource="{Binding Comments}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <ContentPresenter HorizontalAlignment="Stretch" Margin="2,3,2,3" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border  BorderBrush="Black" BorderThickness="3" Padding="5" Margin="0 0 0 5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Text="{Binding CreatorFullName}" FontSize="20"/>
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="auto"/>
                                                <ColumnDefinition Width="auto "/>
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0"  
                   Source="C:\Users\lukai\Desktop\Resource\home.png" 
                   Height="24" 
                   Width="24" 
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Margin="20 0 5 0"
                   Grid.Row="1"/>
                                            <TextBlock Text="(has a property on location)" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding Comment}" TextWrapping="WrapWithOverflow" FontSize="18" MaxWidth="700"/>

                                </Grid>
                                <Image Grid.Column="1"  
                   Source="C:\Users\lukai\Desktop\Resource\flag.png" 
                   Height="24" 
                   Width="24" 
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   Margin="20 0 20 0"
                   Grid.Row="1"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </ScrollViewer>
</UserControl>
