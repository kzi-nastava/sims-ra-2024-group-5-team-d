                                   Grid.Column="1"
                                   Grid.ColumnSpan="2"
                                   HorizontalAlignment="Center"
                                   FontSize="13" 
                                   FontWeight="Bold"
                                   VerticalAlignment="Top"/>
                                    <Label Content="New date time" 
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top" 
                                   Grid.Column="1"
                                   FontSize="9"
                                   Grid.Row="1"
                                   Width="74"
                                   Height="21" 
                                   Margin="22,1,0,0"/>
                                    <Label Content="From:" 
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top" 
                                   Grid.Column="1"
                                   Grid.Row="1"
                                   Height="21" 
                                   Width="92"
                                   FontSize="9" 
                                   Margin="22,15,0,0" 
                                   Grid.RowSpan="2"/>
                                    <Label Content="15/4/2024" 
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top" 
                                   Grid.Column="1"
                                   Grid.Row="1"
                                   Height="21" 
                                   Width="92"
                                   FontSize="9" 
                                   Margin="53,15,0,0" 
                                   Grid.RowSpan="2"/>
                                    <Label Content="To:" 
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top" 
                                   Grid.Column="1"
                                   Grid.Row="1"
                                   Height="21" 
                                   Width="92"
                                   FontSize="9" 
                                   Margin="114,15,0,0" 
                                   Grid.RowSpan="2"/>
