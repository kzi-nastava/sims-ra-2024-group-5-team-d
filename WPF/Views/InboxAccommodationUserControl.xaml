                                            Grid.Row="2" 
                                            VerticalAlignment="Top" 
                                            HorizontalAlignment="Left"
                                            Margin="14,28,0,0" 
                                            Grid.Column="1"
                                            FontSize="8" 
                                            Grid.ColumnSpan="2" 
                                            Width="280" 
                                            Height="26" 
                                            Grid.RowSpan="3"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemsSource>
                        <x:Array Type="{x:Type sys:String}">
                            <sys:String>Alla mia donna</sys:String>
                            <sys:String>Bella signorina</sys:String>
                            <sys:String>Ceca i deca</sys:String>
                            <sys:String>Veca koliba</sys:String>
                            <sys:String>Jeca i Ceca</sys:String>
                            <sys:String>Nikijeva odaja</sys:String>
