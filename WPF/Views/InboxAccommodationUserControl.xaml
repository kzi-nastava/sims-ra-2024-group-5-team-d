                                          FontSize="9" 
                                          HorizontalContentAlignment="Center" 
                                          VerticalContentAlignment="Center"/>
                                    <Border BorderThickness="2,2,2,2" 
                                           BorderBrush="Black"
                                           Grid.Column="1"
                                           Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Grid.RowSpan="3" Margin="10,25,2,-5" Height="34"/>
