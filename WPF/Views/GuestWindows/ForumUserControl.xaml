<UserControl x:Class="BookingApp.WPF.Views.GuestWindows.ForumUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.GuestWindows" xmlns:local1="clr-namespace:BookingApp.WPF.Converters" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="420">
    <UserControl.Resources>
        <local1:FirstImagePathConverter x:Key="FirstImagePathConverter"/>
        <local1:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Column="0" 
                    Grid.Row="0" 
                    Grid.ColumnSpan="4"
                    Background="{StaticResource PrimaryBlack3}">
            <TabItem Width="200"
                 Background="{StaticResource PrimaryBlack3}">
                <TabItem.Header>
                    <Border Background="{StaticResource PrimaryBlack3}">
                        <Border BorderBrush="{StaticResource PrimaryColor}" 
                        BorderThickness="3" 
                        CornerRadius="10"
                        Background="{StaticResource PrimaryColor2}"
                        Width="90">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="All forums" 
                               Padding="5"
                               Foreground="{StaticResource WhiteWhite}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </TabItem.Header>
                <ScrollViewer>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Margin="45,20,45,20"
                                  Grid.Row="0"
                                  Height="360">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="300"
                                    Height="330"
                                    BorderThickness="4" 
                                    CornerRadius="15"
                                    BorderBrush="{StaticResource PrimaryColor}"
                                    VerticalAlignment="Top"
                                    HorizontalAlignment="Center" 
                                    Grid.Column="0"
                                    Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    Grid.RowSpan="5"
                                    Background="{StaticResource PrimaryBlack}"/>


                            <Image Source="../../../Resources/Images/GuestImages/search.png"
                                    Width="24" 
                                    VerticalAlignment="Center"
                                    Height="18" Margin="34,0,99,0"/>
                            <Label Content="Location"
                                    Grid.Row="0"
                                    Height="24"
                                    Foreground="{StaticResource WhiteGrey}" 
                                    Margin="57,0,0,0" 
                                    Width="NaN" 
                                    HorizontalAlignment="Left"/>
                            <ComboBox 
                                   x:Name="locationTextBox" 
                                   IsReadOnly="True"
                                   Grid.Row="0" Margin="120,0,25,0" 
                                   SelectedIndex="{Binding LocationId, UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="2" Width="160" Height="30">
                                                            <ComboBoxItem Content="Serbia, Novi Sad"/>
                                                            <ComboBoxItem Content="Serbia, Beograd"/>
                                                            <ComboBoxItem Content="Serbia, Smederevo"/>
                                                            <ComboBoxItem Content="Serbia, Požega"/>
                                                            <ComboBoxItem Content="Serbia, Kragujevac"/>
                                                            <ComboBoxItem Content="Serbia, Niš"/>
                                                            <ComboBoxItem Content="Serbia, Subotica"/>
                                                            <ComboBoxItem Content="Serbia, Pančevo"/>
                                                            <ComboBoxItem Content="Serbia, Čačak"/>
                                                            <ComboBoxItem Content="Serbia, Užice"/>
                                                            <ComboBoxItem Content="Any"/>
                             </ComboBox>
                            <Border 
                                 BorderBrush="{StaticResource PrimaryColor}"
                                 Grid.Column="0"
                                 Grid.Row="0"
                                 Grid.ColumnSpan="2"
                                 VerticalAlignment="Bottom" 
                                 BorderThickness="0,0,0,2"/>

                            <Label Content="Title" 
                                    Grid.Row="1"
                                    HorizontalAlignment="Left"
                                    Foreground="{StaticResource WhiteGrey}" 
                                    VerticalAlignment="Center" Margin="55,0,0,0"/>
                            <TextBox Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Grid.Row="1"
                                    Height="30"
                                    Width="200"
                                    Text="{Binding Title}"
                                    Margin="92,0,0,0"
                                    TextWrapping="Wrap"
                                    FlowDirection="LeftToRight" 
                                    HorizontalAlignment="Left" 
                                    VerticalAlignment="Center"/>
                            <Border BorderThickness="0,0,0,2" 
                                     BorderBrush="{StaticResource PrimaryColor}"
                                     Grid.Column="0"
                                     Grid.Row="1"
                                     Grid.ColumnSpan="2"
                                     VerticalAlignment="Bottom">
                            </Border>

                            <Label Content="Comment" 
                                    Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    Foreground="{StaticResource WhiteGrey}" 
                                   VerticalAlignment="Bottom" 
                                   HorizontalContentAlignment="Center" 
                                   VerticalContentAlignment="Center"
                                   Margin="0,0,0,-15"/>
                            <TextBox Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Grid.Row="3"
                                    Height="90" 
                                    Text="{Binding Comment}"
                                    Margin="15,0,15,0"
                                    TextWrapping="Wrap"
                                    FlowDirection="LeftToRight" 
                                    VerticalAlignment="Center"/>
                            <Border BorderThickness="0,0,0,2" 
                                     BorderBrush="{StaticResource PrimaryColor}"
                                     Grid.Column="0"
                                     Grid.Row="3"
                                     Grid.ColumnSpan="2"
                                     VerticalAlignment="Bottom">
                            </Border>

                            <Button Grid.Row="4"
                                       FontSize="20" 
                                       Background="Transparent"
                                       Height="33"
                                       Width="auto"
                                       Cursor="Hand"
                                       VerticalAlignment="Center"
                                       BorderThickness="0" 
                                       HorizontalAlignment="Center"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                       Command="{Binding CreateForumCommand}">
                                <Border  Background="DarkOrange"
                                        CornerRadius="2"
                                        Height="25" 
                                        Width="auto">
                                    <TextBlock  Text="Create forum"
                                       Margin="20 0 20 0" 
                                       Foreground="{StaticResource  WhiteGrey}" 
                                       FontWeight="Bold" 
                                       FontSize="14" 
                                       HorizontalAlignment="Center" 
                                       VerticalAlignment="Center"/>
                                </Border>
                            </Button>

                        </Grid>

                        <ListView BorderThickness="0" 
                                     Background="{StaticResource PrimaryBlack3}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Grid.Row="1"
                                     ScrollViewer.CanContentScroll="False"
                                     ItemsSource="{Binding Forums}"
                                     SelectedItem="{Binding SelectedForum}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource PrimaryColor}"
                                     Background="{StaticResource PrimaryColor2}"
                                     BorderThickness="2" 
                                     CornerRadius="10"
                                     Width="380"
                                     Height="auto">
                                        <Grid Margin="10,10,10,5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Label  Content="{Binding Title}"
                                                   Width="auto" 
                                                   Height="auto" 
                                                   VerticalAlignment="Top" 
                                                   HorizontalAlignment="Center" 
                                                   Grid.Column="0"
                                                   Grid.Row="0"
                                                   FontSize="16" 
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource WhiteWhite}"/>
                                            <Label Content="IME PREZIME" 
                                                   Grid.Row="1"
                                                   HorizontalAlignment="Left"
                                                   FontSize="13" 
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Top"
                                                   Foreground="{StaticResource WhiteWhite}"/>
                                            <Label Content="{Binding Location}" 
                                                   Grid.Row="1"
                                                   HorizontalAlignment="Right"
                                                   FontSize="11" 
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Top"
                                                   Foreground="{StaticResource WhiteWhite}"/>
                                            <Border
                                                    Grid.Row="2"
                                                    BorderBrush="{StaticResource PrimaryColor}"
                                                    Background="{StaticResource PrimaryBlack}"
                                                    BorderThickness="2"
                                                    Height="auto"
                                                    Width="300"
                                                    Margin="30,0,0,0">
                                                <TextBlock Text="{Binding Description}" 
                                                    HorizontalAlignment="Left"
                                                    FontSize="10"
                                                    TextWrapping="Wrap"
                                                    Margin="5"
                                                    Foreground="{StaticResource WhiteWhite}"/>
                                            </Border>
                                            <Button Content="See all comments" 
                                                       Grid.Row="3"
                                                       HorizontalAlignment="Right"
                                                       FontSize="11" 
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Top"
                                                       Background="Transparent"
                                                       Command="{Binding DataContext.OpenMoreCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" CommandParameter="{Binding}"
                                                       Foreground="DarkOrange" />
                                            <Button Grid.Row="4"
                                                   FontSize="20" 
                                                   Background="Transparent"
                                                   Height="33"
                                                   Width="auto"
                                                   Cursor="Hand"
                                                   VerticalAlignment="Center"
                                                   BorderThickness="0" 
                                                   Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   HorizontalAlignment="Center"
                                                   Grid.Column="0"
                                                   Grid.ColumnSpan="2"
                                                   Command="{Binding DataContext.CloseForumCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                   CommandParameter="{Binding}">
                                                <Border  Background="DarkOrange"
                                                     CornerRadius="2"
                                                     Height="25" 
                                                     Width="auto">
                                                    <TextBlock  Text="Close forum"
                                                       Margin="20 0 20 0" 
                                                       Foreground="{StaticResource  WhiteGrey}" 
                                                       FontWeight="Bold" 
                                                       FontSize="14" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Width="200"
                 Background="{StaticResource PrimaryBlack3}">
                <TabItem.Header>
                    <Border Background="{StaticResource PrimaryBlack3}">
                        <Border BorderBrush="{StaticResource PrimaryColor}" 
                             BorderThickness="3" 
                             CornerRadius="10"
                             Background="{StaticResource PrimaryColor2}"
                             Width="90">
                            <TextBlock Text="My forums" 
                            Padding="5"
                            Foreground="{StaticResource WhiteWhite}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                </TabItem.Header>
                <ScrollViewer>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ListView BorderThickness="0" 
                                   Background="{StaticResource PrimaryBlack3}"
                                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                   Grid.Row="1"
                                   ScrollViewer.CanContentScroll="False"
                                   ItemsSource="{Binding MyForums}"
                                   SelectedItem="{Binding SelectedForum}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource PrimaryColor}"
                                           Background="{StaticResource PrimaryColor2}"
                                           BorderThickness="2" 
                                           CornerRadius="10"
                                           Width="380"
                                           Height="auto">
                                        <Grid Margin="10,10,10,5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Label  Content="{Binding Title}"
                                                         Width="auto" 
                                                         Height="auto" 
                                                         VerticalAlignment="Top" 
                                                         HorizontalAlignment="Center" 
                                                         Grid.Column="0"
                                                         Grid.Row="0"
                                                         FontSize="16" 
                                                         FontWeight="Bold"
                                                         Foreground="{StaticResource WhiteWhite}"/>
                                            <Label Content="IME PREZIME" 
                                                         Grid.Row="1"
                                                         HorizontalAlignment="Left"
                                                         FontSize="13" 
                                                         FontWeight="Bold"
                                                         VerticalAlignment="Top"
                                                         Foreground="{StaticResource WhiteWhite}"/>
                                            <Label Content="{Binding Location}" 
                                                         Grid.Row="1"
                                                         HorizontalAlignment="Right"
                                                         FontSize="11" 
                                                         FontWeight="Bold"
                                                         VerticalAlignment="Top"
                                                         Foreground="{StaticResource WhiteWhite}"/>
                                            <Border
                                                          Grid.Row="2"
                                                          BorderBrush="{StaticResource PrimaryColor}"
                                                          Background="{StaticResource PrimaryBlack}"
                                                          BorderThickness="2"
                                                          Height="auto"
                                                          Width="300"
                                                          Margin="30,0,0,0">
                                                <TextBlock Text="{Binding Description}" 
                                                          HorizontalAlignment="Left"
                                                          FontSize="10"
                                                          TextWrapping="Wrap"
                                                          Margin="5"
                                                          Foreground="{StaticResource WhiteWhite}"/>
                                            </Border>
                                            <Button Content="See all comments" 
                                                         Grid.Row="3"
                                                         HorizontalAlignment="Right"
                                                         FontSize="11" 
                                                         FontWeight="Bold"
                                                         VerticalAlignment="Top"
                                                         Background="Transparent"
                                                         Command="{Binding DataContext.OpenMoreCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" CommandParameter="{Binding}"
                                                         Foreground="DarkOrange" />
                                            <Button Grid.Row="4"
                                                     FontSize="20" 
                                                     Background="Transparent"
                                                     Height="33"
                                                     Width="auto"
                                                     Cursor="Hand"
                                                     VerticalAlignment="Center"
                                                     BorderThickness="0" 
                                                     Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                     HorizontalAlignment="Center"
                                                     Grid.Column="0"
                                                     Grid.ColumnSpan="2"
                                                     Command="{Binding DataContext.CloseForumCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                     CommandParameter="{Binding}">
                                                <Border  Background="DarkOrange"
                                                       CornerRadius="2"
                                                       Height="25" 
                                                       Width="auto">
                                                    <TextBlock  Text="Close forum"
                                                         Margin="20 0 20 0" 
                                                         Foreground="{StaticResource  WhiteGrey}" 
                                                         FontWeight="Bold" 
                                                         FontSize="14" 
                                                         HorizontalAlignment="Center" 
                                                         VerticalAlignment="Center"/>
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
