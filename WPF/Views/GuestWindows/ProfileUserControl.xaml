<UserControl x:Class="BookingApp.WPF.Views.GuestWindows.ProfileUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.GuestWindows"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="430">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Super quest" 
     HorizontalAlignment="Center"
     VerticalAlignment="Center" 
     Grid.Column="0" 
     Grid.Row="0"
     FontWeight="Bold"
     Height="auto" 
     Width="auto"
     FontSize="20"
     Margin="0,30,0,0"/>
        <Label Content="Number of reservation this year" 
     HorizontalAlignment="Center"
     VerticalAlignment="Center" 
     Grid.Column="0" 
     Grid.Row="1"
     Height="auto" 
     Width="auto"
     FontSize="14" Margin="0,30,0,0"/>
        <Rectangle Width="70"
    Height="50"
    Stroke="Black"
    StrokeThickness="2"
    VerticalAlignment="Center"
    HorizontalAlignment="Center" 
    Margin="0,15,0,15"
    Grid.Column="0"
    Grid.Row="2"/>
        <Label Content="Bonus points" 
     HorizontalAlignment="Center"
     VerticalAlignment="Center" 
     Grid.Column="0" 
     Grid.Row="3"
     Height="auto" 
     Width="auto"
     FontSize="14" Margin="0,30,0,0"/>

        <Image Source="../../../Resources/Images/GuestImages/StarIcon.png"
    Grid.Column="0" 
    Grid.Row="4"
    Width="26" 
    HorizontalAlignment="Left" 
    VerticalAlignment="Center" Margin="121,20,0,0" />
        <Image Source="../../../Resources/Images/GuestImages/StarIcon.png"
    Grid.Column="0" 
    Grid.Row="4"
    Width="26" 
    HorizontalAlignment="Left" 
    VerticalAlignment="Center" Margin="247,20,0,0"  />
        <Image Source="../../../Resources/Images/GuestImages/StarIcon.png"
    Grid.Column="0" 
    Grid.Row="4"
    Width="26" 
    HorizontalAlignment="Left" 
    VerticalAlignment="Center" Margin="215,20,0,0" />
        <Image Source="../../../Resources/Images/GuestImages/StarIcon.png" 
    Grid.Row="4"
    Width="26" 
    HorizontalAlignment="Center" 
    VerticalAlignment="Center" Margin="0,20,0,0"/>
        <Image Source="../../../Resources/Images/GuestImages/StarIcon.png"
    Grid.Column="0" 
    Grid.Row="4"
    Width="26" 
    HorizontalAlignment="Left" 
    VerticalAlignment="Center" Margin="152,20,0,0" />

        <Label Content="Time left for super quest" 
     HorizontalAlignment="Center"
     VerticalAlignment="Center" 
     Grid.Column="0" 
     Grid.Row="5"
     Height="auto" 
     Width="auto"
     FontSize="14" Margin="0,30,0,0"/>
        <Image Source="../../../Resources/Images/GuestImages/ClockIcon.png"
    Grid.Column="0" 
    Grid.Row="6"
    Width="26" 
    HorizontalAlignment="Left" 
    VerticalAlignment="Top" Margin="85,10,0,0"/>
        <Label Content="Vreme koje tece" 
     HorizontalAlignment="Left"
     VerticalAlignment="Top" 
     Grid.Column="0" 
     Grid.Row="6"
     Height="auto" 
     Width="auto"
     FontSize="14" Margin="132,5,0,0"/>
    </Grid>
</UserControl>
