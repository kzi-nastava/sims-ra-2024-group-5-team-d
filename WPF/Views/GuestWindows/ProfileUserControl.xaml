<UserControl x:Class="BookingApp.WPF.Views.GuestWindows.ProfileUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.GuestWindows"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="430">
    <Grid Background="{StaticResource PrimaryBlack}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image Source="../../../Resources/Images/GuestImages/people.png" 
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" 
                 Grid.Column="0" 
                 Grid.Row="0"
                 Height="90" 
                 Width="90"
                 Margin="0,20,0,0"/>
        <Label Content="Full name" 
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" 
                 Grid.Column="0" 
                 Grid.Row="1"
                 FontWeight="Bold"
                 Height="auto" 
                 Width="auto"
                 FontSize="20"
                 Foreground="{StaticResource WhiteWhite}"/>
        <Label Content="Super quest" 
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" 
                 Grid.Column="0" 
                 Grid.Row="2"
                 FontWeight="Bold"
                 Height="auto" 
                 Width="auto"
                 FontSize="20"
                 Margin="0,30,0,0"
                 Foreground="{StaticResource WhiteWhite}"/>
            <Label Content="Number of reservation this year" 
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" 
                     Grid.Column="0" 
                     Grid.Row="3"
                     Height="auto" 
                     Width="auto"
                     FontSize="14" 
                     Margin="0,25,0,0"
                     Foreground="{StaticResource WhiteWhite}"/>
            <Border Width="70"
                    Height="50"
                    BorderThickness="2"
                    BorderBrush="{StaticResource WhiteWhite}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center" 
                    Grid.Column="0"
                    Grid.Row="4">
                <Label Content="7"
                   FontSize="24" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   Foreground="{StaticResource WhiteWhite}"/>

            </Border>
            <Label Content="Bonus points" 
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" 
                     Grid.Column="0" 
                     Grid.Row="5"
                     Height="auto" 
                     Width="auto"
                     FontSize="14" 
                     Margin="0,30,0,0"
                     Foreground="{StaticResource WhiteWhite}"/>

            <Image Source="../../../Resources/Images/GuestImages/fullStar.png" 
                    Grid.Row="6"
                    Width="26" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" />
            <Image Source="../../../Resources/Images/GuestImages/fullStar.png"
                    Grid.Column="0" 
                    Grid.Row="6"
                    Width="26" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" Margin="138,0,0,0" />
            <Image Source="../../../Resources/Images/GuestImages/fullStar.png"
                    Grid.Column="0" 
                    Grid.Row="6"
                    Width="26" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" Margin="170,0,0,0" />
            <Image Source="../../../Resources/Images/GuestImages/star.png" 
                    Grid.Row="6"
                    Width="26" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" Margin="233,0,0,0" />
            <Image Source="../../../Resources/Images/GuestImages/star.png" 
                    Grid.Row="6"
                    Width="26" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" Margin="264,0,0,0" />

            <Label Content="Time left for super quest" 
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" 
                     Grid.Column="0" 
                     Grid.Row="7"
                     Height="auto" 
                     Width="auto"
                     FontSize="14" 
                     Margin="0,30,0,5"
                     Foreground="{StaticResource WhiteWhite}"/>
            <Image Source="../../../Resources/Images/GuestImages/clock.png"
                    Grid.Column="0" 
                    Grid.Row="8"
                    Width="26" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" 
                    Margin="124,0,0,40"/>
            <Label Content="2m7d38h24min" 
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" 
                     Grid.Column="0" 
                     Grid.Row="8"
                     Height="auto" 
                     Width="auto"
                     FontSize="14"
                     Foreground="{StaticResource WhiteWhite}" Margin="0,0,0,40"/>
        
        <Button x:Name="LogOut"
                      Grid.Row="9" 
                      Grid.Column="1" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"
                      Background="Transparent">
            <Border  Background="DarkOrange"
                       CornerRadius="5"
                       Height="30" 
                       Width="118">
                <TextBlock  Text="LogOut"
                        Foreground="{StaticResource  WhiteGrey}" 
                        FontWeight="Bold" 
                        FontSize="13" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center"/>
            </Border>
        </Button>
    </Grid>
</UserControl>
