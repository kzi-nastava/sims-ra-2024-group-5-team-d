<UserControl x:Class="BookingApp.WPF.Views.GuestWindows.ReservationsAccommodationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.GuestWindows" xmlns:local1="clr-namespace:BookingApp.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="430">
    <UserControl.Resources>
        <local1:FirstImagePathConverter x:Key="FirstImagePathConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <TabControl Grid.Column="0" 
         Grid.Row="0" 
         Grid.ColumnSpan="4"
         Background="{StaticResource PrimaryBlack3}">
            <TabItem  Width="100" 
                Background="{StaticResource PrimaryBlack3}">
                <TabItem.Header>
                    <Border Background="{StaticResource PrimaryBlack3}">
                        <Border BorderBrush="{StaticResource PrimaryColor}" 
                            BorderThickness="3" 
                            CornerRadius="10"
                            Background="{StaticResource PrimaryColor2}"
                            Width="80">
                            <TextBlock Text="Active" 
                                   Padding="5"
                                   Foreground="{StaticResource WhiteWhite}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                </TabItem.Header>
                <ListView BorderThickness="0" 
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Visible" 
                     Grid.Row="2"
                     Grid.ColumnSpan="4"
                     ScrollViewer.CanContentScroll="False"
                     ItemsSource="{Binding ActiveReservations}"
                     SelectedItem="{Binding SelectedReservation}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource PrimaryColor}" 
                             Background="{StaticResource PrimaryColor2}"
                             BorderThickness="2" 
                             CornerRadius="10"
                             Width="380"
                             Height="auto">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Source="{Binding ImagesPath, Converter={StaticResource FirstImagePathConverter}}"
                                        Width="120" 
                                        Height="100"                                      
                                        Grid.RowSpan="5" 
                                        VerticalAlignment="Center" 
                                        HorizontalAlignment="Center"
                                        Margin="10,0,0,0"/>
                                    <TextBlock Text="{Binding Name}"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        FontSize="13" 
                                        FontWeight="Bold"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Center" 
                                        Margin="0,5,0,0"
                                        Foreground="{StaticResource WhiteWhite}"/>
                                    <Label Content="From:" 
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top" 
                                        Grid.Column="1"
                                        Grid.Row="1"
                                        Height="auto" 
                                        Width="auto"
                                        FontSize="9" 
                                        Margin="15,0,0,0" 
                                        Grid.RowSpan="2" 
                                        HorizontalContentAlignment="Center"
                                        Foreground="{StaticResource WhiteWhite}"/>
                                    <Label Content="{Binding ReservedFrom}" 
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top" 
                                        Grid.Column="1"
                                        Grid.Row="1"
                                        Height="auto" 
                                        Width="auto"
                                        FontSize="9" 
                                        Margin="16,0,0,0" 
                                        Foreground="{StaticResource WhiteWhite}"/>
                                    <Label Content="To:" 
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top" 
                                        Grid.Column="2"
                                        Grid.Row="1"
                                        Height="auto" 
                                        Width="auto"
                                        FontSize="9"  
                                        Grid.RowSpan="2"
                                        Foreground="{StaticResource WhiteWhite}"/>
                                    <Label Content="{Binding ReservedTo}" 
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top" 
                                        Grid.Column="2"
                                        Height="auto" 
                                        Width="auto"
                                        FontSize="9" 
                                        Margin="15,0,0,0" 
                                        Grid.RowSpan="2"
                                        Grid.Row="1"
                                        Foreground="{StaticResource WhiteWhite}"/>
                                    <Label Content="Number of people:" 
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top" 
                                        Grid.Column="1"
                                        Height="auto" 
                                        Width="auto"
                                        FontSize="9" 
                                        Grid.Row="2"
                                        Margin="16,0,0,0"
                                        Foreground="{StaticResource WhiteWhite}"/>
                                    <Label Content="{Binding Capacity}" 
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top" 
                                        Grid.Column="1"
                                        Grid.Row="2"
                                        Height="auto" 
                                        Width="auto"
                                        FontSize="9" 
                                        Margin="90,0,0,0" 
                                        Foreground="{StaticResource WhiteWhite}"/>
                                    <Label Content="Cancel or move reservation" 
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top" 
                                        Grid.Column="1" 
                                        Grid.ColumnSpan="2"
                                        Grid.Row="3"
                                        FontWeight="Bold"
                                        Height="auto" 
                                        Width="auto"
                                        FontSize="11" 
                                        Foreground="{StaticResource WhiteWhite}"/>
                                    <Button x:Name="CancelledButton" 
                                     Grid.Row="4" 
                                     Grid.Column="1" 
                                     HorizontalAlignment="Center" 
                                     VerticalAlignment="Center"
                                     Click="CancelledReservationButton"
                                     Background="Transparent"
                                     IsEnabled="{Binding isReseravtionCancellable}">
                                        <Border  Background="DarkOrange"
                                                 BorderBrush="DarkOrange"
                                                  CornerRadius="5"
                                                   Height="25"
                                                   Width="60">
                                                <TextBlock  Text="Cancel"
                                                             Foreground="{StaticResource  WhiteGrey}" 
                                                             FontWeight="Bold" 
                                                             FontSize="11" 
                                                             HorizontalAlignment="Center" 
                                                             VerticalAlignment="Center"/>
                                        </Border>
                                    </Button>

                                    <Button x:Name="MoveButton" 
                                     Grid.Row="4" 
                                     Grid.Column="2" 
                                     VerticalAlignment="Center" 
                                     HorizontalAlignment="Center"
                                     Background="Transparent"
                                     Click="MoveReservationClick"
                                     IsEnabled="True">
                                        <Border  Background="DarkOrange"
                                                  CornerRadius="5"
                                                   Height="25" Width="60">
                                            <TextBlock  Text="Move" 
                                                             Foreground="{StaticResource  WhiteGrey}" 
                                                             FontWeight="Bold" 
                                                             FontSize="11" 
                                                             HorizontalAlignment="Center" 
                                                             VerticalAlignment="Center"/>
                                        </Border>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </TabItem>

            <TabItem   Width="100"                
                       Background="{StaticResource PrimaryBlack3}">
                <TabItem.Header>
                    <Border Background="{StaticResource PrimaryBlack3}">
                        <Border BorderBrush="{StaticResource PrimaryColor}" 
                            BorderThickness="3" 
                            CornerRadius="10"
                            Background="{StaticResource PrimaryColor2}"
                            Width="80">
                            <TextBlock Text="Canceled" 
                                   Padding="5"
                                   Foreground="{StaticResource WhiteWhite}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                </TabItem.Header>
                <ListView BorderThickness="0" 
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Visible" 
                      Grid.Row="2"
                      Grid.ColumnSpan="4"
                      ScrollViewer.CanContentScroll="False"
                      ItemsSource="{Binding CancelledReservations}"
                      SelectedItem="{Binding SelectedReservation}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border  BorderBrush="{StaticResource PrimaryColor}" 
                             Background="{StaticResource PrimaryColor2}"
                          BorderThickness="2" 
                          CornerRadius="10"
                          Width="380"
                          Height="auto">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Source="{Binding ImagesPath, Converter={StaticResource FirstImagePathConverter}}"
                                     Width="70" 
                                     Height="70"                                      
                                     Grid.RowSpan="3" 
                                     VerticalAlignment="Center" 
                                     HorizontalAlignment="Center"
                                     Margin="10,0,0,0"/>
                                    <TextBlock Text="{Binding Name}" 
                                     Grid.Column="1"
                                     Grid.ColumnSpan="2"
                                     FontSize="13" 
                                     FontWeight="Bold"
                                     VerticalAlignment="Top"
                                     HorizontalAlignment="Center" 
                                     Height="18" 
                                     Width="auto"
                                     Foreground="{StaticResource WhiteWhite}"/>
                                    <Label Content="From:" 
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top" 
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Height="auto" 
                                     Width="auto"
                                     FontSize="9"
                                     Margin="27,0,0,0"
                                     Foreground="{StaticResource WhiteWhite}"/>
                                    <Label Content="{Binding ReservedFrom}" 
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top" 
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Height="auto" 
                                     Width="auto"
                                     FontSize="9"
                                     Margin="60,0,0,0"
                                     Foreground="{StaticResource WhiteWhite}"/>
                                    <Label Content="To:" 
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top" 
                                     Grid.Row="1"
                                     Grid.Column="2"
                                     Height="auto" 
                                     Width="auto"
                                     FontSize="9"
                                     Foreground="{StaticResource WhiteWhite}"/>
                                    <Label Content="{Binding ReservedTo}" 
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top" 
                                     Grid.Row="1"
                                     Grid.Column="2"
                                     Height="auto" 
                                     Width="auto"
                                     FontSize="9" 
                                     Margin="20,0,0,0"
                                     Foreground="{StaticResource WhiteWhite}"/>
                                    <Label Content="Number of people:" 
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top" 
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Height="auto" 
                                     Width="auto"
                                     FontSize="9"
                                     Margin="27,0,0,0"
                                     Foreground="{StaticResource WhiteWhite}"/>
                                    <Label Content="{Binding Capacity}" 
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Top" 
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Height="auto" 
                                     Width="auto"
                                     FontSize="9"
                                     Margin="90,0,0,0"
                                     Foreground="{StaticResource WhiteWhite}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </TabItem>

            <TabItem Width="100"
                Background="{StaticResource PrimaryBlack3}">
                <TabItem.Header>
                    <Border Background="{StaticResource PrimaryBlack3}">
                        <Border BorderBrush="{StaticResource PrimaryColor}" 
                            BorderThickness="3" 
                            CornerRadius="10"
                            Background="{StaticResource PrimaryColor2}"
                            Width="80">
                            <TextBlock Text="Past" 
                                   Padding="5"
                                   Foreground="{StaticResource WhiteWhite}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                </TabItem.Header>
                <ListView BorderThickness="0" 
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     Grid.Row="2"
                     Grid.ColumnSpan="4"
                     ScrollViewer.CanContentScroll="False"
                     ItemsSource="{Binding FinishedReservations}"
                     SelectedItem="{Binding SelectedReservation}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource PrimaryColor}"
                             Background="{StaticResource PrimaryColor2}"
                             BorderThickness="2" 
                             CornerRadius="10"
                             Width="380"
                             Height="auto">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Image Source="{Binding ImagesPath, Converter={StaticResource FirstImagePathConverter}}" 
                                        Width="100" 
                                        Height="100"                                      
                                        Grid.RowSpan="5" 
                                        VerticalAlignment="Center" 
                                        HorizontalAlignment="Center"
                                        Margin="10,0,0,0"/>
                                    <TextBlock Text="{Binding Name}" 
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        FontSize="13" 
                                        FontWeight="Bold"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Center"
                                        Foreground="{StaticResource WhiteWhite}"/>
                                    <Label Content="From:" 
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top" 
                                        Grid.Column="1"
                                        Grid.Row="1"
                                        Height="auto" 
                                        Width="auto"
                                        FontSize="9" 
                                        Margin="20,0,0,0" 
                                        Foreground="{StaticResource WhiteWhite}"/>
                                    <Label Content="{Binding ReservedFrom}" 
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top" 
                                        Grid.Column="1"
                                        Grid.Row="1"
                                        Height="24" 
                                        Width="auto"
                                        FontSize="9" 
                                        Margin="52,1,0,0" 
                                        Foreground="{StaticResource WhiteWhite}"/>
                                    <Label Content="To:" 
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top" 
                                         Grid.Column="2"
                                         Grid.Row="1"
                                         Height="24" 
                                         Width="auto"
                                         FontSize="9" 
                                         Margin="20,1,0,0" 
                                         Foreground="{StaticResource WhiteWhite}"/>
                                    <Label Content="{Binding ReservedTo}" 
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top" 
                                         Grid.Column="2"
                                         Grid.Row="1"
                                         Height="auto" 
                                         Width="auto"
                                         FontSize="9" 
                                         Margin="41,1,0,0" 
                                         Foreground="{StaticResource WhiteWhite}"/>
                                    <Label Content="Number of people:" 
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top" 
                                        Grid.Column="1"
                                        Grid.Row="2"
                                        Height="auto" 
                                        Width="auto"
                                        FontSize="9" 
                                        Margin="20,-5,0,0" 
                                        Foreground="{StaticResource WhiteWhite}"/>
                                    <Label Content="{Binding Capacity}" 
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top" 
                                        Grid.Column="1"
                                        Grid.Row="2"
                                        Height="auto" 
                                        Width="auto"
                                        FontSize="9" 
                                        Margin="88,-5,0,0" 
                                        Foreground="{StaticResource WhiteWhite}"/>
                                    <Label Content="Rate owner and accommodation" 
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top" 
                                        Grid.Column="1" 
                                        Grid.ColumnSpan="2"
                                        Grid.Row="3"
                                        FontWeight="Bold"
                                        Height="auto" 
                                        Width="auto"
                                        FontSize="11"
                                        Margin="0,-5,0,0"
                                        Foreground="{StaticResource WhiteWhite}"/>
                                    <Button x:Name="RateButton"
                                            Grid.Row="4" 
                                            Grid.Column="1" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Grid.ColumnSpan="2"
                                            Click="RateTheOwnerClick"
                                            Background="Transparent"
                                            IsEnabled="{Binding isReservationRateable}">
                                        <Border  Background="DarkOrange"
                                                CornerRadius="5"
                                                Height="25" 
                                                Width="60">
                                            <TextBlock  Text="Rate"
                                            Foreground="{StaticResource  WhiteGrey}" 
                                            FontWeight="Bold" 
                                            FontSize="11" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </TabItem>
            <TabItem Width="100"
                   Background="{StaticResource PrimaryBlack3}">
                <TabItem.Header>
                    <Border Background="{StaticResource PrimaryBlack3}">
                        <Border BorderBrush="{StaticResource PrimaryColor}" 
                            BorderThickness="3" 
                            CornerRadius="10"
                            Background="{StaticResource PrimaryColor2}"
                            Width="80">
                            <TextBlock Text="Statistics" 
                                   Padding="5"
                                   Foreground="{StaticResource WhiteWhite}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                </TabItem.Header>
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Super quest" 
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" 
                     Grid.Column="0" 
                     Grid.Row="0"
                     FontWeight="Bold"
                     Height="auto" 
                     Width="auto"
                     FontSize="20"
                     Margin="0,30,0,0"/>
                    <Label Content="Number of reservation this year" 
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" 
                     Grid.Column="0" 
                     Grid.Row="1"
                     Height="auto" 
                     Width="auto"
                     FontSize="14" Margin="0,30,0,0"/>
                    <Rectangle Width="70"
                    Height="50"
                    Stroke="Black"
                    StrokeThickness="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center" 
                    Margin="0,15,0,15"
                    Grid.Column="0"
                    Grid.Row="2"/>
                    <Label Content="Bonus points" 
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" 
                     Grid.Column="0" 
                     Grid.Row="3"
                     Height="auto" 
                     Width="auto"
                     FontSize="14" Margin="0,30,0,0"/>

                    <Image Source="../../../Resources/Images/GuestImages/StarIcon.png"
                    Grid.Column="0" 
                    Grid.Row="4"
                    Width="26" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" Margin="121,20,0,0" />
                    <Image Source="../../../Resources/Images/GuestImages/StarIcon.png"
                    Grid.Column="0" 
                    Grid.Row="4"
                    Width="26" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" Margin="247,20,0,0"  />
                    <Image Source="../../../Resources/Images/GuestImages/StarIcon.png"
                    Grid.Column="0" 
                    Grid.Row="4"
                    Width="26" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" Margin="215,20,0,0" />
                    <Image Source="../../../Resources/Images/GuestImages/StarIcon.png" 
                    Grid.Row="4"
                    Width="26" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" Margin="0,20,0,0"/>
                    <Image Source="../../../Resources/Images/GuestImages/StarIcon.png"
                    Grid.Column="0" 
                    Grid.Row="4"
                    Width="26" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" Margin="152,20,0,0" />

                    <Label Content="Time left for super quest" 
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" 
                     Grid.Column="0" 
                     Grid.Row="5"
                     Height="auto" 
                     Width="auto"
                     FontSize="14" Margin="0,30,0,0"/>
                    <Image Source="../../../Resources/Images/GuestImages/ClockIcon.png"
                    Grid.Column="0" 
                    Grid.Row="6"
                    Width="26" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" Margin="85,10,0,0"/>
                    <Label Content="Vreme koje tece" 
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top" 
                     Grid.Column="0" 
                     Grid.Row="6"
                     Height="auto" 
                     Width="auto"
                     FontSize="14" Margin="132,5,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
