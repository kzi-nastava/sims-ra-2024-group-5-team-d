<UserControl x:Class="BookingApp.WPF.Views.GuestWindows.ReservationsAccommodationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.GuestWindows" xmlns:local1="clr-namespace:BookingApp.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="657.04" d:DesignWidth="430">
    <UserControl.Resources>
        <local1:FirstImagePathConverter x:Key="FirstImagePathConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <TabControl Grid.Column="0" 
         Grid.Row="0" 
         Grid.ColumnSpan="4">
            <TabItem Header="Active" 
              Width="100" >
                <ListView BorderThickness="0" 
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Grid.Row="2"
                     Grid.ColumnSpan="4"
                     ScrollViewer.CanContentScroll="False"
                     ItemsSource="{Binding ActiveReservations}"
                     SelectedItem="{Binding SelectedReservation}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Black" 
                             BorderThickness="2" 
                             CornerRadius="10"
                             Width="380"
                             Height="114">
                                <Grid Margin="15,8,15,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="Black" 
                                     BorderThickness="1" 
                                     Grid.RowSpan="5"
                                     HorizontalAlignment="Right"/>

                                    <Image Source="{Binding ImagesPath, Converter={StaticResource FirstImagePathConverter}}"
                                        Width="50" 
                                        Height="50"                                      
                                        Grid.RowSpan="5" 
                                        VerticalAlignment="Center" 
                                        HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        FontSize="13" 
                                        FontWeight="Bold"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Left" 
                                        Margin="94,-11,0,0"/>
                                    <Label Content="From:" 
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top" 
                                        Grid.Column="1"
                                        Height="auto" 
                                        Width="auto"
                                        FontSize="9" 
                                        Margin="26,4,0,0" 
                                        Grid.RowSpan="2" 
                                        HorizontalContentAlignment="Center"/>
                                    <Label Content="{Binding ReservedFrom}" 
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top" 
                                        Grid.Column="1"
                                        Height="auto" 
                                        Width="auto"
                                        FontSize="9" 
                                        Margin="16,4,0,0" 
                                        Grid.RowSpan="2"/>
                                    <Label Content="To:" 
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top" 
                                        Grid.Column="2"
                                        Height="auto" 
                                        Width="auto"
                                        FontSize="9" 
                                        Margin="0,4,0,0" 
                                        Grid.RowSpan="2"/>
                                    <Label Content="{Binding ReservedTo}" 
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top" 
                                        Grid.Column="2"
                                        Height="auto" 
                                        Width="auto"
                                        FontSize="9" 
                                        Margin="15,4,0,0" 
                                        Grid.RowSpan="2"/>
                                    <Label Content="Number of people:" 
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top" 
                                        Grid.Column="1"
                                        Height="auto" 
                                        Width="auto"
                                        FontSize="9" 
                                        Margin="0,17,0,0" 
                                        Grid.RowSpan="3"/>
                                    <Label Content="{Binding Capacity}" 
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top" 
                                        Grid.Column="1"
                                        Height="auto" 
                                        Width="auto"
                                        FontSize="9" 
                                        Margin="90,17,0,0" 
                                        Grid.RowSpan="3"/>
                                    <Label Content="Cancel or move reservation" 
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top" 
                                        Grid.Column="1" 
                                        Grid.ColumnSpan="2"
                                        Grid.Row="1"
                                        FontWeight="Bold"
                                        Height="auto" 
                                        Width="auto"
                                        FontSize="11" 
                                        Margin="69,18,0,0" 
                                        Grid.RowSpan="3"/>
                                    <Button x:Name="CancelledButton" 
                                     Content="Cancel" 
                                     Grid.Row="4" 
                                     Grid.Column="1" 
                                     Width="50" 
                                     HorizontalAlignment="Center" 
                                     VerticalAlignment="Center"
                                     Click="CancelledReservationButton"
                                     IsEnabled="{Binding isReseravtionCancellable}"/>
                                    <Button x:Name="MoveButton" 
                                     Content="Move" 
                                     Grid.Row="4" 
                                     Grid.Column="2" 
                                     Width="50" 
                                     VerticalAlignment="Center" 
                                     HorizontalAlignment="Center"
                                     Click="MoveReservationClick"
                                     IsEnabled="True"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </TabItem>

            <TabItem Header="Cancelled" 
                  Width="100">
                <ListView BorderThickness="0" 
                      Background="Transparent"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      Grid.Row="2"
                      Grid.ColumnSpan="4"
                      ScrollViewer.CanContentScroll="False"
                      ItemsSource="{Binding CancelledReservations}"
                      SelectedItem="{Binding SelectedReservation}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Black" 
                          BorderThickness="2" 
                          CornerRadius="10"
                          Width="380"
                          Height="77">
                                <Grid Margin="15,8,15,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="Black" 
                                  BorderThickness="1" 
                                  Grid.RowSpan="5"
                                  HorizontalAlignment="Right"/>

                                    <Image Source="{Binding ImagesPath, Converter={StaticResource FirstImagePathConverter}}"
                                     Width="40" 
                                     Height="40"                                      
                                     Grid.RowSpan="3" 
                                     VerticalAlignment="Center" 
                                     HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" 
                                     Grid.Column="1"
                                     Grid.ColumnSpan="2"
                                     FontSize="13" 
                                     FontWeight="Bold"
                                     VerticalAlignment="Top"
                                     HorizontalAlignment="Center" 
                                     Height="18" 
                                     Width="auto"/>
                                    <Label Content="From:" 
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top" 
                                     Grid.Row="1"
                                     Grid.RowSpan="2"
                                     Grid.Column="1"
                                     Height="auto" 
                                     Width="auto"
                                     FontSize="9"
                                     Margin="27,0,0,10"/>
                                    <Label Content="{Binding ReservedFrom}" 
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top" 
                                     Grid.Row="1"
                                     Grid.RowSpan="2"
                                     Grid.Column="1"
                                     Height="auto" 
                                     Width="auto"
                                     FontSize="9"
                                     Margin="60,0,0,10"/>
                                    <Label Content="To:" 
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top" 
                                     Grid.Row="1"
                                     Grid.RowSpan="2"
                                     Grid.Column="2"
                                     Height="auto" 
                                     Width="auto"
                                     FontSize="9"/>
                                    <Label Content="{Binding ReservedTo}" 
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top" 
                                     Grid.Row="1"
                                     Grid.RowSpan="2"
                                     Grid.Column="2"
                                     Height="auto" 
                                     Width="auto"
                                     FontSize="9" Margin="20,0,0,0"/>
                                    <Label Content="Number of people:" 
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Top" 
                                     Grid.Row="1"
                                     Grid.RowSpan="2"
                                     Grid.Column="1"
                                     Height="auto" 
                                     Width="auto"
                                     FontSize="9"
                                     Margin="0,16,0,0"/>
                                    <Label Content="{Binding Capacity}" 
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Top" 
                                     Grid.Row="1"
                                     Grid.RowSpan="2"
                                     Grid.Column="1"
                                     Height="auto" 
                                     Width="auto"
                                     FontSize="9"
                                     Margin="90,16,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </TabItem>

            <TabItem Header="Past" 
                  Width="100">
                <ListView BorderThickness="0" 
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Grid.Row="2"
                     Grid.ColumnSpan="4"
                     ScrollViewer.CanContentScroll="False"
                     ItemsSource="{Binding FinishedReservations}"
                     SelectedItem="{Binding SelectedReservation}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Black" 
                             BorderThickness="2" 
                             CornerRadius="10"
                             Width="380"
                             Height="114">
                                <Grid Margin="15,8,15,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="Black" 
                                     BorderThickness="1" 
                                     Grid.RowSpan="5"
                                     HorizontalAlignment="Right"/>

                                    <Image Source="{Binding ImagesPath, Converter={StaticResource FirstImagePathConverter}}" 
                                        Width="50" 
                                        Height="50"                                      
                                        Grid.RowSpan="5" 
                                        VerticalAlignment="Center" 
                                        HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" 
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        FontSize="13" 
                                        FontWeight="Bold"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Center"/>
                                    <Label Content="From:" 
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top" 
                                        Grid.Column="1"
                                        Grid.Row="1"
                                        Height="24" 
                                        Width="auto"
                                        FontSize="9" 
                                        Margin="26,1,0,0" 
                                        Grid.RowSpan="2"/>
                                    <Label Content="{Binding ReservedFrom}" 
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top" 
                                        Grid.Column="1"
                                        Grid.Row="1"
                                        Height="24" 
                                        Width="auto"
                                        FontSize="9" 
                                        Margin="52,1,0,0" 
                                        Grid.RowSpan="2"/>
                                    <Label Content="To:" 
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top" 
                                         Grid.Column="2"
                                         Grid.Row="1"
                                         Height="24" 
                                         Width="auto"
                                         FontSize="9" 
                                         Margin="26,1,0,0" 
                                         Grid.RowSpan="2"/>
                                    <Label Content="{Binding ReservedTo}" 
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Top" 
                                         Grid.Column="2"
                                         Grid.Row="1"
                                         Height="24" 
                                         Width="auto"
                                         FontSize="9" 
                                         Margin="41,1,0,0" 
                                         Grid.RowSpan="2"/>
                                    <Label Content="Number of people:" 
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top" 
                                        Grid.Column="1"
                                        Grid.Row="1"
                                        Height="auto" 
                                        Width="auto"
                                        FontSize="9" 
                                        Margin="0,14,0,0" 
                                        Grid.RowSpan="2"/>
                                    <Label Content="{Binding Capacity}" 
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top" 
                                        Grid.Column="1"
                                        Grid.Row="1"
                                        Height="auto" 
                                        Width="auto"
                                        FontSize="9" 
                                        Margin="88,14,0,0" 
                                        Grid.RowSpan="2"/>
                                    <Label Content="Rate owner and accommodation" 
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top" 
                                        Grid.Column="1" 
                                        Grid.ColumnSpan="2"
                                        Grid.Row="2"
                                        FontWeight="Bold"
                                        Height="auto" 
                                        Width="auto"
                                        FontSize="11"
                                        Margin="49,15,0,0" 
                                        Grid.RowSpan="2" />
                                    <Button x:Name="RateButton"
                                            Content="Rate" 
                                            Grid.Row="4" 
                                            Grid.Column="1" 
                                            Width="50" 
                                            HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Grid.ColumnSpan="2"
                                            Click="RateTheOwnerClick"
                                            IsEnabled="{Binding isReservationRateable}">
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </TabItem>
            <TabItem Header="Statistics" 
                  Width="100">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Content="Super quest" 
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" 
                     Grid.Column="0" 
                     Grid.Row="0"
                     FontWeight="Bold"
                     Height="auto" 
                     Width="auto"
                     FontSize="20"
                     Margin="0,30,0,0"/>
                    <Label Content="Number of reservation this year" 
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" 
                     Grid.Column="0" 
                     Grid.Row="1"
                     Height="auto" 
                     Width="auto"
                     FontSize="14" Margin="0,30,0,0"/>
                    <Rectangle Width="70"
                    Height="50"
                    Stroke="Black"
                    StrokeThickness="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center" 
                    Margin="0,15,0,15"
                    Grid.Column="0"
                    Grid.Row="2"/>
                    <Label Content="Bonus points" 
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" 
                     Grid.Column="0" 
                     Grid.Row="3"
                     Height="auto" 
                     Width="auto"
                     FontSize="14" Margin="0,30,0,0"/>

                    <Image Source="../../../Resources/Images/GuestImages/StarIcon.png"
                    Grid.Column="0" 
                    Grid.Row="4"
                    Width="26" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" Margin="121,20,0,0" />
                    <Image Source="../../../Resources/Images/GuestImages/StarIcon.png"
                    Grid.Column="0" 
                    Grid.Row="4"
                    Width="26" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" Margin="247,20,0,0"  />
                    <Image Source="../../../Resources/Images/GuestImages/StarIcon.png"
                    Grid.Column="0" 
                    Grid.Row="4"
                    Width="26" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" Margin="215,20,0,0" />
                    <Image Source="../../../Resources/Images/GuestImages/StarIcon.png" 
                    Grid.Row="4"
                    Width="26" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" Margin="0,20,0,0"/>
                    <Image Source="../../../Resources/Images/GuestImages/StarIcon.png"
                    Grid.Column="0" 
                    Grid.Row="4"
                    Width="26" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center" Margin="152,20,0,0" />

                    <Label Content="Time left for super quest" 
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" 
                     Grid.Column="0" 
                     Grid.Row="5"
                     Height="auto" 
                     Width="auto"
                     FontSize="14" Margin="0,30,0,0"/>
                    <Image Source="../../../Resources/Images/GuestImages/ClockIcon.png"
                    Grid.Column="0" 
                    Grid.Row="6"
                    Width="26" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Top" Margin="85,10,0,0"/>
                    <Label Content="Vreme koje tece" 
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top" 
                     Grid.Column="0" 
                     Grid.Row="6"
                     Height="auto" 
                     Width="auto"
                     FontSize="14" Margin="132,5,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
