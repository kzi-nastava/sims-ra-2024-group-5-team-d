<UserControl x:Class="BookingApp.WPF.Views.GuestWindows.InboxAccommodationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.GuestWindows" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:local1="clr-namespace:BookingApp.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="430">
    <UserControl.Resources>
        <local1:FirstImagePathConverter x:Key="FirstImagePathConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Column="0" 
                        Grid.Row="0" 
                        Grid.ColumnSpan="4">
            <TabItem Width="100">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Approved" Margin="15,0,0,0"/>
                        <Border CornerRadius="900"
                                Background="Red"
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center" 
                                Margin="0,0,5,0">
                            <TextBlock Foreground="AntiqueWhite" 
                                       Margin="0 0 0 0" 
                                       Text="{Binding NumberOfApprovedNotifications}"
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Center" 
                                       FontSize="10" 
                                       Height="15" 
                                       Width="auto"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <ListView BorderThickness="0" 
                Background="Transparent"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                Grid.Row="2"
                Grid.ColumnSpan="4"
                ScrollViewer.CanContentScroll="False" 
                ItemsSource="{Binding ApprovedRequests}"
                SelectedItem="{Binding SelectedRequest}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Black" 
                        BorderThickness="2" 
                        CornerRadius="10"
                        Width="380"
                        Height="80">
                                <Grid Margin="10,10,10,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="Black" 
                                BorderThickness="1" 
                                Grid.RowSpan="5"
                                HorizontalAlignment="Right"/>

                                    <Image  Source="{Binding ImagesPath, Converter={StaticResource FirstImagePathConverter}}"
                                   Width="30" 
                                   Height="30" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center" 
                                   Grid.Column="0"
                                   Grid.Row="0"
                                   Grid.RowSpan="5"/>
                                    <TextBlock Text="{Binding AccommodationName}" 
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="2"
                                   HorizontalAlignment="Center"
                                   FontSize="13" 
                                   FontWeight="Bold"
                                   VerticalAlignment="Top"/>
                                    <Label Content="New date time" 
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top" 
                                   Grid.Column="1"
                                   FontSize="9"
                                   Grid.Row="1"
                                   Width="74"
                                   Height="21" 
                                   Margin="22,1,0,0"/>
                                    <Label Content="From:" 
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top" 
                                   Grid.Column="1"
                                   Grid.Row="1"
                                   Height="21" 
                                   Width="92"
                                   FontSize="9" 
                                   Margin="22,15,0,0" 
                                   Grid.RowSpan="2"/>
                                    <Label Content="{Binding NewReservedFrom,StringFormat='dd/MM/yyyy'}" 
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top" 
                                   Grid.Column="1"
                                   Grid.Row="1"
                                   Height="21" 
                                   Width="92"
                                   FontSize="9" 
                                   Margin="53,15,0,0" 
                                   Grid.RowSpan="2"/>
                                    <Label Content="To:" 
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top" 
                                   Grid.Column="1"
                                   Grid.Row="1"
                                   Height="21" 
                                   Width="92"
                                   FontSize="9" 
                                   Margin="114,15,0,0" 
                                   Grid.RowSpan="2"/>
                                    <Label Content="{Binding NewReservedTo,StringFormat='dd/MM/yyyy'}"  
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top" 
                                  Grid.Column="1"
                                  Grid.ColumnSpan="2"
                                  Grid.Row="1"
                                  Height="21" 
                                  Width="92"
                                  FontSize="9" 
                                  Margin="135,15,0,0" 
                                  Grid.RowSpan="2"/>
                                    <Image Source="../../../Resources/Images/GuestImages/ApprovedIcon.png" 
                                   Width="55" 
                                   Height="49" 
                                   VerticalAlignment="Top" 
                                   HorizontalAlignment="Left" 
                                   Grid.Column="2"
                                   Grid.RowSpan="3" Margin="79,9,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </TabItem>

            <TabItem Width="100">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="In process"/>
                    </StackPanel>
                </TabItem.Header>
                <ListView BorderThickness="0" 
                        Background="Transparent"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        Grid.Row="2"
                        Grid.ColumnSpan="4"
                        ScrollViewer.CanContentScroll="False"
                        ItemsSource="{Binding InProcessRequests}"
                        SelectedItem="{Binding SelectedRequest}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Black" 
                                BorderThickness="2" 
                                CornerRadius="10"
                                Width="380"
                                Height="80">
                                <Grid Margin="10,10,10,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="Black" 
                               BorderThickness="1" 
                               Grid.RowSpan="5"
                               HorizontalAlignment="Right"/>

                                    <Image  Source="{Binding ImagesPath, Converter={StaticResource FirstImagePathConverter}}"
                                  Width="30" 
                                  Height="30" 
                                  VerticalAlignment="Center" 
                                  HorizontalAlignment="Center" 
                                  Grid.Column="0"
                                  Grid.Row="0"
                                  Grid.RowSpan="5"/>
                                    <TextBlock Text="{Binding AccommodationName}" 
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  Grid.ColumnSpan="2"
                                  HorizontalAlignment="Center"
                                  FontSize="13" 
                                  FontWeight="Bold"
                                  VerticalAlignment="Top"/>
                                    <Label Content="New date time" 
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top" 
                                  Grid.Column="1"
                                  FontSize="9"
                                  Grid.Row="1"
                                  Width="74"
                                  Height="21" 
                                  Margin="22,1,0,0"/>
                                    <Label Content="From:" 
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top" 
                                  Grid.Column="1"
                                  Grid.Row="1"
                                  Height="21" 
                                  Width="92"
                                  FontSize="9" 
                                  Margin="22,15,0,0" 
                                  Grid.RowSpan="2"/>
                                    <Label Content="{Binding NewReservedFrom,StringFormat='dd/MM/yyyy'}" 
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top" 
                                  Grid.Column="1"
                                  Grid.Row="1"
                                  Height="21" 
                                  Width="92"
                                  FontSize="9" 
                                  Margin="53,15,0,0" 
                                  Grid.RowSpan="2"/>
                                    <Label Content="To:" 
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top" 
                                  Grid.Column="1"
                                  Grid.Row="1"
                                  Height="21" 
                                  Width="92"
                                  FontSize="9" 
                                  Margin="114,15,0,0" 
                                  Grid.RowSpan="2"/>
                                    <Label Content="{Binding NewReservedTo,StringFormat='dd/MM/yyyy'}"  
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top" 
                                 Grid.Column="1"
                                 Grid.ColumnSpan="2"
                                 Grid.Row="1"
                                 Height="21" 
                                 Width="92"
                                 FontSize="9" 
                                 Margin="135,15,0,0" 
                                 Grid.RowSpan="2"/>
                                    <Image Source="../../../Resources/Images/GuestImages/WaitingIcon.png" 
                                  Width="55" 
                                  Height="49" 
                                  VerticalAlignment="Top" 
                                  HorizontalAlignment="Left" 
                                  Grid.Column="2"
                                  Grid.RowSpan="3" Margin="79,9,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabItem>
            
            <TabItem Width="100">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Rejected" Width="auto"/>
                        <Border CornerRadius="900"
                                Background="Red"
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center" 
                                Margin="0,0,5,0">
                            <TextBlock Foreground="AntiqueWhite" 
                                       Margin="0 0 0 0" 
                                       Text="{Binding NumberOfRejectedNotifications}" 
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Center" 
                                       FontSize="10" 
                                       Height="15" 
                                       Width="auto"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <ListView BorderThickness="0" 
                    Background="Transparent"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    Grid.Row="2"
                    Grid.ColumnSpan="4"
                    ScrollViewer.CanContentScroll="False"
                    ItemsSource="{Binding RejectedRequests}"
                    SelectedItem="{Binding SelectedRequest}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Black" 
                                BorderThickness="2" 
                                CornerRadius="10"
                                Width="380"
                                Height="120">
                                <Grid Margin="10,10,10,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="Black" 
                                        BorderThickness="1" 
                                        Grid.RowSpan="5"
                                        HorizontalAlignment="Right"/>

                                    <Image  Source="{Binding ImagesPath, Converter={StaticResource FirstImagePathConverter}}" 
                                       Width="30" 
                                       Height="30" 
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Center" 
                                       Grid.Column="0"
                                       Grid.Row="0"
                                       Grid.RowSpan="5"/>
                                    <TextBlock Text="{Binding AccommodationName}" 
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       HorizontalAlignment="Center"
                                       FontSize="13" 
                                       FontWeight="Bold"
                                       VerticalAlignment="Top"/>
                                    <Label Content="New date time" 
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top" 
                                       Grid.Column="1"
                                       FontSize="9"
                                       Grid.Row="1"
                                       Width="74"
                                       Height="21" 
                                       Margin="22,1,0,0"/>
                                    <Label Content="From:" 
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top" 
                                       Grid.Column="1"
                                       Grid.Row="1"
                                       Height="21" 
                                       Width="92"
                                       FontSize="9" 
                                       Margin="22,15,0,0" 
                                       Grid.RowSpan="2"/>
                                    <Label Content="{Binding NewReservedFrom,StringFormat='dd/MM/yyyy'}"  
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top" 
                                       Grid.Column="1"
                                       Grid.Row="1"
                                       Height="21" 
                                       Width="92"
                                       FontSize="9" 
                                       Margin="53,15,0,0" 
                                       Grid.RowSpan="2"/>
                                    <Label Content="To:" 
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top" 
                                       Grid.Column="1"
                                       Grid.Row="1"
                                       Height="21" 
                                       Width="92"
                                       FontSize="9" 
                                       Margin="114,15,0,0" 
                                       Grid.RowSpan="2"/>
                                    <Label Content="{Binding NewReservedTo,StringFormat='dd/MM/yyyy'}" 
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top" 
                                      Grid.Column="1"
                                      Grid.ColumnSpan="2"
                                      Grid.Row="1"
                                      Height="21" 
                                      Width="92"
                                      FontSize="9" 
                                      Margin="135,15,0,0" 
                                      Grid.RowSpan="2"/>
                                    <Image Source="../../../Resources/Images/GuestImages/RejectedIcon.png" 
                                       Width="57" 
                                       Height="50" 
                                       VerticalAlignment="Top" 
                                       HorizontalAlignment="Left" 
                                       Grid.Column="2"
                                       Grid.RowSpan="3" Margin="92,9,0,0"/>

                                    <Label Content="Comments of the owner" 
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top" 
                                          Grid.Row="2"
                                          Grid.Column="1" 
                                          Width="auto"
                                          Margin="28,9,0,0"
                                          FontSize="9" 
                                          HorizontalContentAlignment="Center" 
                                          VerticalContentAlignment="Center"/>
                                    <Border BorderThickness="2,2,2,2" 
                                           BorderBrush="Black"
                                           Grid.Column="1"
                                           Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Grid.RowSpan="3" Margin="10,25,2,-5" Height="34"/>
                                    <Label Content="{Binding Comment}" 
                                            Grid.Row="2" 
                                            VerticalAlignment="Top" 
                                            HorizontalAlignment="Left"
                                            Margin="14,28,0,0" 
                                            Grid.Column="1"
                                            FontSize="8" 
                                            Grid.ColumnSpan="2" 
                                            Width="280" 
                                            Height="26" 
                                            Grid.RowSpan="3"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabItem>

            <TabItem Width="100">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Forum"/>
                    </StackPanel>
                </TabItem.Header>
                <ListView BorderThickness="0" 
             Background="Transparent"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             Grid.Row="2"
             Grid.ColumnSpan="4"
             ScrollViewer.CanContentScroll="False"
             ItemsSource="{Binding InProcessRequests}"
             SelectedItem="{Binding SelectedRequest}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Black" 
                     BorderThickness="2" 
                     CornerRadius="10"
                     Width="380"
                     Height="80">
                                <Grid Margin="10,10,10,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="Black" 
                    BorderThickness="1" 
                    Grid.RowSpan="5"
                    HorizontalAlignment="Right"/>

                                    <Image  Source="{Binding ImagesPath, Converter={StaticResource FirstImagePathConverter}}"
                       Width="30" 
                       Height="30" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center" 
                       Grid.Column="0"
                       Grid.Row="0"
                       Grid.RowSpan="5"/>
                                    <TextBlock Text="{Binding AccommodationName}" 
                       Grid.Row="0"
                       Grid.Column="1"
                       Grid.ColumnSpan="2"
                       HorizontalAlignment="Center"
                       FontSize="13" 
                       FontWeight="Bold"
                       VerticalAlignment="Top"/>
                                    <Label Content="New date time" 
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" 
                       Grid.Column="1"
                       FontSize="9"
                       Grid.Row="1"
                       Width="74"
                       Height="21" 
                       Margin="22,1,0,0"/>
                                    <Label Content="From:" 
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" 
                       Grid.Column="1"
                       Grid.Row="1"
                       Height="21" 
                       Width="92"
                       FontSize="9" 
                       Margin="22,15,0,0" 
                       Grid.RowSpan="2"/>
                                    <Label Content="{Binding NewReservedFrom,StringFormat='dd/MM/yyyy'}" 
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" 
                       Grid.Column="1"
                       Grid.Row="1"
                       Height="21" 
                       Width="92"
                       FontSize="9" 
                       Margin="53,15,0,0" 
                       Grid.RowSpan="2"/>
                                    <Label Content="To:" 
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top" 
                       Grid.Column="1"
                       Grid.Row="1"
                       Height="21" 
                       Width="92"
                       FontSize="9" 
                       Margin="114,15,0,0" 
                       Grid.RowSpan="2"/>
                                    <Label Content="{Binding NewReservedTo,StringFormat='dd/MM/yyyy'}"  
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top" 
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Grid.Row="1"
                      Height="21" 
                      Width="92"
                      FontSize="9" 
                      Margin="135,15,0,0" 
                      Grid.RowSpan="2"/>
                                    <Image Source="../../../Resources/Images/GuestImages/WaitingIcon.png" 
                       Width="55" 
                       Height="49" 
                       VerticalAlignment="Top" 
                       HorizontalAlignment="Left" 
                       Grid.Column="2"
                       Grid.RowSpan="3" Margin="79,9,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </TabItem>
        </TabControl>

    </Grid>
</UserControl>
