<UserControl x:Class="BookingApp.WPF.Views.GuestWindows.InboxAccommodationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.GuestWindows" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:local1="clr-namespace:BookingApp.WPF.Converters" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="430">
    <UserControl.Resources>
        <local1:FirstImagePathConverter x:Key="FirstImagePathConverter"/>
        <local1:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Column="0" 
                        Grid.Row="0" 
                        Grid.ColumnSpan="4"
                        Background="{StaticResource PrimaryBlack3}">
            <TabItem Width="100"
                     Background="{StaticResource PrimaryBlack3}">
                <TabItem.Header>
                    <Border Background="{StaticResource PrimaryBlack3}">
                        <Border BorderBrush="{StaticResource PrimaryColor}" 
                            BorderThickness="3" 
                            CornerRadius="10"
                            Background="{StaticResource PrimaryColor2}"
                            Width="90">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Approved" 
                                   Padding="5"
                                   Foreground="{StaticResource WhiteWhite}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                                <Border CornerRadius="900"
                                                 Background="DarkOrange"
                                                 Width="12"
                                                 Height="12"
                                                 VerticalAlignment="Center" 
                                                 Margin="0,0,5,0">
                                    <TextBlock Foreground="AntiqueWhite" 
                                                Margin="0 0 0 0" 
                                                Text="{Binding NumberOfApprovedNotifications}"
                                                VerticalAlignment="Center" 
                                                HorizontalAlignment="Center" 
                                                FontSize="10" 
                                                Height="15" 
                                                Width="auto"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Border>
                </TabItem.Header>
                <ListView BorderThickness="0" 
                Background="Transparent"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                Grid.Row="2"
                Grid.ColumnSpan="4"
                ScrollViewer.CanContentScroll="False" 
                ItemsSource="{Binding ApprovedRequests}"
                SelectedItem="{Binding SelectedRequest}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Black" 
                        BorderThickness="2" 
                        CornerRadius="10"
                        Width="380"
                        Height="80">
                                <Grid Margin="10,10,10,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="Black" 
                                BorderThickness="1" 
                                Grid.RowSpan="5"
                                HorizontalAlignment="Right"/>

                                    <Image  Source="{Binding ImagesPath, Converter={StaticResource FirstImagePathConverter}}"
                                   Width="30" 
                                   Height="30" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center" 
                                   Grid.Column="0"
                                   Grid.Row="0"
                                   Grid.RowSpan="5"/>
                                    <TextBlock Text="{Binding AccommodationName}" 
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Grid.ColumnSpan="2"
                                   HorizontalAlignment="Center"
                                   FontSize="13" 
                                   FontWeight="Bold"
                                   VerticalAlignment="Top"/>
                                    <Label Content="New date time" 
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top" 
                                   Grid.Column="1"
                                   FontSize="9"
                                   Grid.Row="1"
                                   Width="74"
                                   Height="21" 
                                   Margin="22,1,0,0"/>
                                    <Label Content="From:" 
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top" 
                                   Grid.Column="1"
                                   Grid.Row="1"
                                   Height="21" 
                                   Width="92"
                                   FontSize="9" 
                                   Margin="22,15,0,0" 
                                   Grid.RowSpan="2"/>
                                    <Label Content="{Binding NewReservedFrom,StringFormat='dd/MM/yyyy'}" 
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top" 
                                   Grid.Column="1"
                                   Grid.Row="1"
                                   Height="21" 
                                   Width="92"
                                   FontSize="9" 
                                   Margin="53,15,0,0" 
                                   Grid.RowSpan="2"/>
                                    <Label Content="To:" 
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top" 
                                   Grid.Column="1"
                                   Grid.Row="1"
                                   Height="21" 
                                   Width="92"
                                   FontSize="9" 
                                   Margin="114,15,0,0" 
                                   Grid.RowSpan="2"/>
                                    <Label Content="{Binding NewReservedTo,StringFormat='dd/MM/yyyy'}"  
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top" 
                                  Grid.Column="1"
                                  Grid.ColumnSpan="2"
                                  Grid.Row="1"
                                  Height="21" 
                                  Width="92"
                                  FontSize="9" 
                                  Margin="135,15,0,0" 
                                  Grid.RowSpan="2"/>
                                    <Image Source="../../../Resources/Images/GuestImages/ApprovedIcon.png" 
                                   Width="55" 
                                   Height="49" 
                                   VerticalAlignment="Top" 
                                   HorizontalAlignment="Left" 
                                   Grid.Column="2"
                                   Grid.RowSpan="3" Margin="79,9,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </TabItem>

            <TabItem Width="100"
                     Background="{StaticResource PrimaryBlack3}">
                <TabItem.Header>
                    <Border Background="{StaticResource PrimaryBlack3}">
                        <Border BorderBrush="{StaticResource PrimaryColor}" 
                                 BorderThickness="3" 
                                 CornerRadius="10"
                                 Background="{StaticResource PrimaryColor2}"
                                 Width="90">
                            <TextBlock Text="In process" 
                                Padding="5"
                                Foreground="{StaticResource WhiteWhite}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                </TabItem.Header>
                <ListView BorderThickness="0" 
                        Background="Transparent"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        Grid.Row="2"
                        Grid.ColumnSpan="4"
                        ScrollViewer.CanContentScroll="False"
                        ItemsSource="{Binding InProcessRequests}"
                        SelectedItem="{Binding SelectedRequest}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Black" 
                                BorderThickness="2" 
                                CornerRadius="10"
                                Width="380"
                                Height="80">
                                <Grid Margin="10,10,10,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="Black" 
                               BorderThickness="1" 
                               Grid.RowSpan="5"
                               HorizontalAlignment="Right"/>

                                    <Image  Source="{Binding ImagesPath, Converter={StaticResource FirstImagePathConverter}}"
                                  Width="30" 
                                  Height="30" 
                                  VerticalAlignment="Center" 
                                  HorizontalAlignment="Center" 
                                  Grid.Column="0"
                                  Grid.Row="0"
                                  Grid.RowSpan="5"/>
                                    <TextBlock Text="{Binding AccommodationName}" 
                                  Grid.Row="0"
                                  Grid.Column="1"
                                  Grid.ColumnSpan="2"
                                  HorizontalAlignment="Center"
                                  FontSize="13" 
                                  FontWeight="Bold"
                                  VerticalAlignment="Top"/>
                                    <Label Content="New date time" 
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top" 
                                  Grid.Column="1"
                                  FontSize="9"
                                  Grid.Row="1"
                                  Width="74"
                                  Height="21" 
                                  Margin="22,1,0,0"/>
                                    <Label Content="From:" 
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top" 
                                  Grid.Column="1"
                                  Grid.Row="1"
                                  Height="21" 
                                  Width="92"
                                  FontSize="9" 
                                  Margin="22,15,0,0" 
                                  Grid.RowSpan="2"/>
                                    <Label Content="{Binding NewReservedFrom,StringFormat='dd/MM/yyyy'}" 
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top" 
                                  Grid.Column="1"
                                  Grid.Row="1"
                                  Height="21" 
                                  Width="92"
                                  FontSize="9" 
                                  Margin="53,15,0,0" 
                                  Grid.RowSpan="2"/>
                                    <Label Content="To:" 
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top" 
                                  Grid.Column="1"
                                  Grid.Row="1"
                                  Height="21" 
                                  Width="92"
                                  FontSize="9" 
                                  Margin="114,15,0,0" 
                                  Grid.RowSpan="2"/>
                                    <Label Content="{Binding NewReservedTo,StringFormat='dd/MM/yyyy'}"  
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top" 
                                 Grid.Column="1"
                                 Grid.ColumnSpan="2"
                                 Grid.Row="1"
                                 Height="21" 
                                 Width="92"
                                 FontSize="9" 
                                 Margin="135,15,0,0" 
                                 Grid.RowSpan="2"/>
                                    <Image Source="../../../Resources/Images/GuestImages/WaitingIcon.png" 
                                  Width="55" 
                                  Height="49" 
                                  VerticalAlignment="Top" 
                                  HorizontalAlignment="Left" 
                                  Grid.Column="2"
                                  Grid.RowSpan="3" Margin="79,9,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabItem>

            <TabItem Width="100"
                     Background="{StaticResource PrimaryBlack3}">
                <TabItem.Header>
                    <Border Background="{StaticResource PrimaryBlack3}">
                        <Border BorderBrush="{StaticResource PrimaryColor}" 
                                 BorderThickness="3" 
                                 CornerRadius="10"
                                 Background="{StaticResource PrimaryColor2}"
                                 Width="90">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Rejected" 
                                    Padding="5"
                                    Foreground="{StaticResource WhiteWhite}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                                <Border CornerRadius="900"
                                  Background="DarkOrange"
                                  Width="12"
                                  Height="12"
                                  VerticalAlignment="Center" 
                                  Margin="0,0,5,0">
                                    <TextBlock Foreground="AntiqueWhite" 
                                 Margin="0 0 0 0" 
                                 Text="{Binding NumberOfRejectedNotifications}"
                                 VerticalAlignment="Center" 
                                 HorizontalAlignment="Center" 
                                 FontSize="10" 
                                 Height="15" 
                                 Width="auto"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Border>
                </TabItem.Header>
                <ListView BorderThickness="0" 
                    Background="Transparent"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    Grid.Row="2"
                    Grid.ColumnSpan="4"
                    ScrollViewer.CanContentScroll="False"
                    ItemsSource="{Binding RejectedRequests}"
                    SelectedItem="{Binding SelectedRequest}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Black" 
                                BorderThickness="2" 
                                CornerRadius="10"
                                Width="380"
                                Height="120">
                                <Grid Margin="10,10,10,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="Black" 
                                        BorderThickness="1" 
                                        Grid.RowSpan="5"
                                        HorizontalAlignment="Right"/>

                                    <Image  Source="{Binding ImagesPath, Converter={StaticResource FirstImagePathConverter}}" 
                                       Width="30" 
                                       Height="30" 
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Center" 
                                       Grid.Column="0"
                                       Grid.Row="0"
                                       Grid.RowSpan="5"/>
                                    <TextBlock Text="{Binding AccommodationName}" 
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       Grid.ColumnSpan="2"
                                       HorizontalAlignment="Center"
                                       FontSize="13" 
                                       FontWeight="Bold"
                                       VerticalAlignment="Top"/>
                                    <Label Content="New date time" 
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top" 
                                       Grid.Column="1"
                                       FontSize="9"
                                       Grid.Row="1"
                                       Width="74"
                                       Height="21" 
                                       Margin="22,1,0,0"/>
                                    <Label Content="From:" 
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top" 
                                       Grid.Column="1"
                                       Grid.Row="1"
                                       Height="21" 
                                       Width="92"
                                       FontSize="9" 
                                       Margin="22,15,0,0" 
                                       Grid.RowSpan="2"/>
                                    <Label Content="{Binding NewReservedFrom,StringFormat='dd/MM/yyyy'}"  
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top" 
                                       Grid.Column="1"
                                       Grid.Row="1"
                                       Height="21" 
                                       Width="92"
                                       FontSize="9" 
                                       Margin="53,15,0,0" 
                                       Grid.RowSpan="2"/>
                                    <Label Content="To:" 
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top" 
                                       Grid.Column="1"
                                       Grid.Row="1"
                                       Height="21" 
                                       Width="92"
                                       FontSize="9" 
                                       Margin="114,15,0,0" 
                                       Grid.RowSpan="2"/>
                                    <Label Content="{Binding NewReservedTo,StringFormat='dd/MM/yyyy'}" 
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top" 
                                      Grid.Column="1"
                                      Grid.ColumnSpan="2"
                                      Grid.Row="1"
                                      Height="21" 
                                      Width="92"
                                      FontSize="9" 
                                      Margin="135,15,0,0" 
                                      Grid.RowSpan="2"/>
                                    <Image Source="../../../Resources/Images/GuestImages/RejectedIcon.png" 
                                       Width="57" 
                                       Height="50" 
                                       VerticalAlignment="Top" 
                                       HorizontalAlignment="Left" 
                                       Grid.Column="2"
                                       Grid.RowSpan="3" Margin="92,9,0,0"/>

                                    <Label Content="Comments of the owner" 
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top" 
                                          Grid.Row="2"
                                          Grid.Column="1" 
                                          Width="auto"
                                          Margin="28,9,0,0"
                                          FontSize="9" 
                                          HorizontalContentAlignment="Center" 
                                          VerticalContentAlignment="Center"/>
                                    <Border BorderThickness="2,2,2,2" 
                                           BorderBrush="Black"
                                           Grid.Column="1"
                                           Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Grid.RowSpan="3" Margin="10,25,2,-5" Height="34"/>
                                    <Label Content="{Binding Comment}" 
                                            Grid.Row="2" 
                                            VerticalAlignment="Top" 
                                            HorizontalAlignment="Left"
                                            Margin="14,28,0,0" 
                                            Grid.Column="1"
                                            FontSize="8" 
                                            Grid.ColumnSpan="2" 
                                            Width="280" 
                                            Height="26" 
                                            Grid.RowSpan="3"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabItem>

            <TabItem Width="100"
                     Background="{StaticResource PrimaryBlack3}">
                <TabItem.Header>
                    <Border Background="{StaticResource PrimaryBlack3}">
                        <Border BorderBrush="{StaticResource PrimaryColor}" 
                            BorderThickness="3" 
                            CornerRadius="10"
                            Background="{StaticResource PrimaryColor2}"
                            Width="90">
                            <TextBlock Text="Forum" 
                                   Padding="5"
                                   Foreground="{StaticResource WhiteWhite}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" Margin="0,0,14,0"/>
                        </Border>
                    </Border>
                </TabItem.Header>
                <ScrollViewer>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Margin="45,20,45,20"
                          Grid.Row="0"
                          Height="360">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="300"
                            Height="330"
                            BorderThickness="4" 
                            CornerRadius="15"
                            BorderBrush="{StaticResource PrimaryColor}"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center" 
                            Grid.Column="0"
                            Grid.Row="0"
                            Grid.ColumnSpan="2"
                            Grid.RowSpan="5"
                            Background="{StaticResource PrimaryBlack}"/>


                            <Image Source="../../../Resources/Images/GuestImages/search.png"
                            Width="24" 
                            VerticalAlignment="Center"
                            Height="18" Margin="34,0,99,0"/>
                            <Label Content="Location"
                            Grid.Row="0"
                            Height="24"
                            Foreground="{StaticResource WhiteGrey}" 
                            Margin="57,0,0,0" 
                            Width="NaN" 
                            HorizontalAlignment="Left"/>
                            <ComboBox 
                           x:Name="locationTextBox" 
                           IsReadOnly="True"
                           Grid.Row="0" Margin="120,0,25,0" 
                           SelectedIndex="{Binding LocationId, UpdateSourceTrigger=PropertyChanged}" Grid.ColumnSpan="2" Width="160" Height="30">
                                <ComboBoxItem Content="Serbia, Novi Sad"/>
                                <ComboBoxItem Content="Serbia, Beograd"/>
                                <ComboBoxItem Content="Serbia, Smederevo"/>
                                <ComboBoxItem Content="Serbia, Požega"/>
                                <ComboBoxItem Content="Serbia, Kragujevac"/>
                                <ComboBoxItem Content="Serbia, Niš"/>
                                <ComboBoxItem Content="Serbia, Subotica"/>
                                <ComboBoxItem Content="Serbia, Pančevo"/>
                                <ComboBoxItem Content="Serbia, Čačak"/>
                                <ComboBoxItem Content="Serbia, Užice"/>
                                <ComboBoxItem Content="Any"/>
                            </ComboBox>
                            <Border 
                             BorderBrush="{StaticResource PrimaryColor}"
                             Grid.Column="0"
                             Grid.Row="0"
                             Grid.ColumnSpan="2"
                             VerticalAlignment="Bottom" 
                             BorderThickness="0,0,0,2"/>

                            <Label Content="Title" 
                            Grid.Row="1"
                            HorizontalAlignment="Left"
                            Foreground="{StaticResource WhiteGrey}" 
                            VerticalAlignment="Center" Margin="55,0,0,0"/>
                            <TextBox Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Grid.Row="1"
                            Height="30"
                            Width="200"
                            Text="{Binding Title}"
                            Margin="92,0,0,0"
                            TextWrapping="Wrap"
                            FlowDirection="LeftToRight" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Border BorderThickness="0,0,0,2" 
                             BorderBrush="{StaticResource PrimaryColor}"
                             Grid.Column="0"
                             Grid.Row="1"
                             Grid.ColumnSpan="2"
                             VerticalAlignment="Bottom">
                            </Border>

                            <Label Content="Comment" 
                            Grid.Row="2"
                            HorizontalAlignment="Center"
                            Foreground="{StaticResource WhiteGrey}" VerticalAlignment="Bottom" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,0,-15"/>
                            <TextBox Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Grid.Row="3"
                            Height="90" 
                            Text="{Binding Comment}"
                            Margin="15,0,15,0"
                            TextWrapping="Wrap"
                            FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                            <Border BorderThickness="0,0,0,2" 
                             BorderBrush="{StaticResource PrimaryColor}"
                             Grid.Column="0"
                             Grid.Row="3"
                             Grid.ColumnSpan="2"
                             VerticalAlignment="Bottom">
                            </Border>

                            <Button Grid.Row="4"
                                       FontSize="20" 
                                       Background="Transparent"
                                       Height="33"
                                       Width="auto"
                                       Cursor="Hand"
                                       VerticalAlignment="Center"
                                       BorderThickness="0" 
                                       HorizontalAlignment="Center"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="2"
                                    Command="{Binding CreateForumCommand}">
                                <Border  Background="DarkOrange"
                            CornerRadius="2"
                             Height="25" Width="auto">
                                    <TextBlock  Text="Create forum"
                           Margin="20 0 20 0" 
                           Foreground="{StaticResource  WhiteGrey}" 
                           FontWeight="Bold" 
                           FontSize="14" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
                                </Border>
                            </Button>

                        </Grid>

                        <ListView BorderThickness="0" 
                                 Background="{StaticResource PrimaryBlack3}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Grid.Row="1"
                                 ScrollViewer.CanContentScroll="False"
                                 ItemsSource="{Binding Forums}"
                                 SelectedItem="{Binding SelectedForum}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource PrimaryColor}"
                                            Background="{StaticResource PrimaryColor2}"
                                     BorderThickness="2" 
                                     CornerRadius="10"
                                     Width="380"
                                     Height="auto">
                                        <Grid Margin="10,10,10,5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Label  Content="{Binding Title}"
                                           Width="auto" 
                                           Height="auto" 
                                           VerticalAlignment="Top" 
                                           HorizontalAlignment="Center" 
                                           Grid.Column="0"
                                           Grid.Row="0"
                                           FontSize="16" 
                                           FontWeight="Bold"
                                           Foreground="{StaticResource WhiteWhite}"/>
                                            <Label Content="IME PREZIME" 
                                           Grid.Row="1"
                                           HorizontalAlignment="Left"
                                           FontSize="13" 
                                           FontWeight="Bold"
                                           VerticalAlignment="Top"
                                           Foreground="{StaticResource WhiteWhite}"/>
                                            <Label Content="{Binding Location}" 
                                           Grid.Row="1"
                                           HorizontalAlignment="Right"
                                           FontSize="11" 
                                           FontWeight="Bold"
                                           VerticalAlignment="Top"
                                           Foreground="{StaticResource WhiteWhite}"/>
                                            <Border
                                            Grid.Row="2"
                                            BorderBrush="{StaticResource PrimaryColor}"
                                            Background="{StaticResource PrimaryBlack}"
                                            BorderThickness="2"
                                            Height="auto"
                                            Width="300"
                                            Margin="30,0,0,0">
                                                <TextBlock Text="{Binding Description}" 
                                                    HorizontalAlignment="Left"
                                                    FontSize="10"
                                                    TextWrapping="Wrap"
                                                    Margin="5"
                                                    Foreground="{StaticResource WhiteWhite}"/>
                                            </Border>
                                            <Button Content="See all comments" 
                                                   Grid.Row="3"
                                                   HorizontalAlignment="Right"
                                                   FontSize="11" 
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Top"
                                                   Background="Transparent"
                                                   Command="{Binding DataContext.OpenMoreCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}" CommandParameter="{Binding}"
                                                   Foreground="DarkOrange" />
                                            <Button Grid.Row="4"
                                                   FontSize="20" 
                                                   Background="Transparent"
                                                   Height="33"
                                                   Width="auto"
                                                   Cursor="Hand"
                                                   VerticalAlignment="Center"
                                                   BorderThickness="0" 
                                                   Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   HorizontalAlignment="Center"
                                                   Grid.Column="0"
                                                   Grid.ColumnSpan="2"
                                                   Command="{Binding DataContext.CloseForumCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                   CommandParameter="{Binding}">
                                                <Border  Background="DarkOrange"
                                                     CornerRadius="2"
                                                     Height="25" 
                                                     Width="auto">
                                                    <TextBlock  Text="Close forum"
                                                       Margin="20 0 20 0" 
                                                       Foreground="{StaticResource  WhiteGrey}" 
                                                       FontWeight="Bold" 
                                                       FontSize="14" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>

    </Grid>
</UserControl>
