<UserControl x:Class="BookingApp.WPF.Views.GuestWindows.SearchAccommodationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.GuestWindows" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:local1="clr-namespace:BookingApp.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="657.04" d:DesignWidth="430">
    <UserControl.Resources>
        <local1:FirstImagePathConverter x:Key="FirstImagePathConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <TabControl Grid.Column="0" 
      Grid.Row="0" 
      Grid.ColumnSpan="4">
            <TabItem Header="Stays" 
           Width="205">
                <Grid Width="240" 
            Height="260" 
            Margin="80,10,80,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Rectangle Width="240"
                 Height="260"
                 Stroke="Black"
                 StrokeThickness="2"
                 RadiusX="10"
                 RadiusY="10"  
                 VerticalAlignment="Top"
                 HorizontalAlignment="Center" 
                 Grid.Column="0"
                 Grid.Row="0"
                 Grid.ColumnSpan="3"
                 Grid.RowSpan="6"/>

                    <Image Source="../../../Resources/Images/GuestImages/ABCIcon.png"
                 Grid.Column="0" 
                 Grid.Row="0"
                 Width="20" 
                 HorizontalAlignment="Left" 
                 VerticalAlignment="Center" 
                 Margin="10,0,0,0"/>
                    <Label Content="Name" 
                 Grid.Row="0"
                 Grid.Column="0"
                 Height="24" 
                 Width="42"
                 FontSize="11"
                 Margin="20,0,0,0"/>
                    <TextBox Grid.Row="0"
                   Grid.Column="1"
                   Height="25"
                   Grid.ColumnSpan="2" 
                   Margin="10,9,10,9"
                   Text="{Binding AccommodationName, UpdateSourceTrigger=PropertyChanged}"/>
                    <Border BorderThickness="0,0,0,2" 
                  BorderBrush="Black"
                  Grid.Column="0"
                  Grid.Row="0"
                  Grid.ColumnSpan="3"
                  VerticalAlignment="Bottom">
                    </Border>

                    <Image Source="../../../Resources/Images/GuestImages/SearchIcon.png"
                 Grid.Column="0"
                 Grid.Row="1"
                 Width="25" 
                 HorizontalAlignment="Left" 
                 VerticalAlignment="Center" 
                 Height="16" Margin="10,0,0,0"/>
                    <Label Content="Location"
                 Grid.Column="0"
                 Grid.Row="1"
                 HorizontalAlignment="Right"
                 Height="24"
                 FontSize="11" />
                    <ComboBox Grid.ColumnSpan="2"
                    Height="25" 
                    x:Name="locationTextBox" 
                    IsReadOnly="True"
                    Text="Novi Sad, Serbia" 
                    Grid.Column="1"
                    Grid.Row="1" Margin="10,10,10,9" 
                    SelectedIndex="{Binding LocationId, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="Serbia, Novi Sad"/>
                        <ComboBoxItem Content="Serbia, Beograd"/>
                        <ComboBoxItem Content="Serbia, Smederevo"/>
                        <ComboBoxItem Content="Serbia, Požega"/>
                        <ComboBoxItem Content="Serbia, Kragujevac"/>
                        <ComboBoxItem Content="Serbia, Niš"/>
                        <ComboBoxItem Content="Serbia, Subotica"/>
                        <ComboBoxItem Content="Serbia, Pančevo"/>
                        <ComboBoxItem Content="Serbia, Čačak"/>
                        <ComboBoxItem Content="Serbia, Užice"/>
                    </ComboBox>
                    <Border BorderThickness="0,0,0,2" 
                  BorderBrush="Black"
                  Grid.Column="0"
                  Grid.Row="1"
                  Grid.ColumnSpan="3"
                  VerticalAlignment="Bottom">
                    </Border>


                    <Image Source="../../../Resources/Images/GuestImages/PersonIcon.png"
                 Grid.Column="0"
                 Grid.Row="2"
                 Width="22"
                 HorizontalAlignment="Left" 
                 VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Label Content="Number of people"
                 Height="24"
                 FontSize="11" 
                 Grid.Row="2"
                 Grid.ColumnSpan="2"
                 HorizontalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                 Grid.ColumnSpan="2"
                 Grid.Row="2"
                 Height="25" 
                 Margin="55,9,10,9" 
                 Text="{Binding NumberOfPeople}"/>
                    <Border BorderThickness="0,0,0,2" 
                  BorderBrush="Black"
                  Grid.Column="0"
                  Grid.Row="2"
                  Grid.ColumnSpan="3"
                  VerticalAlignment="Bottom">
                    </Border>

                    <Image Source="../../../Resources/Images/GuestImages/DaysIcon.png"
                 Grid.Column="0"
                 Grid.Row="3"
                 Width="22"
                 HorizontalAlignment="Left" 
                 VerticalAlignment="Center" 
                 Margin="10,0,0,0"/>
                    <Label Content="Number of days"
                 Height="24"
                 FontSize="11" 
                 Grid.Row="3"
                 Grid.ColumnSpan="2"
                 HorizontalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                 Grid.ColumnSpan="2"
                 Grid.Row="3"
                 Height="25" 
                 Margin="55,9,10,9" 
                 Text="{Binding NumberOfDays}"/>
                    <Border BorderThickness="0,0,0,2" 
                  BorderBrush="Black"
                  Grid.Column="0"
                  Grid.Row="3"
                  Grid.ColumnSpan="3"
                  VerticalAlignment="Bottom">

                    </Border>

                    <Image Source="../../../Resources/Images/GuestImages/HouseIcon.png"
                         Grid.Column="0" 
                         Grid.Row="4"
                         Width="20" 
                         HorizontalAlignment="Left"  
                         Height="20" Margin="10,0,0,0" 
                         VerticalAlignment="Center"/>
                    <Label Content="Type"
                         Height="24"
                         Grid.Row="4"
                         FontSize="11"  
                         Grid.ColumnSpan="2" 
                         HorizontalAlignment="Left" 
                         VerticalAlignment="Center"
                         Margin="30,0,0,0"/>

                    <ComboBox  Grid.ColumnSpan="2" 
                            Grid.Column="1"
                            Grid.Row="4" 
                            Margin="10,9,10,9"
                            SelectedIndex="{Binding AccommodationType, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding}" 
                                       IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <sys:String>Apartament</sys:String>
                        <sys:String>House</sys:String>
                        <sys:String>Cottage</sys:String>
                    </ComboBox>

                    <Border BorderThickness="0,0,0,2" 
                  BorderBrush="Black"
                  Grid.Column="0"
                  Grid.Row="4"
                  Grid.ColumnSpan="3"
                  VerticalAlignment="Bottom">
                    </Border>

                    <Button Content="Search"
                 Grid.Column="1" 
                 Grid.Row="5"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"
                 Width="60"
                 Click="SearchAccommodation"/>
                </Grid>
            </TabItem>

            <TabItem Header="Anytime anywhere" 
           Width="205">
                <Grid Width="240" 
            Height="200" 
            Margin="80,10,80,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Rectangle Width="240"
                 Height="200"
                 Stroke="Black"
                 StrokeThickness="2"
                 RadiusX="10"
                 RadiusY="10"  
                 VerticalAlignment="Top"
                 HorizontalAlignment="Center" 
                 Grid.Column="0"
                 Grid.Row="0"
                 Grid.ColumnSpan="3"
                 Grid.RowSpan="4"/>

                    <Image Source="../../../Resources/Images/GuestImages/PersonIcon.png"
                      Grid.Column="0"
                      Grid.Row="0"
                      Width="22"
                      HorizontalAlignment="Left" 
                      VerticalAlignment="Center" 
                      Margin="10,0,0,0"/>
                    <Label Content="Number of people"
                      Height="24"
                      FontSize="11" 
                      Grid.Row="0"
                      Grid.ColumnSpan="2"
                      HorizontalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Grid.Row="0"
                      Height="25" 
                      Margin="55,9,10,9" />
                    <Border BorderThickness="0,0,0,2" 
                       BorderBrush="Black"
                       Grid.Column="0"
                       Grid.Row="0"
                       Grid.ColumnSpan="3"
                       VerticalAlignment="Bottom">
                    </Border>

                    <Image Source="../../../Resources/Images/GuestImages/DaysIcon.png"
                      Grid.Column="0"
                      Grid.Row="1"
                      Width="22"
                      HorizontalAlignment="Left" 
                      VerticalAlignment="Center" 
                      Margin="10,0,0,0"/>
                    <Label Content="Number of days"
                      Height="24"
                      FontSize="11" 
                      Grid.Row="1"
                      Grid.ColumnSpan="2"
                      HorizontalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Grid.Row="1"
                      Height="25" 
                      Margin="55,9,10,9" />
                    <Border BorderThickness="0,0,0,2" 
                       BorderBrush="Black"
                       Grid.Column="0"
                       Grid.Row="1"
                       Grid.ColumnSpan="3"
                       VerticalAlignment="Bottom">
                    </Border>

                    <Image Source="../../../Resources/Images/GuestImages/CalendarIcon.png"
                 Grid.Column="0"
                 Grid.Row="2"
                 Width="22" 
                 Height="22"
                 HorizontalAlignment="Left"
                 Margin="10,0,0,0"/>
                    <Label Content="From"
                      Height="24"
                      FontSize="11" 
                      Grid.Row="2"
                      Grid.Column="0" 
                      VerticalAlignment="Center" 
                      Margin="46,0,79,0" 
                      Grid.ColumnSpan="2"/>
                    <DatePicker Grid.Row="2"
                      Grid.Column="1"
                      Height="25" 
                      Margin="6,14,0,11" 
                      HorizontalAlignment="Left"
                      Width="34"/>
                    <Label Content="To"
                      Height="24"
                      FontSize="11" 
                      Grid.Row="2"
                      Grid.Column="1"
                      HorizontalAlignment="Left" 
                      Margin="76,13,0,13" 
                      Grid.ColumnSpan="2"
                      VerticalAlignment="Center"/>
                    <DatePicker Grid.Row="2"
                      Grid.Column="2"
                      Height="25" Margin="0,14,26,11" 
                      HorizontalAlignment="Right" 
                      Width="32"/>
                    <Border BorderThickness="0,0,0,2" 
                 BorderBrush="Black"
                 Grid.Column="0"
                 Grid.Row="2"
                 Grid.ColumnSpan="3"
                 VerticalAlignment="Bottom">
                    </Border>

                    <Button Content="Search"
                             Grid.Column="1" 
                             Grid.Row="3"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             Width="60"
                             Click="SearchAccommodation"/>
                </Grid>
            </TabItem>
        </TabControl>

        <ListView BorderThickness="0" 
            Background="Transparent"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            Grid.Row="1"
            Grid.ColumnSpan="4"
            ScrollViewer.CanContentScroll="False"
            ItemsSource="{Binding Accommodations}"
            SelectedItem="{Binding SelectedAccommodation}" 
            MouseDoubleClick="ListView_MouseDoubleClick"
            HorizontalAlignment="Center" 
            VerticalAlignment="Center">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" 
                      BorderThickness="2" 
                      CornerRadius="10"
                      Width="380">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border BorderBrush="Black" 
                      BorderThickness="1" 
                      Grid.RowSpan="2"
                      HorizontalAlignment="Right"/>

                            <Image Source="{Binding ImagesPath, Converter={StaticResource FirstImagePathConverter}}"
                             Width="50" 
                             Height="50"                                      
                             Grid.RowSpan="2" 
                             VerticalAlignment="Center" 
                             HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Name}" 
                                 Grid.Column="1"
                                 Grid.ColumnSpan="3"
                                 FontSize="20" 
                                 FontWeight="Bold"
                                 VerticalAlignment="Top"
                                 HorizontalAlignment="Center"
                                 Margin="22,0,0,0"/>
                            <Label Content="{Binding Location}"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center" 
                                 Grid.Column="1" 
                                 Grid.ColumnSpan="2"
                                 Grid.Row="1"
                                 Height="22" 
                                 Width="auto"
                                 FontSize="11" 
                                 Margin="14,0,0,0"/>
                            <Image Source="../../../Resources/Images/GuestImages/LocationIcon.png" 
                             Width="auto" 
                             Height="20" 
                             HorizontalAlignment="Left" 
                             VerticalAlignment="Center"                                      
                             Grid.Row="1"
                             Grid.Column="1"/>
                            <Image Source="../../../Resources/Images/GuestImages/StarIcon.png" 
                             Width="20" 
                             Height="20" 
                             HorizontalAlignment="Right" 
                             VerticalAlignment="Center"                                      
                             Grid.Row="1"
                             Grid.Column="2"
                             Margin="0,0,15,0"/>
                            <Label Content="{Binding Rating}"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Center" 
                                 Grid.Column="2" 
                                 Grid.Row="1"
                                 Height="22" 
                                 Width="61"
                                 FontSize="11" 
                                 Margin="0,0,5,0"/>
                            <Image Source="../../../Resources/Images/GuestImages/PersonIcon.png" 
                             Width="20" 
                             Height="20" 
                             HorizontalAlignment="Center" 
                             VerticalAlignment="Center"                                      
                             Grid.Row="1"
                             Grid.Column="3"/>
                            <Label Content="{Binding Capacity}"
                                 VerticalAlignment="Center" 
                                 Grid.Column="3" 
                                 Grid.Row="1"
                                 Height="22" 
                                 Width="61"
                                 FontSize="11" 
                                 Margin="50,0,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</UserControl>
