<Window x:Class="BookingApp.WPF.Views.GuestWindows.OwnerAndAccommodationRatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookingApp.WPF.Views.GuestWindows"
        mc:Ignorable="d"
        Title="OwnerAndAccommodationRatingWindow" Height="440" Width="300" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Image Source="../../../Resources/Images/GuestImages/XIcon.png"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Height="16" 
            Margin="0,5,5,0"
            Width="18" />
        <Label Content="Rate the owner and accommodation" 
             HorizontalAlignment="Center"
             VerticalAlignment="Center" 
             Grid.Row="1"
             Height="26" 
             Width="auto" 
             HorizontalContentAlignment="Center" 
             VerticalContentAlignment="Center" 
             FontSize="14"/>

        <Label Content="Cleanliness(1-5):" 
             HorizontalAlignment="Left"
             VerticalAlignment="Center" 
             Grid.Row="2"
             Height="26" 
             Width="auto"
             Margin="10,15,0,0"/>
        <TextBox Text="{Binding Cleanliness, UpdateSourceTrigger=PropertyChanged}"
              Grid.Row="2" 
              VerticalAlignment="Bottom" 
              HorizontalAlignment="Left"
              Width="30"
              Height="20" 
              Margin="110,0,0,3"/>

        <Label Content="Correctness of the owner(1-5):" 
             HorizontalAlignment="Left"
             VerticalAlignment="Center" 
             Grid.Row="3"
             Height="26" 
             Width="auto"
             Margin="10,10,0,0"/>
        <TextBox Text="{Binding Correctness, UpdateSourceTrigger=PropertyChanged}"
              Grid.Row="3" 
              VerticalAlignment="Bottom" 
              HorizontalAlignment="Left"
              Width="30"
              Height="20" Margin="190,0,0,3"/>

        <Label Content="Add comments" 
            HorizontalAlignment="Left"
            VerticalAlignment="Center" 
            Grid.Row="4"
            Height="26" 
            Width="auto"
            Margin="10,10,0,0"/>
        <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
              Grid.Row="5" 
              VerticalAlignment="Center" 
              HorizontalAlignment="Center"
              Width="280"
              Height="50"
              Margin="0,0,0,10"
              TextWrapping="WrapWithOverflow"
              TextAlignment="Right"/>

        <Label Content="Renovation" 
            HorizontalAlignment="Left"
            VerticalAlignment="Center" 
            Grid.Row="6"
            Height="26" 
            Width="auto"
            Margin="10,0,0,0"/>

        <StackPanel Grid.Row="7" Margin="0,0,0,10">
            <StackPanel.Resources>
                <Style TargetType="RadioButton" x:Key="RoundRadioButton">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Grid>
                                    <Ellipse Width="15" Height="15" Stroke="Black" Fill="{TemplateBinding Background}" HorizontalAlignment="Left" Margin="10,0,0,4"/>
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="30,0,0,0"/>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>
            <RadioButton Name="radioButton1" GroupName="Rating" Content="Level 1 (renovate small things, but is ok)"/>
            <RadioButton Name="radioButton2" GroupName="Rating" Content="Level 2 (need small changes)"/>
            <RadioButton Name="radioButton3" GroupName="Rating" Content="Level 3 (few things should be renovated)"/>
            <RadioButton Name="radioButton4" GroupName="Rating" Content="Level 4 (lots of bad things, need renovation)"/>
            <RadioButton Name="radioButton5" GroupName="Rating" Content="Level 5 (very bad condition, big renovation)"/>
        </StackPanel>


        <Label Content="Add photo" 
             HorizontalAlignment="Left"
             VerticalAlignment="Center" 
             Grid.Row="8"
             Height="26" 
             Width="auto"
             Margin="10,0,0,6"/>
        <Button Content="Upload photo"
                x:Name="UploadPhoto"
              Grid.Row="8" 
              VerticalAlignment="Center" 
              HorizontalAlignment="Left"
              Width="120"
              Height="20" 
              Margin="85,0,0,0"
              Click="UploadPhotoClick"/>

        <Button x:Name="RateButton"
             Content="Rate" 
             Grid.Row="9" 
             VerticalAlignment="Center"
             Width="80"
             Height="30"
             Click="RateOwnerAndAccommodation"/>

    </Grid>
</Window>
