<Window x:Class="BookingApp.WPF.Views.GuestWindows.ForumCreatedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookingApp.WPF.Views.GuestWindows" WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="ForumCreatedWindow" Height="170" Width="260">
    <Grid Background="{StaticResource PrimaryBlack}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Forum created!!!"
         Foreground="{StaticResource WhiteWhite}"
         HorizontalAlignment="Center"
         VerticalAlignment="Center"
         FontSize="20"/>
        <Image Source="../../../Resources/Images/OwnerImages/check.png" 
         Width="40"
         Grid.Row="1"
         HorizontalAlignment="Left"
         VerticalAlignment="Center" Margin="146,0,0,0"/>
        <Image Source="../../../Resources/Images/OwnerImages/forum.png" 
         Width="70"
         Grid.Row="1"
         HorizontalAlignment="Left"
         VerticalAlignment="Center" Margin="63,0,0,0"/>
    </Grid>
</Window>
