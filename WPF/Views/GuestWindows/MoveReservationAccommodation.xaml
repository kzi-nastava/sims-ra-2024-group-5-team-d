<Window x:Class="BookingApp.WPF.Views.GuestWindows.MoveReservationAccommodation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookingApp.WPF.Views.GuestWindows"
        mc:Ignorable="d"
        Title="MoveReservationAccommodation" Height="250" Width="250" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Label Content="Send a request to change the reservation" 
            HorizontalAlignment="Left"
            VerticalAlignment="Top" 
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Height="26" 
            Width="auto" 
            Margin="5,10,0,0" FontWeight="Bold"/>
        <Label Content="Select new dates" 
            HorizontalAlignment="Left"
            VerticalAlignment="Center" 
            Grid.Column="0"
            Grid.Row="1"
            Height="26" 
            Width="auto" 
            Margin="10,15,0,0" 
            FontSize="11"/>

        <Label Content="To:" 
           HorizontalAlignment="Left"
           VerticalAlignment="Center" 
           Grid.Column="0"
           Grid.Row="2"
           Height="26" 
           Width="auto" 
           Margin="40,15,0,10" 
           FontSize="11"/>
        <DatePicker 
                 Grid.Row="2"
                 Height="25" 
                 Margin="100,13,46,13" 
                 Grid.ColumnSpan="2"
                 SelectedDate="{Binding NewReservedFrom}"/>
        <Label Content="From:" 
           HorizontalAlignment="Left"
           VerticalAlignment="Center" 
           Grid.Column="0"
           Grid.Row="3"
           Height="26" 
           Width="auto" 
           Margin="40,15,0,10" 
           FontSize="11"/>
        <DatePicker Grid.Row="3"
                 Height="25" 
                 Margin="100,13,46,13" 
                 Grid.ColumnSpan="2"
                 SelectedDate="{Binding NewReservedTo}"/>
        <Button Content="Send" 
              Grid.Row="4" 
              Grid.Column="0"
              Grid.ColumnSpan="2"
              Width="68"
              Height="30"
              VerticalAlignment="Center" 
              HorizontalAlignment="Center"
              Margin="0,10,0,10"
              Command="{Binding SendRequestCommand}"/>
    </Grid>
</Window>
