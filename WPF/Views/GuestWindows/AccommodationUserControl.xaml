<UserControl x:Class="BookingApp.WPF.Views.GuestWindows.AccommodationUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BookingApp.WPF.Views.GuestWindows" xmlns:local1="clr-namespace:BookingApp.WPF.Views"
             mc:Ignorable="d" 
             d:DesignHeight="657.04" d:DesignWidth="430">
    <UserControl.Resources>
        <local1:FirstImagePathConverter x:Key="FirstImagePathConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Image Source="{Binding Accommodation.ImagesPath, Converter={StaticResource FirstImagePathConverter}}"
           Grid.Column="0"
           Grid.Row="0"
           Grid.RowSpan="2"
           HorizontalAlignment="Left"
           VerticalAlignment="Center"
           Height="70" 
           Margin="15,15,0,15"
           Width="90" />
            <Label Content="{Binding Accommodation.Name}"
           HorizontalAlignment="Center"
           VerticalAlignment="Center" 
           Grid.Column="1"
           Grid.ColumnSpan="3"
           Grid.Row="0"
           FontSize="18"
           FontWeight="Bold"
           Height="auto" 
           Width="auto"/>
            <Button Content="Comments" 
             Grid.Row="1" 
             Grid.Column="1" 
             Width="68" 
             VerticalAlignment="Center" 
             HorizontalAlignment="Center"/>
            <Image Source="../../../Resources/Images/GuestImages/StarIcon.png"
           Grid.Column="2"
           Grid.Row="1"
           HorizontalAlignment="Left"
           VerticalAlignment="Center"
           Height="30" 
           Margin="15,0,0,0"
           Width="30" />
            <Label Content="{Binding Accommodation.Rating}"
           Grid.Column="2"
           Grid.Row="1"
           HorizontalAlignment="Left"
           VerticalAlignment="Center"
           Height="30" 
           Margin="40,0,0,0"
           Width="30" />
            <Image Source="../../../Resources/Images/GuestImages/PersonIcon.png"
           Grid.Column="3"
           Grid.Row="1"
           HorizontalAlignment="Left"
           VerticalAlignment="Center"
           Height="30" 
           Margin="10,0,0,0"
           Width="30" />
            <Label Content="{Binding Accommodation.Capacity}"
           Grid.Column="3"
           Grid.Row="1"
           HorizontalAlignment="Left"
           VerticalAlignment="Center"
           Height="30" 
           Margin="40,0,0,0"
           Width="30" />

            <Image Source="../../../Resources/Images/GuestImages/WiFiIcon.png"
            Grid.Column="0" 
            Grid.Row="2"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Width="24"
            Margin="15,20,0,5" />
            <Image Source="../../../Resources/Images/GuestImages/KnifeAndForkIcon.png"
            Grid.Column="0" 
            Grid.Row="2"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Width="28"
            Margin="80,20,0,0" Grid.ColumnSpan="2" />
            <Image Source="../../../Resources/Images/GuestImages/BathIcon.png"
            Grid.Column="1" 
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Width="24"
            Margin="0,20,0,0" />
            <Image Source="../../../Resources/Images/GuestImages/ParkingIcon.png"
            Grid.Column="2" 
            Grid.Row="2"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Width="26"
            Margin="15,20,0,0" />
            <Image Source="../../../Resources/Images/GuestImages/BedsIcon.png"
            Grid.Column="2" 
            Grid.Row="2"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Width="26"
            Margin="91,20,0,0" Grid.ColumnSpan="2" />
            <Image Source="../../../Resources/Images/GuestImages/OtherIcon.png"
            Grid.Column="3" 
            Grid.Row="2"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Width="30"
            Margin="54,20,0,0" />

            <Label Content="FreeWiFi" 
           Grid.Row="2"
           Grid.Column="0"
           Grid.ColumnSpan="4"
           Margin="0,39,0,11" 
           Grid.RowSpan="2"
           FontSize="11"/>
            <Label Content="Kitchen" 
           Grid.Row="2"
           Grid.Column="0"
           Grid.ColumnSpan="4"
           Margin="70,39,0,11" 
           Grid.RowSpan="2"
           FontSize="11"/>
            <Label Content="Bath" 
           Grid.Row="2"
           Grid.Column="0"
           Grid.ColumnSpan="4"
           Margin="145,39,0,11" 
           Grid.RowSpan="2"
           FontSize="11"/>
            <Label Content="Parking" 
           Grid.Row="2"
           Grid.Column="0"
           Grid.ColumnSpan="4"
           Margin="221,39,0,11" 
           Grid.RowSpan="2"
           FontSize="11"/>
            <Label Content="Beds" 
           Grid.Row="2"
           Grid.Column="0"
           Grid.ColumnSpan="4"
           Margin="300,39,0,11" 
           Grid.RowSpan="2"
           FontSize="11"/>
            <Label Content="Other" 
           Grid.Row="2"
           Grid.Column="0"
           Grid.ColumnSpan="4"
           Margin="372,39,0,11" 
           Grid.RowSpan="2"
           FontSize="11"/>

            <Button Content="Choose" 
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Grid.Row="5"
            Height="30"
            Width="70"
            Click="AddReservation_Button"/>


        </Grid>

    </Grid>
</UserControl>
